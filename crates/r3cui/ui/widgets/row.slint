import { UcMark } from "../marks/brand.slint";
import { Glyph, Icons, Logo } from "../marks/icons.slint";
import { Theme, Layout, Type, Motion } from "../theme.slint";
import { Choice, Dot, RowSize } from "../types.slint";

// The one row every list and settings page draws: a label with an optional second line, what it is now, and where
// it leads. Anything placed inside sits at the right edge; reserve its room with `trailing`.
export component Row inherits Rectangle {
    in property <Choice> choice;
    in property <bool> focused;
    in property <RowSize> size: RowSize.regular;
    // A stroked glyph before the label, or the Unfolded Circle mark for a row that is the remote's own.
    in property <string> glyph;
    in property <bool> uc-mark;
    // Erases or turns something off: red throughout.
    in property <bool> danger;
    // Shown but not available now.
    in property <bool> dimmed;
    in property <bool> top-line;
    in property <bool> bottom-line;
    in property <length> trailing: 0px;
    callback tapped();

    property <bool> down: root.choice.dot == Dot.down;
    property <bool> compact: root.size == RowSize.compact;
    property <length> mark-w: root.choice.icon != "" ? 32px : root.uc-mark ? 27px : root.glyph != "" ? 24px : root.choice.dot != Dot.none ? Layout.dot-size : 0px;
    property <length> lead: root.mark-w > 0 ? Layout.margin + root.mark-w + Layout.lead-gap : Layout.margin;
    property <length> edge: (root.choice.bars > 0 ? (root.choice.locked ? Layout.lock-x : Layout.bars-x) - Layout.lead-gap : root.choice.checked || root.choice.chevron ? Layout.value-edge-trailing : Layout.value-edge) - root.trailing;
    // The focused or hovered row lifts very slightly; the others settle back.
    property <float> lift: (root.focused || ta.has-hover) && !root.dimmed ? Motion.lift-scale : 1;
    animate lift { duration: Motion.lift; easing: ease-out; }

    x: 0;
    width: Layout.screen-w;
    height: root.compact ? Layout.row-compact : root.choice.detail != "" ? Layout.row-detail : Layout.row-min;

    if root.top-line: Rectangle {
        y: 0;
        height: Layout.hairline;
        background: Theme.hair;
    }
    if root.bottom-line: Rectangle {
        y: parent.height - Layout.hairline;
        height: Layout.hairline;
        background: Theme.hair;
    }
    Rectangle {
        x: 0;
        width: Layout.focus-bar-w;
        height: Layout.focus-bar-h;
        border-radius: Layout.focus-bar-radius;
        background: root.down || root.danger ? Theme.off : Theme.accent;
        opacity: root.focused || root.down ? 1 : 0;
        animate opacity { duration: Motion.fade; }
    }
    if root.choice.icon != "": Logo {
        x: Layout.margin;
        commands: root.choice.icon;
        tint: root.focused ? Theme.text : Theme.t2;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-scale: root.lift;
    }
    if root.uc-mark: UcMark {
        x: Layout.margin;
        wide: 27px;
        tint: root.focused ? Theme.text : Theme.text-dim;
    }
    if root.glyph != "": Glyph {
        x: Layout.margin;
        commands: root.glyph;
        tint: root.danger ? Theme.off : root.focused ? Theme.text : Theme.t2;
    }
    // Beside the label, or as a badge on the icon's corner when there is one.
    if root.choice.dot != Dot.none: Rectangle {
        x: root.choice.icon != "" ? Layout.margin + 20px : Layout.margin;
        y: root.choice.icon != "" ? parent.height / 2 + 4px : (parent.height - self.height) / 2;
        width: Layout.dot-size;
        height: Layout.dot-size;
        border-radius: self.width / 2;
        border-width: root.choice.icon != "" ? 2px : 0px;
        border-color: Theme.bg;
        background: root.choice.dot == Dot.up ? Theme.good : root.down ? Theme.off : root.choice.dot == Dot.changed ? Theme.accent : Theme.t3;
    }
    label-text := Text {
        x: root.lead;
        y: root.choice.detail == "" ? (parent.height - self.height) / 2 : parent.height / 2 - self.height + 2px;
        width: root.edge - root.lead - (root.choice.value == "" ? 0px : value-text.width + 20px);
        overflow: elide;
        text: root.choice.label;
        transform-origin: { x: 0, y: self.height / 2 };
        transform-scale: root.lift;
        font-size: root.compact ? Type.label-compact : Type.label;
        font-weight: root.focused || root.down ? Type.label-focused-weight : Type.label-weight;
        color: root.dimmed ? Theme.t3 : root.danger ? Theme.off : root.focused || root.down ? Theme.text : Theme.text-dim;
        animate color { duration: Motion.fade; }
    }
    detail-text := Text {
        visible: root.choice.detail != "";
        x: root.lead;
        y: parent.height / 2 + 2px;
        width: root.edge - root.lead - (root.choice.value == "" ? 0px : value-text.width + 20px);
        overflow: elide;
        text: root.choice.detail;
        font-size: Type.detail;
        color: Theme.t2;
    }
    if root.choice.tag != "": Rectangle {
        x: root.lead + min(label-text.preferred-width, label-text.width) * root.lift + 14px;
        y: (parent.height - self.height) / 2;
        height: 26px;
        width: tag-text.preferred-width + 16px;
        border-radius: self.height / 2;
        border-width: 1px;
        border-color: Theme.accent;
        tag-text := Text {
            text: root.choice.tag;
            font-size: 13px;
            letter-spacing: 0.8px;
            horizontal-alignment: center;
            vertical-alignment: center;
            color: Theme.accent;
        }
    }
    // The label and its detail come first: the value gets what they leave, but always room for a status word.
    value-text := Text {
        width: max(min(self.preferred-width, root.edge - root.lead - max(label-text.preferred-width * root.lift, detail-text.preferred-width) - 20px), min(self.preferred-width, 140px));
        x: root.edge - self.width;
        overflow: elide;
        horizontal-alignment: right;
        text: root.choice.value;
        font-size: root.compact ? Type.value-compact : Type.value;
        font-weight: Type.value-weight;
        color: Theme.t2;
    }
    if root.choice.locked: Glyph {
        x: Layout.lock-x;
        commands: Icons.lock;
        tint: Theme.t3;
    }
    if root.choice.bars > 0: Rectangle {
        for n in 4: Rectangle {
            x: Layout.bars-x + n * Layout.bar-pitch;
            y: parent.height / 2 + Layout.bars-drop - self.height;
            width: Layout.bar-w;
            height: Layout.bar-base + n * Layout.bar-step;
            border-radius: Layout.bar-radius;
            background: n < root.choice.bars ? Theme.t2 : Theme.track;
        }
    }
    if root.choice.chevron: Glyph {
        x: Layout.trailing-x;
        commands: Icons.right;
        tint: Theme.t3;
    }
    if root.choice.checked: Glyph {
        x: Layout.trailing-x;
        commands: Icons.check;
        tint: Theme.accent;
    }
    @children
    ta := TouchArea {
        mouse-cursor: Theme.cursor;
        clicked => { root.tapped(); }
    }
}
