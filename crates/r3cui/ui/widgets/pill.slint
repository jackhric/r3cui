import { Theme, Layout, Type } from "../theme.slint";
import { Glyph } from "../marks/icons.slint";

export component Pill inherits Rectangle {
    in property <string> label;
    in property <bool> focused;
    // An `Icons` path before the label; empty for none.
    in property <string> glyph;
    // Something that can't be undone, such as uninstalling: red, outlined until focused.
    in property <bool> danger;
    callback tapped();
    x: Layout.margin;
    width: Layout.content-w;
    height: Layout.row-compact;
    border-radius: Layout.card-radius;
    background: Theme.raised;
    border-width: root.focused ? Layout.focus-ring : root.danger ? Layout.hairline : 0px;
    border-color: root.focused ? Theme.accent : Theme.off;
    HorizontalLayout {
        alignment: center;
        spacing: Layout.gap-s;
        if root.glyph != "": VerticalLayout {
            alignment: center;
            Glyph {
                commands: root.glyph;
                tint: root.danger ? Theme.off : Theme.t2;
            }
        }
        Text {
            text: root.label;
            font-size: Type.label-compact;
            color: root.danger ? Theme.off : root.focused ? Theme.text : Theme.t2;
            vertical-alignment: center;
        }
    }
    TouchArea {
        mouse-cursor: Theme.cursor;
        clicked => { root.tapped(); }
    }
}
