import { Glyph, Icons } from "../marks/icons.slint";
import { Theme } from "../theme.slint";

export component VolumeChip inherits HorizontalLayout {
    in property <int> volume;
    in property <bool> muted;
    in property <length> size: 24px;
    alignment: center;
    spacing: 10px;
    VerticalLayout {
        alignment: center;
        // The speaker fills only the middle half of its 24-unit box; this size makes it as tall as
        // the number's capitals.
        Glyph {
            size: root.size * 1.3;
            commands: root.muted ? Icons.muted : Icons.speaker;
        }
    }
    Text {
        text: root.volume;
        font-size: root.size;
        font-weight: 300;
        color: Theme.t2;
        vertical-alignment: center;
    }
}
