import { Nav } from "../../globals/nav.slint";
import { R3Web } from "../../globals/r3-web.slint";
import { Theme, Layout, Type } from "../../theme.slint";
import { PageId } from "../../types.slint";
import { Caption } from "../../widgets/caption.slint";
import { Layer } from "../../widgets/layer.slint";
import { PageBody, Gap, Spring } from "../../widgets/page-body.slint";
import { PageHeader } from "../../widgets/page-header.slint";
import { PinDigits } from "../../widgets/pin-digits.slint";
import { Row } from "../../widgets/row.slint";

// Set up integrations from a computer: opening this page switches r3cui's web configurator on and shows how to reach it.
export component R3WebPage inherits Layer {
    page: PageId.r3-web;

    PageHeader {
        title: "Web configurator";
        r3-mark: true;
        back => { Nav.back(); }
    }
    PageBody {
        Gap { size: Layout.gap-l; }
        Caption {
            horizontal-alignment: center;
            text: "PIN";
        }
        Gap { size: Layout.gap-s; }
        PinDigits { digits: R3Web.pin; }
        Gap { size: Layout.gap-xl; }
        Rectangle {
            height: Layout.qr;
            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    alignment: center;
                    Image {
                        width: self.source.width * 1px;
                        height: self.source.height * 1px;
                        source: R3Web.qr;
                        image-rendering: pixelated;
                    }
                }
            }
        }
        Gap { size: Layout.gap-m; }
        Text {
            horizontal-alignment: center;
            text: R3Web.on ? R3Web.address : "Off";
            font-size: Type.body;
            color: Theme.text-dim;
        }
        Gap { size: Layout.gap-s; }
        Text {
            horizontal-alignment: center;
            text: "Same Wi-Fi as the remote · off after 30 minutes unused";
            font-size: Type.small;
            color: Theme.t3;
        }
        Spring { }
        Row {
            top-line: true;
            bottom-line: true;
            choice: { label: "New PIN" };
            focused: Nav.focus == 0;
            tapped => { Nav.activate(0); }
        }
        Row {
            bottom-line: true;
            choice: { label: "Turn off" };
            focused: Nav.focus == 1;
            tapped => { Nav.activate(1); }
        }
    }
}
