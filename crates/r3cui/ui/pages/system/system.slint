import { Nav } from "../../globals/nav.slint";
import { RemoteControl } from "../../globals/remote-control.slint";
import { Software } from "../../globals/software.slint";
import { R3Wordmark } from "../../marks/brand.slint";
import { Icons } from "../../marks/icons.slint";
import { Theme, Layout, Type } from "../../theme.slint";
import { PageId, RowSize, UpdateState } from "../../types.slint";
import { Layer } from "../../widgets/layer.slint";
import { Caption } from "../../widgets/caption.slint";
import { PageBody, Gap, Spring, Inset } from "../../widgets/page-body.slint";
import { PageHeader } from "../../widgets/page-header.slint";
import { Row } from "../../widgets/row.slint";
import { BuildBadge } from "../../widgets/build-badge.slint";

export component SystemPage inherits Layer {
    page: PageId.system;
    property <bool> available: Software.r3-state == UpdateState.available;

    PageHeader {
        title: "System";
        back => { Nav.back(); }
    }
    PageBody {
        Gap { size: Layout.gap-l; }
        HorizontalLayout {
            alignment: center;
            R3Wordmark { wide: 198px; }
        }
        Text {
            horizontal-alignment: center;
            text: Software.r3-version;
            font-size: Type.hero;
            font-weight: Type.display-weight;
            color: Theme.text;
        }
        if Software.r3-commit != "" || Software.r3-features != "": HorizontalLayout {
            alignment: center;
            padding-top: Layout.gap-xs;
            padding-bottom: Layout.gap-xs;
            BuildBadge {
                commit: Software.r3-commit;
                features: Software.r3-features;
            }
        }
        HorizontalLayout {
            alignment: center;
            spacing: Layout.gap-s;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: root.available ? Theme.accent : Software.r3-state == UpdateState.current ? Theme.good : Theme.t3;
                }
            }
            Text {
                text: Software.r3-status;
                font-size: Type.body;
                color: Theme.t2;
                vertical-alignment: center;
            }
        }
        Gap { size: Layout.gap-m; }
        Row {
            top-line: true;
            bottom-line: true;
            choice: { label: root.available ? "Update r3cui" : Software.r3-state == UpdateState.checking ? "Checking…" : "Check for updates", value: root.available ? Software.r3-new-version : "", chevron: root.available };
            focused: Nav.focus == Software.action-row;
            tapped => { Nav.activate(Software.action-row); }
        }
        Row {
            size: RowSize.compact;
            glyph: Icons.remote;
            bottom-line: true;
            choice: { label: "Remote control", value: RemoteControl.on ? "On" : "Off", chevron: true };
            focused: Nav.focus == Software.control-row;
            tapped => { Nav.activate(Software.control-row); }
        }
        Gap { size: Layout.gap-l; }
        Inset {
            Caption { text: "THE REMOTE"; }
        }
        Gap { size: Layout.gap-s; }
        Row {
            size: RowSize.compact;
            uc-mark: true;
            top-line: true;
            bottom-line: true;
            choice: { label: "Firmware", value: Software.fw-installed, chevron: true };
            focused: Nav.focus == Software.firmware-row;
            tapped => { Nav.activate(Software.firmware-row); }
        }
        Row {
            size: RowSize.compact;
            uc-mark: true;
            bottom-line: true;
            choice: { label: "Web configurator", value: Software.web-on ? "On" : "Off", chevron: true };
            focused: Nav.focus == Software.web-row;
            tapped => { Nav.activate(Software.web-row); }
        }
        Spring { }
        Row {
            glyph: Icons.trash;
            danger: true;
            top-line: true;
            bottom-line: true;
            choice: { label: "Uninstall r3cui", detail: "Erases r3cui; the stock UI comes back.", chevron: true };
            focused: Nav.focus == Software.uninstall-row;
            tapped => { Nav.activate(Software.uninstall-row); }
        }
    }
}
