import { Nav } from "../../globals/nav.slint";
import { RemoteControl } from "../../globals/remote-control.slint";
import { Theme, Layout, Type } from "../../theme.slint";
import { PageId } from "../../types.slint";
import { Caption } from "../../widgets/caption.slint";
import { Layer } from "../../widgets/layer.slint";
import { PageBody, Gap, Spring } from "../../widgets/page-body.slint";
import { PageHeader } from "../../widgets/page-header.slint";
import { Row } from "../../widgets/row.slint";

// Watch and drive the remote from the local network: the switch, and the key a client needs.
export component RemoteControlPage inherits Layer {
    page: PageId.remote-control;

    PageHeader {
        title: "Remote control";
        back => { Nav.back(); }
    }
    PageBody {
        Gap { size: Layout.gap-l; }
        if RemoteControl.on: Caption {
            horizontal-alignment: center;
            text: "KEY";
        }
        if RemoteControl.on: Text {
            horizontal-alignment: center;
            text: RemoteControl.key;
            font-size: Type.headline;
            letter-spacing: Type.caption-spacing;
            color: Theme.text;
        }
        if RemoteControl.on: Gap { size: Layout.gap-l; }
        if RemoteControl.on: HorizontalLayout {
            alignment: center;
            Image {
                width: self.source.width * 1px;
                height: self.source.height * 1px;
                source: RemoteControl.qr;
                image-rendering: pixelated;
            }
        }
        if RemoteControl.on: Gap { size: Layout.gap-m; }
        Text {
            horizontal-alignment: center;
            wrap: word-wrap;
            text: RemoteControl.on ? RemoteControl.address : "Off. Turn it on to watch and drive this remote from a computer on the same Wi-Fi.";
            font-size: Type.body;
            color: Theme.text-dim;
        }
        if RemoteControl.watched: Text {
            horizontal-alignment: center;
            text: "Someone is connected";
            font-size: Type.small;
            color: Theme.accent;
        }
        Spring { }
        Row {
            top-line: true;
            bottom-line: true;
            choice: { label: RemoteControl.on ? "Turn off" : "Turn on" };
            focused: Nav.focus == 0;
            tapped => { Nav.activate(0); }
        }
        if RemoteControl.on: Row {
            bottom-line: true;
            choice: { label: "New key" };
            focused: Nav.focus == 1;
            tapped => { Nav.activate(1); }
        }
    }
}
