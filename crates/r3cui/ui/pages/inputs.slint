import { Control } from "../globals/control.slint";
import { Nav } from "../globals/nav.slint";
import { Glyph, Icons, Logo } from "../marks/icons.slint";
import { Theme, Layout, Type } from "../theme.slint";
import { Dot, PageId } from "../types.slint";
import { ChoiceList } from "../widgets/choice-list.slint";
import { Layer } from "../widgets/layer.slint";
import { PageBody, Gap, Spring, Inset } from "../widgets/page-body.slint";
import { Row } from "../widgets/row.slint";

export component InputsPage inherits Layer {
    page: PageId.inputs;
    property <bool> empty: Control.inputs.length == 0;

    if !root.empty: ChoiceList {
        title: "Inputs";
        show-title: false;
        rows: Control.input-choices;
        focused-row: Nav.focus;
        pick(i) => { Nav.activate(i); }
        back => { Nav.back(); }
    }

    if root.empty: PageBody {
        under-header: false;
        Spring { }
        Inset {
            Rectangle {
                height: 80px;
                if Control.no-inputs.icon == "": Glyph {
                    size: 72px;
                    commands: Icons.no-input;
                    tint: Theme.t3;
                    stroke-width: 1.25px * 72 / 24;
                }
                if Control.no-inputs.icon != "": Rectangle {
                    width: 80px;
                    Logo {
                        size: 80px;
                        commands: Control.no-inputs.icon;
                        tint: Theme.t2;
                    }
                    if Control.no-inputs.dot != Dot.none: Rectangle {
                        x: parent.width - 14px;
                        y: parent.height - 16px;
                        width: 22px;
                        height: 22px;
                        border-radius: 11px;
                        border-width: 4px;
                        border-color: Theme.bg;
                        background: Control.no-inputs.dot == Dot.up ? Theme.good : Control.no-inputs.dot == Dot.down ? Theme.off : Theme.t3;
                    }
                }
            }
        }
        Gap { size: Layout.gap-xl; }
        Text {
            horizontal-alignment: center;
            text: "No inputs found";
            font-size: Type.headline;
            color: Theme.text;
        }
        Gap { size: Layout.gap-m; }
        Inset {
            Text {
                horizontal-alignment: center;
                wrap: word-wrap;
                text: Control.no-inputs.message;
                font-size: Type.body;
                color: Theme.t2;
            }
        }
        Spring { }
        Row {
            top-line: true;
            bottom-line: true;
            choice: { label: Control.no-inputs.row, value: Control.no-inputs.value, chevron: true };
            focused: Nav.focus == 0;
            tapped => { Nav.activate(0); }
        }
    }
}
