import { Nav } from "../globals/nav.slint";
import { Prefs } from "../globals/prefs.slint";
import { Theme, Layout, Motion } from "../theme.slint";
import { PageId } from "../types.slint";
import { Bar } from "../widgets/bar.slint";
import { Caption } from "../widgets/caption.slint";
import { Layer } from "../widgets/layer.slint";
import { PageBody, Gap, Inset, Spring } from "../widgets/page-body.slint";
import { PageHeader } from "../widgets/page-header.slint";
import { Row } from "../widgets/row.slint";

// The remote's own hardware: the display, then sound and haptics.
export component HardwarePage inherits Layer {
    page: PageId.hardware;

    PageHeader {
        title: "Hardware";
        back => { Nav.back(); }
    }
    PageBody {
        Inset {
            Caption { text: "DISPLAY"; }
        }
        Gap { size: Layout.gap-s; }
        Row {
            dimmed: Prefs.auto-brightness;
            choice: { label: "Brightness", value: Prefs.auto-brightness ? "Automatic" : Prefs.brightness + "%" };
            focused: Nav.focus == Prefs.brightness-row;
        }
        // Locked while auto brightness is on: the remote sets the level itself then.
        Rectangle {
            height: 54px;
            Bar {
                x: Layout.margin;
                y: 6px;
                value: Prefs.brightness / 100;
                handle: !Prefs.auto-brightness;
                tint: Prefs.auto-brightness ? Theme.t3 : Theme.accent;
                opacity: Prefs.auto-brightness ? 0.5 : 1;
                animate opacity { duration: Motion.toggle; }
            }
            // Wider and taller than the bar, reaching up into the row above, so a thumb finds it.
            TouchArea {
                mouse-cursor: Theme.cursor;
                x: Layout.margin - 16px;
                y: -24px;
                width: Layout.content-w + 32px;
                height: 74px;
                enabled: !Prefs.auto-brightness;
                function set() {
                    Nav.focus = Prefs.brightness-row;
                    Prefs.brightness = max(5, min(100, round((self.mouse-x - 16px) / Layout.content-w * 100)));
                    Prefs.changed();
                }
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        self.set();
                    }
                }
                moved => {
                    if (self.pressed) {
                        self.set();
                    }
                }
            }
        }
        Row {
            height: Layout.row-max;
            top-line: true;
            trailing: 56px;
            choice: { label: "Auto brightness" };
            focused: Nav.focus == Prefs.auto-row;
            tapped => { Nav.activate(Prefs.auto-row); }
            Rectangle {
                x: Layout.value-edge - self.width;
                width: 56px;
                height: 32px;
                border-radius: 16px;
                background: Prefs.auto-brightness ? Theme.text : Theme.track;
                animate background { duration: Motion.toggle; }
                Rectangle {
                    x: Prefs.auto-brightness ? 28px : 4px;
                    width: 24px;
                    height: 24px;
                    border-radius: 12px;
                    background: Prefs.auto-brightness ? Theme.bg : Theme.t2;
                    animate x { duration: Motion.toggle; easing: ease-out; }
                }
            }
        }
        Row {
            height: Layout.row-max;
            top-line: true;
            bottom-line: true;
            choice: { label: "Screen off after", value: Prefs.screen-off-after, chevron: true };
            focused: Nav.focus == Prefs.screen-off-row;
            tapped => { Nav.activate(Prefs.screen-off-row); }
        }
        Gap { size: Layout.gap-xl; }
        Inset {
            Caption { text: "SOUND & HAPTICS"; }
        }
        Gap { size: Layout.gap-s; }
        Row {
            height: Layout.row-max;
            top-line: true;
            bottom-line: true;
            choice: { label: "Haptics", value: Prefs.haptics };
            focused: Nav.focus == Prefs.haptics-row;
            tapped => { Nav.activate(Prefs.haptics-row); }
        }
        Spring { }
    }
}
