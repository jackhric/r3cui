export global Prefs {
    // The Hardware page's rows.
    out property <int> brightness-row: 0;
    out property <int> auto-row: 1;
    out property <int> screen-off-row: 2;
    out property <int> haptics-row: 3;
    out property <int> rows: 4;
    in-out property <int> brightness: 90;
    in-out property <bool> auto-brightness: true;
    in property <string> screen-off-after;
    in property <string> haptics;
    // The user changed brightness or auto brightness on the Hardware page.
    callback changed();
}
