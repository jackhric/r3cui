import { Choice, JoinState, WifiRow } from "../types.slint";

export global Wifi {
    // The network list is followed by a scan row and, when the band is known, a band row.
    out property <int> scan-row: Wifi.rows.length;
    out property <int> band-row: Wifi.rows.length + 1;
    out property <int> count: Wifi.rows.length + (Wifi.band-known ? 2 : 1);
    // The join-failed page's rows.
    out property <int> retry-row: 0;
    out property <int> stay-row: 1;
    in property <string> name;
    in property <[WifiRow]> rows;
    in property <[Choice]> choices;
    in property <bool> band-known;
    in-out property <WifiRow> target;
    in-out property <JoinState> join-state;
    callback scan();
    // Switch the remote's preferred Wi-Fi band between 2.4 and 5 GHz.
    callback band();
    // ssid, ssid-hex, password ("" for an open network)
    callback join(string, string, string);
}
