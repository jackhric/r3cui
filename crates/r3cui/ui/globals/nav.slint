import { Capture, Dest, Haptic, JoinState, KbPurpose, MenuItem, PageId, PowerAction, UpdateState } from "../types.slint";
import { Cfg } from "cfg.slint";
import { Control } from "control.slint";
import { Fx } from "fx.slint";
import { Kb } from "kb.slint";
import { Lab } from "lab.slint";
import { Menu } from "menu.slint";
import { Power } from "power.slint";
import { Prefs } from "prefs.slint";
import { RemoteControl } from "remote-control.slint";
import { Software } from "software.slint";
import { Tracks } from "tracks.slint";
import { Wifi } from "wifi.slint";

export global Nav {
    in-out property <PageId> page: PageId.home;
    in-out property <int> focus;

    // Lists one step from the stage share a depth, so opening one from the stage is the layer
    // transition alone, without a sideways slide.
    pure public function depth-of(p: PageId) -> int {
        p == PageId.home || p == PageId.inputs || p == PageId.menu || p == PageId.tracks ? 1
            : p == PageId.keyboard ? 3
            : p == PageId.join-failed || p == PageId.r3-installing || p == PageId.fw-installing ? 4
            : p == PageId.r3-update || p == PageId.fw-update || p == PageId.web-config || p == PageId.uninstall || p == PageId.remote-control ? 3
            : 2
    }
    pure public function shows-menu(p: PageId) -> bool {
        p == PageId.home || p == PageId.inputs
    }
    pure public function hides-navbar(p: PageId) -> bool {
        p == PageId.keyboard || p == PageId.join-failed
    }

    // Haptics mark arriving somewhere new and pressing OK; moving the focus stays silent.
    // Moves between screens inside the current page (Integrations' nested screens, the lab's): every Layer slides
    // its content on them as a page change slides the pages.
    out property <int> inner-moves;
    out property <bool> inner-deeper;

    public function inner(deeper: bool) {
        Nav.inner-deeper = deeper;
        Nav.inner-moves += 1;
    }

    public function go(p: PageId, f: int) {
        if (p != Nav.page) {
            Fx.haptic(Haptic.page);
        }
        if (Nav.page == PageId.home && p != PageId.home) {
            Fx.capture(Capture.stage);
        }
        Nav.focus = f;
        Nav.page = p;
    }

    pure function back-to(p: PageId) -> Dest {
        if (p == PageId.display) {
            return { page: PageId.menu, focus: Menu.row(MenuItem.display) };
        }
        if (p == PageId.power) {
            return { page: PageId.menu, focus: Menu.row(MenuItem.power) };
        }
        if (p == PageId.wifi) {
            return { page: PageId.menu, focus: Menu.row(MenuItem.wifi) };
        }
        if (p == PageId.status) {
            return { page: PageId.menu, focus: Menu.row(MenuItem.status) };
        }
        if (p == PageId.system) {
            return { page: PageId.menu, focus: Menu.row(MenuItem.system) };
        }
        if (p == PageId.r3-update || p == PageId.r3-installing) {
            return { page: PageId.system, focus: Software.action-row };
        }
        if (p == PageId.fw-update || p == PageId.fw-installing) {
            return { page: PageId.system, focus: Software.firmware-row };
        }
        if (p == PageId.remote-control) {
            return { page: PageId.system, focus: Software.control-row };
        }
        if (p == PageId.web-config) {
            return { page: PageId.system, focus: Software.web-row };
        }
        if (p == PageId.uninstall) {
            return { page: PageId.system, focus: Software.uninstall-row };
        }
        return { page: PageId.home, focus: 0 };
    }

    public function back() {
        if (Nav.page == PageId.feedback-lab) {
            let focus = Lab.back();
            if (focus < 0) {
                Nav.go(PageId.menu, Menu.row(MenuItem.lab));
            } else {
                Nav.focus = focus;
                Nav.inner(false);
            }
        } else if (Nav.page == PageId.integrations) {
            Cfg.back();
        } else if (Nav.page == PageId.keyboard && Kb.purpose != KbPurpose.wifi-password) {
            Nav.go(PageId.integrations, Cfg.focus);
        } else if (Nav.page == PageId.keyboard || Nav.page == PageId.join-failed) {
            Wifi.join-state = JoinState.idle;
            Nav.go(PageId.wifi, 0);
        } else if (!Software.blocking) {
            let to = Nav.back-to(Nav.page);
            Nav.go(to.page, to.focus);
        }
    }

    pure function rows() -> int {
        Nav.page == PageId.inputs ? max(Control.inputs.length, 1)
            : Nav.page == PageId.integrations ? Cfg.rows.length
            : Nav.page == PageId.menu ? Menu.rows.length
            : Nav.page == PageId.display ? Prefs.rows
            : Nav.page == PageId.power ? Power.rows.length
            : Nav.page == PageId.wifi ? Wifi.count
            : Nav.page == PageId.join-failed ? Wifi.stay-row + 1
            : Nav.page == PageId.tracks ? Tracks.rows.length
            : Nav.page == PageId.feedback-lab ? Lab.rows.length
            : Nav.page == PageId.system ? Software.system-rows
            : Nav.page == PageId.fw-update && Software.fw-state == UpdateState.available ? 2
            : Nav.page == PageId.r3-update || Nav.page == PageId.web-config ? 2
            : Nav.page == PageId.remote-control ? (RemoteControl.on ? 2 : 1)
            : 1
    }

    // A page that opens with a grid of tiles: how many of its first items are tiles, and in how many columns.
    pure function tiles() -> int {
        Nav.page == PageId.system ? Software.system-tiles : 0
    }
    pure function columns() -> int {
        Nav.page == PageId.system ? Software.system-columns : 1
    }

    // Up and down: through a list a row at a time; in a grid, a row of tiles at a time, then on to what is under it.
    public function move(d: int) {
        if (Nav.focus < Nav.tiles()) {
            Nav.focus = Nav.focus + d * Nav.columns() < 0 ? Nav.focus : min(Nav.focus + d * Nav.columns(), Nav.tiles());
        } else if (Nav.focus == Nav.tiles() && d < 0 && Nav.tiles() > 0) {
            Nav.focus = Nav.tiles() - Nav.columns();
        } else {
            Nav.focus = max(0, min(Nav.rows() - 1, Nav.focus + d));
        }
    }

    // Left and right across a grid's row; `false` where there is nothing to that side, for the page to decide.
    public function sideways(d: int) -> bool {
        if (Nav.focus >= Nav.tiles()) {
            return false;
        }
        let column = Math.mod(Nav.focus, Nav.columns());
        if (column + d < 0 || column + d >= Nav.columns()) {
            return d > 0;
        }
        Nav.focus += d;
        true
    }

    function activate-menu(i: int) {
        if (i == Menu.row(MenuItem.wifi)) {
            Wifi.scan();
            Nav.go(PageId.wifi, 0);
        } else if (i == Menu.row(MenuItem.integrations)) {
            Cfg.open();
            Nav.go(PageId.integrations, 0);
        } else if (i == Menu.row(MenuItem.display)) {
            Nav.go(PageId.display, 0);
        } else if (i == Menu.row(MenuItem.power)) {
            Nav.go(PageId.power, 0);
        } else if (i == Menu.row(MenuItem.status)) {
            Nav.go(PageId.status, 0);
        } else if (i == Menu.row(MenuItem.system)) {
            Software.opened();
            Nav.go(PageId.system, 0);
        } else if (i == Menu.row(MenuItem.lab)) {
            Nav.go(PageId.feedback-lab, 0);
        }
    }

    function activate-system(i: int) {
        if (i == Software.action-row) {
            if (Software.r3-state == UpdateState.available) {
                Nav.go(PageId.r3-update, 0);
            } else {
                Software.check-r3();
            }
        } else if (i == Software.firmware-row) {
            Nav.go(PageId.fw-update, 0);
        } else if (i == Software.control-row) {
            Nav.go(PageId.remote-control, 0);
        } else if (i == Software.web-row) {
            Software.open-web();
            Nav.go(PageId.web-config, 0);
        } else if (i == Software.voice-row) {
            Software.install-voice();
        } else if (i == Software.uninstall-row) {
            Nav.go(PageId.uninstall, 0);
        }
    }

    function activate-wifi(i: int) {
        if (i == Wifi.band-row) {
            Wifi.band();
        } else if (i >= Wifi.scan-row) {
            Wifi.scan();
        } else if (!Wifi.rows[i].connected) {
            Wifi.target = Wifi.rows[i];
            if (Wifi.rows[i].secured) {
                Kb.purpose = KbPurpose.wifi-password;
                Kb.reset();
                Nav.go(PageId.keyboard, 0);
            } else {
                Wifi.join-state = JoinState.joining;
                Nav.go(PageId.keyboard, 0);
                Wifi.join(Wifi.target.ssid, Wifi.target.ssid-hex, "");
            }
        }
    }

    public function activate(i: int) {
        Nav.focus = i;
        if (Nav.page == PageId.inputs && Control.inputs.length == 0) {
            Cfg.open-for-inputs();
        } else if (Nav.page == PageId.inputs) {
            Control.select-input(Control.inputs[i].id);
            Nav.go(PageId.home, 0);
        } else if (Nav.page == PageId.menu) {
            Nav.activate-menu(i);
        } else if (Nav.page == PageId.tracks) {
            if (i < Tracks.rows.length) {
                Tracks.pick(Tracks.picker, i);
            }
            Nav.go(PageId.home, 0);
        } else if (Nav.page == PageId.integrations) {
            Fx.haptic(Haptic.select);
            Cfg.pick(i);
        } else if (Nav.page == PageId.feedback-lab) {
            if (Lab.pick(i)) {
                Fx.haptic(Haptic.select);
                Nav.focus = 0;
                Nav.inner(true);
            }
        } else {
            // Opening a page gets the page's own haptic; a pick that stays on one gets this.
            Fx.haptic(Haptic.select);
            if (Nav.page == PageId.display) {
                if (i == Prefs.auto-row) {
                    Prefs.auto-brightness = !Prefs.auto-brightness;
                    Prefs.changed();
                }
            } else if (Nav.page == PageId.system) {
                Nav.activate-system(i);
            } else if (Nav.page == PageId.r3-update) {
                if (i == 0) {
                    Software.install-r3();
                } else {
                    Nav.back();
                }
            } else if (Nav.page == PageId.fw-update) {
                if (Software.fw-state != UpdateState.available) {
                    Software.check-fw();
                } else if (i == 0) {
                    Software.install-fw();
                } else {
                    Nav.back();
                }
            } else if (Nav.page == PageId.remote-control) {
                if (i == 0) {
                    RemoteControl.toggle();
                } else {
                    RemoteControl.new-key();
                }
            } else if (Nav.page == PageId.web-config) {
                if (i == 0) {
                    Software.new-pin();
                } else {
                    Software.web-off();
                    Nav.back();
                }
            } else if (Nav.page == PageId.wifi) {
                Nav.activate-wifi(i);
            } else if (Nav.page == PageId.join-failed) {
                Wifi.join-state = JoinState.idle;
                Nav.go(i == Wifi.retry-row ? PageId.keyboard : PageId.wifi, 0);
            } else if (Nav.page == PageId.power) {
                if (i == Power.standby) {
                    Control.power-action(PowerAction.standby);
                } else if (i == Power.restart) {
                    Control.power-action(PowerAction.restart);
                } else if (i == Power.power-off) {
                    Control.power-action(PowerAction.power-off);
                }
            }
        }
    }
}
