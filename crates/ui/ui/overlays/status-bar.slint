import { Glyph, Icons, Marks } from "../marks/icons.slint";

import { Theme, Layout } from "../theme.slint";

export component StatusBar inherits Rectangle {
    in property <string> clock;
    in property <int> battery;
    in property <bool> show-menu: true;
    in property <bool> charging;
    callback menu();

    x: 0;
    y: 0;
    width: Layout.screen-w;
    height: 64px;

    Text {
        x: Layout.margin;
        text: root.clock;
        font-size: 26px;
        color: Theme.text;
    }
    cell := Rectangle {
        x: 350px;
        width: 34px;
        height: 18px;
        border-radius: 5px;
        border-width: 2px;
        border-color: Theme.t2;
        Rectangle {
            x: 4.5px;
            width: 25px * clamp(root.battery, 0, 100) / 100;
            height: 9px;
            border-radius: 2px;
            background: root.charging ? Theme.good : Theme.t2;
        }
    }
    if root.charging: Path {
        x: cell.x + 9px;
        width: 16px;
        height: 22px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: Marks.bolt;
        fill: Theme.text;
        stroke: Theme.bg;
        stroke-width: 1.5px;
    }
    Rectangle {
        x: cell.x + 36px;
        width: 3px;
        height: 7px;
        border-radius: 1.5px;
        background: Theme.t2;
    }
    // Fades rather than leaving, so nothing else in the bar shifts.
    TouchArea {
        mouse-cursor: Theme.cursor;
        x: 400px;
        width: 72px;
        height: 60px;
        enabled: root.show-menu;
        clicked => { root.menu(); }
        Glyph {
            size: 30px;
            commands: Icons.menu;
            opacity: root.show-menu ? 1 : 0;
            animate opacity { duration: Theme.page-time; }
        }
    }
}
