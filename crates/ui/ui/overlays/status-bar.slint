import { Glyph, Icons, Marks } from "../marks/icons.slint";

import { Theme, Layout } from "../theme.slint";

export component StatusBar inherits Rectangle {
    in property <string> clock;
    in property <int> battery;
    in property <bool> in-menu;
    in property <bool> menu-enabled: true;
    in property <bool> charging;
    callback menu();
    callback close();

    x: 0;
    y: 0;
    width: Layout.screen-w;
    height: Layout.navbar-h;

    Text {
        x: Layout.margin;
        y: Layout.navbar-pad;
        height: Layout.navbar-item;
        vertical-alignment: center;
        text: root.clock;
        font-size: 26px;
        color: Theme.text;
    }
    cell := Rectangle {
        x: 350px;
        y: Layout.navbar-pad;
        width: 34px;
        height: Layout.navbar-item;
        Rectangle {
            width: 34px;
            height: 18px;
            border-radius: 5px;
            border-width: 2px;
            border-color: Theme.t2;
            Rectangle {
                x: 4.5px;
                width: 25px * clamp(root.battery, 0, 100) / 100;
                height: 9px;
                border-radius: 2px;
                background: root.charging ? Theme.good : Theme.t2;
            }
        }
    }
    if root.charging: Path {
        x: cell.x + 9px;
        y: (Layout.navbar-h - self.height) / 2;
        width: 16px;
        height: 22px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: Marks.bolt;
        fill: Theme.text;
        stroke: Theme.bg;
        stroke-width: 1.5px;
    }
    Rectangle {
        x: cell.x + 36px;
        y: (Layout.navbar-h - self.height) / 2;
        width: 3px;
        height: 7px;
        border-radius: 1.5px;
        background: Theme.t2;
    }
    // Both glyphs stay in place and trade opacity, so nothing else in the bar shifts.
    TouchArea {
        mouse-cursor: Theme.cursor;
        x: 400px;
        width: 72px;
        height: Layout.navbar-h;
        enabled: root.menu-enabled;
        clicked => {
            if (root.in-menu) {
                root.close();
            } else {
                root.menu();
            }
        }
        Glyph {
            y: Layout.navbar-pad;
            size: Layout.navbar-item;
            commands: Icons.menu;
            opacity: root.in-menu ? 0 : 1;
            animate opacity { duration: Theme.page-time; easing: Theme.page-easing; }
        }
        Glyph {
            y: Layout.navbar-pad;
            size: Layout.navbar-item;
            commands: Icons.close;
            opacity: root.in-menu ? 1 : 0;
            animate opacity { duration: Theme.page-time; easing: Theme.page-easing; }
        }
    }
}
