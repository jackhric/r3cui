import { Choice, Dot, PageId } from "types.slint";
import { Nav } from "globals/nav.slint";

// `accent` is the one interface colour. It is in-out so Rust can change it at runtime:
// `app.global::<Theme>().set_accent(color)`.
export global Theme {
    in-out property <color> accent: #E8343A;
    // Set on the remote, which has no mouse: the display backend would otherwise draw an arrow
    // under every touch.
    in-out property <bool> touch-only: false;
    out property <MouseCursor> cursor: self.touch-only ? MouseCursor.none : MouseCursor.default;
    // Fixed meanings, independent of the accent: red turns off, green turns on.
    out property <color> good: #3DDC84;
    out property <color> off: #E8343A;
    out property <color> on: #3DDC84;
    out property <color> bg: #000000;
    out property <color> text: #F1F3F3;
    out property <color> text-dim: #F1F3F3B3;
    out property <color> t2: #8B9195;
    out property <color> t3: #53595D;
    // Between t2 and t3: for a large mark that should sit back.
    out property <color> t2-muted: #6C7276;
    out property <color> track: #FFFFFF24;
    out property <color> hair: #FFFFFF14;
    out property <duration> page-time: 280ms;
}

// 24x24 stroked glyphs.
export global Icons {
    out property <string> menu: "M4 7h16M4 12h16M4 17h16";
    out property <string> right: "M9 5l7 7-7 7";
    out property <string> left: "M15 5l-7 7 7 7";
    out property <string> check: "M5 12.5l4.5 4.5L19 7.5";
    out property <string> subtitles: "M6 5h12a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V8a3 3 0 0 1 3-3zM7 12h3M13 12h4M7 15.5h6";
    out property <string> audio: "M4 10v4M8 7v10M12 4v16M16 7v10M20 10v4";
    out property <string> speaker: "M4 9.5h3.5L12 6v12l-4.5-3.5H4zM16 9.5a3.5 3.5 0 0 1 0 5";
    out property <string> shift: "M12 5l7 8h-4v6H9v-6H5z";
    out property <string> delete: "M9 6h11v12H9l-5-6zM12.5 9.5l4 5M16.5 9.5l-4 5";
    out property <string> lock: "M7 11h10a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2zM8 11V8a4 4 0 0 1 8 0v3";
    out property <string> power: "M12 3v9M6.3 6.6a8 8 0 1 0 11.4 0";
    out property <string> muted: "M4 9.5h3.5L12 6v12l-4.5-3.5H4zM16 9.5l5 5M21 9.5l-5 5";
    // Circular arrows for the 10-second skips; the number is drawn inside separately.
    out property <string> skip-back: "M12 3.5a8.5 8.5 0 1 1-8.5 8.5M12 3.5l3-2.6M12 3.5l3 2.6";
    out property <string> skip-forward: "M12 3.5a8.5 8.5 0 1 0 8.5 8.5M12 3.5l-3-2.6M12 3.5l-3 2.6";
}

// 24x24 filled marks.
export global Marks {
    // Rounded-corner triangle, its centroid a little right of the box centre so it looks centred.
    out property <string> play: "M7.4 6.3Q7.4 4.7 8.8 5.5L18.6 11.2Q19.9 12 18.6 12.8L8.8 18.5Q7.4 19.3 7.4 17.7Z";
    out property <string> pause: "M7.4 5h2a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zM14.6 5h2a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z";
    out property <string> bolt: "M13.6 1.5 4.2 13.6h6.6L9.4 22.5l9.4-12.1h-6.6z";
}

export component Glyph inherits Path {
    in property <color> tint: Theme.t2;
    in property <length> size: 24px;
    width: self.size;
    height: self.size;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke: self.tint;
    stroke-width: self.size * 1.75 / 24;
    stroke-line-cap: round;
    stroke-line-join: round;
}

export component Logo inherits Path {
    in property <color> tint: Theme.text;
    in property <length> size: 32px;
    width: self.size;
    height: self.size;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: self.tint;
    stroke: transparent;
}

// The one instrument: a thick bar. Volume, film progress and sliders all use it.
export component Bar inherits Rectangle {
    in property <float> value;
    in property <color> tint: Theme.accent;
    in property <bool> handle: false;
    property <float> v: clamp(root.value, 0, 1);

    width: 400px;
    height: 14px;
    border-radius: 7px;
    background: Theme.track;

    Rectangle {
        x: 0;
        width: root.v <= 0 ? 0px : max(14px, root.width * root.v);
        border-radius: 7px;
        background: root.tint;
        animate width { duration: 160ms; easing: ease-out; }
        animate background { duration: 200ms; }
    }
    if root.handle: Rectangle {
        x: root.width * root.v - 16px;
        width: 32px;
        height: 32px;
        border-radius: 16px;
        background: Theme.text;
        animate x { duration: 160ms; easing: ease-out; }
    }
}

export component StatusBar inherits Rectangle {
    in property <string> clock;
    in property <int> battery;
    in property <bool> show-menu: true;
    in property <bool> charging;
    callback menu();

    x: 0;
    y: 0;
    width: 480px;
    height: 64px;

    Text {
        x: 40px;
        text: root.clock;
        font-size: 26px;
        color: Theme.text;
    }
    cell := Rectangle {
        x: 350px;
        width: 34px;
        height: 18px;
        border-radius: 5px;
        border-width: 2px;
        border-color: Theme.t2;
        Rectangle {
            x: 4.5px;
            width: 25px * clamp(root.battery, 0, 100) / 100;
            height: 9px;
            border-radius: 2px;
            background: root.charging ? Theme.good : Theme.t2;
        }
    }
    if root.charging: Path {
        x: cell.x + 9px;
        width: 16px;
        height: 22px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: Marks.bolt;
        fill: Theme.text;
        stroke: Theme.bg;
        stroke-width: 1.5px;
    }
    Rectangle {
        x: cell.x + 36px;
        width: 3px;
        height: 7px;
        border-radius: 1.5px;
        background: Theme.t2;
    }
    // Fades rather than leaving, so nothing else in the bar shifts.
    TouchArea {
        mouse-cursor: Theme.cursor;
        x: 400px;
        width: 72px;
        height: 60px;
        enabled: root.show-menu;
        clicked => { root.menu(); }
        Glyph {
            size: 30px;
            commands: Icons.menu;
            opacity: root.show-menu ? 1 : 0;
            animate opacity { duration: Theme.page-time; }
        }
    }
}

export component ListRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> icon;
    in property <bool> focused;
    in property <bool> chevron;
    in property <bool> checked;
    in property <bool> divider: true;
    // Room kept free at the right edge for whatever the caller places there.
    in property <length> trailing: 0px;
    callback tapped();

    x: 0;
    width: 480px;
    height: 112px;

    if root.divider: Rectangle {
        y: 0;
        height: 1px;
        background: Theme.hair;
    }
    Rectangle {
        x: 0;
        width: 4px;
        height: 40px;
        border-radius: 2px;
        background: Theme.accent;
        opacity: root.focused ? 1 : 0;
        animate opacity { duration: 140ms; }
    }
    if root.icon != "": Logo {
        x: 40px;
        commands: root.icon;
        tint: root.focused ? Theme.text : Theme.t2;
    }
    Text {
        x: root.icon != "" ? 96px : 40px;
        text: root.label;
        font-size: 26px;
        font-weight: root.focused ? 500 : 400;
        color: root.focused ? Theme.text : Theme.text-dim;
        animate color { duration: 140ms; }
    }
    Text {
        x: 0;
        width: (root.chevron || root.checked ? 402px : 440px) - root.trailing;
        horizontal-alignment: right;
        text: root.value;
        font-size: 22px;
        font-weight: 300;
        color: Theme.t2;
    }
    if root.chevron: Glyph {
        x: 416px;
        commands: Icons.right;
        tint: Theme.t3;
    }
    if root.checked: Glyph {
        x: 416px;
        commands: Icons.check;
        tint: Theme.text;
    }
    TouchArea {
        mouse-cursor: Theme.cursor;
        clicked => { root.tapped(); }
    }
}

export component PageHeader inherits Rectangle {
    in property <string> title;
    callback back();

    x: 0;
    y: 64px;
    width: 480px;
    height: 104px;

    Glyph {
        x: 40px;
        size: 28px;
        commands: Icons.left;
        tint: Theme.text;
    }
    Text {
        x: 84px;
        text: root.title;
        font-size: 26px;
        font-weight: 500;
        color: Theme.text;
    }
    TouchArea {
        mouse-cursor: Theme.cursor;
        clicked => { root.back(); }
    }
}

// A full-screen page that fades and slides by its depth in the navigation stack.
export component Layer inherits Rectangle {
    in property <PageId> page;
    property <bool> active: Nav.page == root.page;
    property <int> depth: Nav.depth-of(root.page);
    property <int> current-depth: Nav.depth-of(Nav.page);

    y: 0;
    width: 480px;
    height: 800px;
    x: root.active ? 0px : root.depth > root.current-depth ? 56px : root.depth < root.current-depth ? -56px : 0px;
    opacity: root.active ? 1 : 0;
    visible: self.opacity > 0;
    animate x { duration: Theme.page-time; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    animate opacity { duration: Theme.page-time; easing: ease-out; }
}

// The one primitive for every option layer (inputs, menu, settings, tracks): a header with a
// way back, then rows that share their look, focus mark and spacing. Rows shrink to fit.
export component ChoiceList inherits Rectangle {
    in property <string> title;
    in property <[Choice]> rows;
    in property <int> focused-row: -1;
    // Shown when there are no rows yet.
    in property <string> empty;
    // Off for a list that needs no introduction (the inputs): the rows start under the navbar.
    in property <bool> show-title: true;
    callback pick(int);
    callback back();

    property <length> top: root.show-title ? 168px : 68px;
    property <length> room: 800px - 24px - root.top;
    // Rows shrink to fit a short list on screen, but never below a comfortable touch target;
    // a longer list scrolls instead.
    property <length> row-h: clamp(root.room / max(1, root.rows.length), 76px, 96px);
    property <length> list-h: root.rows.length * root.row-h;
    property <bool> scrolls: root.list-h > root.room;

    // Keys move the focus; keep it in view with a row of context either side where there is one.
    changed focused-row => {
        if root.focused-row < 0 || !root.scrolls { return; }
        let row-top = root.focused-row * root.row-h;
        if row-top + list.content-y < root.row-h {
            list.content-y = min(0px, root.row-h - row-top);
        } else if row-top + root.row-h + list.content-y > root.room - root.row-h {
            list.content-y = max(root.room - root.list-h, root.room - root.row-h - row-top - root.row-h);
        }
    }

    if root.show-title: PageHeader {
        title: root.title;
        back => { root.back(); }
    }
    if root.rows.length == 0: Text {
        y: root.top + 52px;
        width: 480px;
        horizontal-alignment: center;
        text: root.empty;
        font-size: 22px;
        color: Theme.t2;
    }
    list := Flickable {
        y: root.top;
        width: 480px;
        height: root.room;
        content-height: root.list-h;
        interactive: root.scrolls;
        animate content-y { duration: 200ms; easing: ease-out; }
        for row[i] in root.rows: Rectangle {
            property <bool> focused: i == root.focused-row;
            property <length> lead: row.icon != "" ? 96px : row.dot != Dot.none ? 72px : 40px;
            property <length> edge: (row.checked || row.chevron || row.bars > 0 ? 402px : 440px) - (row.locked ? 44px : 0px);
            x: 0;
            y: i * root.row-h;
            width: 480px;
            height: root.row-h;

            if i > 0: Rectangle {
                y: 0;
                height: 1px;
                background: Theme.hair;
            }
            Rectangle {
                x: 0;
                width: 4px;
                height: 40px;
                border-radius: 2px;
                background: row.dot == Dot.down ? Theme.off : Theme.accent;
                opacity: parent.focused || row.dot == Dot.down ? 1 : 0;
                animate opacity { duration: 140ms; }
            }
            // The focused or hovered row lifts very slightly; the others settle back.
            property <float> lift: self.focused || ta.has-hover ? 1.035 : 1;
            animate lift { duration: 180ms; easing: ease-out; }
            if row.icon != "": Logo {
                x: 40px;
                commands: row.icon;
                tint: parent.focused ? Theme.text : Theme.t2;
                transform-origin: { x: self.width / 2, y: self.height / 2 };
                transform-scale: parent.lift;
            }
            // Beside the label, or as a badge on the icon's corner when there is one.
            if row.dot != Dot.none: Rectangle {
                x: row.icon != "" ? 60px : 40px;
                y: row.icon != "" ? parent.height / 2 + 4px : (parent.height - self.height) / 2;
                width: 14px;
                height: 14px;
                border-radius: 7px;
                border-width: row.icon != "" ? 2px : 0px;
                border-color: Theme.bg;
                background: row.dot == Dot.up ? Theme.good : row.dot == Dot.down ? Theme.off : row.dot == Dot.changed ? Theme.accent : Theme.t3;
            }
            Text {
                x: parent.lead;
                y: row.detail == "" ? (parent.height - self.height) / 2 : parent.height / 2 - 30px;
                width: parent.edge - parent.lead - (row.value == "" ? 0px : value-text.width + 20px);
                overflow: elide;
                text: row.label;
                transform-origin: { x: 0, y: self.height / 2 };
                transform-scale: parent.lift;
                font-size: 26px;
                font-weight: parent.focused || row.dot == Dot.down ? 500 : 400;
                color: parent.focused || row.dot == Dot.down ? Theme.text : Theme.text-dim;
                animate color { duration: 140ms; }
            }
            if row.detail != "": Text {
                x: parent.lead;
                y: parent.height / 2 + 6px;
                width: parent.edge - parent.lead - (row.value == "" ? 0px : value-text.width + 20px);
                overflow: elide;
                text: row.detail;
                font-size: 18px;
                color: Theme.t2;
            }
            // As wide as it needs, up to a point; the label takes the rest.
            value-text := Text {
                width: min(self.preferred-width, 220px);
                x: parent.edge - self.width;
                overflow: elide;
                horizontal-alignment: right;
                text: row.value;
                font-size: 22px;
                font-weight: 300;
                color: Theme.t2;
            }
            if row.locked: Glyph {
                x: 364px;
                commands: Icons.lock;
                tint: Theme.t3;
            }
            if row.bars > 0: Rectangle {
                for n in 4: Rectangle {
                    x: 408px + n * 8px;
                    y: parent.height / 2 + 11px - self.height;
                    width: 5px;
                    height: 7px + n * 5px;
                    border-radius: 2px;
                    background: n < row.bars ? Theme.t2 : Theme.track;
                }
            }
            if row.chevron: Glyph {
                x: 416px;
                commands: Icons.right;
                tint: Theme.t3;
            }
            if row.checked: Glyph {
                x: 416px;
                commands: Icons.check;
                tint: Theme.accent;
            }
            ta := TouchArea {
                mouse-cursor: Theme.cursor;
                clicked => { root.pick(i); }
            }
        }
    }

    // More above or below: the list fades out at that edge, and a thin bar shows where you are.
    if root.scrolls: Rectangle {
        y: root.top;
        height: 40px;
        background: @linear-gradient(180deg, Theme.bg 0%, #00000000 100%);
        opacity: list.content-y < 0 ? 1 : 0;
        animate opacity { duration: 150ms; }
    }
    if root.scrolls: Rectangle {
        y: root.top + root.room - 56px;
        height: 56px;
        background: @linear-gradient(180deg, #00000000 0%, Theme.bg 100%);
        opacity: list.content-y > root.room - root.list-h ? 1 : 0;
        animate opacity { duration: 150ms; }
    }
    if root.scrolls: Rectangle {
        x: 472px;
        y: root.top + 8px + (root.room - 16px - self.height) * (-list.content-y / max(1px, root.list-h - root.room));
        width: 3px;
        height: max(32px, (root.room - 16px) * root.room / root.list-h);
        border-radius: 1.5px;
        background: Theme.track;
    }
}
