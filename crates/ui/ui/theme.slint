// `accent` is the one interface colour. It is in-out so Rust can change it at runtime:
// `app.global::<Theme>().set_accent(color)`.
export global Theme {
    in-out property <color> accent: #E8343A;
    // Set on the remote, which has no mouse: the display backend would otherwise draw an arrow
    // under every touch.
    in-out property <bool> touch-only: false;
    out property <MouseCursor> cursor: self.touch-only ? MouseCursor.none : MouseCursor.default;
    // Fixed meanings, independent of the accent: red turns off, green turns on.
    out property <color> good: #3DDC84;
    out property <color> off: #E8343A;
    out property <color> on: #3DDC84;
    out property <color> bg: #000000;
    out property <color> text: #F1F3F3;
    out property <color> text-dim: #F1F3F3B3;
    out property <color> t2: #8B9195;
    out property <color> t3: #53595D;
    // Between t2 and t3: for a large mark that should sit back.
    out property <color> t2-muted: #6C7276;
    out property <color> track: #FFFFFF24;
    out property <color> hair: #FFFFFF14;
    out property <duration> page-time: 280ms;
}

// 24x24 stroked glyphs.
export global Icons {
    out property <string> menu: "M4 7h16M4 12h16M4 17h16";
    out property <string> right: "M9 5l7 7-7 7";
    out property <string> left: "M15 5l-7 7 7 7";
    out property <string> check: "M5 12.5l4.5 4.5L19 7.5";
    out property <string> subtitles: "M6 5h12a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V8a3 3 0 0 1 3-3zM7 12h3M13 12h4M7 15.5h6";
    out property <string> audio: "M4 10v4M8 7v10M12 4v16M16 7v10M20 10v4";
    out property <string> speaker: "M4 9.5h3.5L12 6v12l-4.5-3.5H4zM16 9.5a3.5 3.5 0 0 1 0 5";
    out property <string> shift: "M12 5l7 8h-4v6H9v-6H5z";
    out property <string> delete: "M9 6h11v12H9l-5-6zM12.5 9.5l4 5M16.5 9.5l-4 5";
    out property <string> lock: "M7 11h10a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2zM8 11V8a4 4 0 0 1 8 0v3";
    out property <string> power: "M12 3v9M6.3 6.6a8 8 0 1 0 11.4 0";
    out property <string> muted: "M4 9.5h3.5L12 6v12l-4.5-3.5H4zM16 9.5l5 5M21 9.5l-5 5";
    // Circular arrows for the 10-second skips; the number is drawn inside separately.
    out property <string> skip-back: "M12 3.5a8.5 8.5 0 1 1-8.5 8.5M12 3.5l3-2.6M12 3.5l3 2.6";
    out property <string> skip-forward: "M12 3.5a8.5 8.5 0 1 0 8.5 8.5M12 3.5l-3-2.6M12 3.5l-3 2.6";
}

// 24x24 filled marks.
export global Marks {
    out property <string> play: "M8 4.8v14.4a.8.8 0 0 0 1.2.7l11.3-7.2a.8.8 0 0 0 0-1.4L9.2 4.1A.8.8 0 0 0 8 4.8z";
    out property <string> pause: "M6.5 4h3.5v16H6.5zM14 4h3.5v16H14z";
    out property <string> bolt: "M13.6 1.5 4.2 13.6h6.6L9.4 22.5l9.4-12.1h-6.6z";
}

export component Glyph inherits Path {
    in property <color> tint: Theme.t2;
    in property <length> size: 24px;
    width: self.size;
    height: self.size;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke: self.tint;
    stroke-width: self.size * 1.75 / 24;
    stroke-line-cap: round;
    stroke-line-join: round;
}

export component Logo inherits Path {
    in property <color> tint: Theme.text;
    in property <length> size: 32px;
    width: self.size;
    height: self.size;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: self.tint;
    stroke: transparent;
}

// The one instrument: a thick bar. Volume, film progress and sliders all use it.
export component Bar inherits Rectangle {
    in property <float> value;
    in property <color> tint: Theme.accent;
    in property <bool> handle: false;
    property <float> v: clamp(root.value, 0, 1);

    width: 400px;
    height: 14px;
    border-radius: 7px;
    background: Theme.track;

    Rectangle {
        x: 0;
        width: root.v <= 0 ? 0px : max(14px, root.width * root.v);
        border-radius: 7px;
        background: root.tint;
        animate width { duration: 160ms; easing: ease-out; }
        animate background { duration: 200ms; }
    }
    if root.handle: Rectangle {
        x: root.width * root.v - 16px;
        width: 32px;
        height: 32px;
        border-radius: 16px;
        background: Theme.text;
        animate x { duration: 160ms; easing: ease-out; }
    }
}

export component StatusBar inherits Rectangle {
    in property <string> clock;
    in property <int> battery;
    in property <bool> show-menu: true;
    in property <bool> charging;
    callback menu();

    x: 0;
    y: 0;
    width: 480px;
    height: 64px;

    Text {
        x: 40px;
        text: root.clock;
        font-size: 26px;
        color: Theme.text;
    }
    cell := Rectangle {
        x: 350px;
        width: 34px;
        height: 18px;
        border-radius: 5px;
        border-width: 2px;
        border-color: Theme.t2;
        Rectangle {
            x: 4.5px;
            width: 25px * clamp(root.battery, 0, 100) / 100;
            height: 9px;
            border-radius: 2px;
            background: root.charging ? Theme.good : Theme.t2;
        }
    }
    if root.charging: Path {
        x: cell.x + 9px;
        width: 16px;
        height: 22px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: Marks.bolt;
        fill: Theme.text;
        stroke: Theme.bg;
        stroke-width: 1.5px;
    }
    Rectangle {
        x: cell.x + 36px;
        width: 3px;
        height: 7px;
        border-radius: 1.5px;
        background: Theme.t2;
    }
    // Fades rather than leaving, so nothing else in the bar shifts.
    TouchArea {
        mouse-cursor: Theme.cursor;
        x: 400px;
        width: 72px;
        height: 60px;
        enabled: root.show-menu;
        clicked => { root.menu(); }
        Glyph {
            size: 30px;
            commands: Icons.menu;
            opacity: root.show-menu ? 1 : 0;
            animate opacity { duration: Theme.page-time; }
        }
    }
}

export component ListRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> icon;
    in property <bool> focused;
    in property <bool> chevron;
    in property <bool> checked;
    in property <bool> divider: true;
    // Room kept free at the right edge for whatever the caller places there.
    in property <length> trailing: 0px;
    callback tapped();

    x: 0;
    width: 480px;
    height: 112px;

    if root.divider: Rectangle {
        y: 0;
        height: 1px;
        background: Theme.hair;
    }
    Rectangle {
        x: 0;
        width: 4px;
        height: 40px;
        border-radius: 2px;
        background: Theme.accent;
        opacity: root.focused ? 1 : 0;
        animate opacity { duration: 140ms; }
    }
    if root.icon != "": Logo {
        x: 40px;
        commands: root.icon;
        tint: root.focused ? Theme.text : Theme.t2;
    }
    Text {
        x: root.icon != "" ? 96px : 40px;
        text: root.label;
        font-size: 26px;
        font-weight: root.focused ? 500 : 400;
        color: root.focused ? Theme.text : Theme.text-dim;
        animate color { duration: 140ms; }
    }
    Text {
        x: 0;
        width: (root.chevron || root.checked ? 402px : 440px) - root.trailing;
        horizontal-alignment: right;
        text: root.value;
        font-size: 22px;
        font-weight: 300;
        color: Theme.t2;
    }
    if root.chevron: Glyph {
        x: 416px;
        commands: Icons.right;
        tint: Theme.t3;
    }
    if root.checked: Glyph {
        x: 416px;
        commands: Icons.check;
        tint: Theme.text;
    }
    TouchArea {
        mouse-cursor: Theme.cursor;
        clicked => { root.tapped(); }
    }
}

export component PageHeader inherits Rectangle {
    in property <string> title;
    callback back();

    x: 0;
    y: 64px;
    width: 480px;
    height: 104px;

    Glyph {
        x: 40px;
        size: 28px;
        commands: Icons.left;
        tint: Theme.text;
    }
    Text {
        x: 84px;
        text: root.title;
        font-size: 26px;
        font-weight: 500;
        color: Theme.text;
    }
    TouchArea {
        mouse-cursor: Theme.cursor;
        clicked => { root.back(); }
    }
}

// A full-screen page that fades and slides by its depth in the navigation stack.
export component Page inherits Rectangle {
    in property <int> depth;
    in property <int> current-depth;
    in property <bool> active;

    y: 0;
    width: 480px;
    height: 800px;
    x: root.active ? 0px : root.depth > root.current-depth ? 56px : root.depth < root.current-depth ? -56px : 0px;
    opacity: root.active ? 1 : 0;
    visible: self.opacity > 0;
    animate x { duration: Theme.page-time; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    animate opacity { duration: Theme.page-time; easing: ease-out; }
}

// One row of a choice list. Every field but `label` is optional.
export struct Choice {
    label: string,
    // A second, smaller line under the label.
    detail: string,
    // Right-aligned, before the trailing mark.
    value: string,
    // A brand mark before the label.
    icon: string,
    // The current choice: a tick.
    checked: bool,
    // Leads somewhere else: a chevron.
    chevron: bool,
    // A status dot before the label: 1 working, 2 broken, 3 unknown; 0 for none.
    dot: int,
    // Wi-Fi strength, 1 to 4; 0 for none.
    bars: int,
    locked: bool,
}

// The one primitive for every option layer (inputs, menu, settings, tracks): a header with a
// way back, then rows that share their look, focus mark and spacing. Rows shrink to fit.
export component ChoiceList inherits Rectangle {
    in property <string> title;
    in property <[Choice]> rows;
    in property <int> focused-row: -1;
    // Shown when there are no rows yet.
    in property <string> empty;
    callback pick(int);
    callback back();

    property <length> top: 168px;
    property <length> row-h: min(96px, (800px - 24px - root.top) / max(1, root.rows.length));

    PageHeader {
        title: root.title;
        back => { root.back(); }
    }
    if root.rows.length == 0: Text {
        y: root.top + 52px;
        width: 480px;
        horizontal-alignment: center;
        text: root.empty;
        font-size: 22px;
        color: Theme.t2;
    }
    for row[i] in root.rows: Rectangle {
        property <bool> focused: i == root.focused-row;
        property <length> lead: row.icon != "" ? 96px : row.dot > 0 ? 72px : 40px;
        property <length> edge: (row.checked || row.chevron || row.bars > 0 ? 402px : 440px) - (row.locked ? 44px : 0px);
        x: 0;
        y: root.top + i * root.row-h;
        width: 480px;
        height: root.row-h;

        if i > 0: Rectangle {
            y: 0;
            height: 1px;
            background: Theme.hair;
        }
        Rectangle {
            x: 0;
            width: 4px;
            height: 40px;
            border-radius: 2px;
            background: row.dot == 2 ? Theme.off : Theme.accent;
            opacity: parent.focused || row.dot == 2 ? 1 : 0;
            animate opacity { duration: 140ms; }
        }
        if row.icon != "": Logo {
            x: 40px;
            commands: row.icon;
            tint: parent.focused ? Theme.text : Theme.t2;
        }
        if row.dot > 0: Rectangle {
            x: 40px;
            width: 14px;
            height: 14px;
            border-radius: 7px;
            background: row.dot == 1 ? Theme.good : row.dot == 2 ? Theme.off : Theme.t3;
        }
        Text {
            x: parent.lead;
            y: row.detail == "" ? (parent.height - self.height) / 2 : parent.height / 2 - 30px;
            width: parent.edge - parent.lead - (row.value == "" ? 0px : 120px);
            overflow: elide;
            text: row.label;
            font-size: 26px;
            font-weight: parent.focused || row.dot == 2 ? 500 : 400;
            color: parent.focused || row.dot == 2 ? Theme.text : Theme.text-dim;
            animate color { duration: 140ms; }
        }
        if row.detail != "": Text {
            x: parent.lead;
            y: parent.height / 2 + 6px;
            width: parent.edge - parent.lead;
            overflow: elide;
            text: row.detail;
            font-size: 18px;
            color: Theme.t2;
        }
        if row.value != "": Text {
            x: 0;
            width: parent.edge;
            horizontal-alignment: right;
            text: row.value;
            font-size: 22px;
            font-weight: 300;
            color: Theme.t2;
        }
        if row.locked: Glyph {
            x: 364px;
            commands: Icons.lock;
            tint: Theme.t3;
        }
        if row.bars > 0: Rectangle {
            for n in 4: Rectangle {
                x: 408px + n * 8px;
                y: parent.height / 2 + 11px - self.height;
                width: 5px;
                height: 7px + n * 5px;
                border-radius: 2px;
                background: n < row.bars ? Theme.t2 : Theme.track;
            }
        }
        if row.chevron: Glyph {
            x: 416px;
            commands: Icons.right;
            tint: Theme.t3;
        }
        if row.checked: Glyph {
            x: 416px;
            commands: Icons.check;
            tint: Theme.accent;
        }
        TouchArea {
            mouse-cursor: Theme.cursor;
            clicked => { root.pick(i); }
        }
    }
}
