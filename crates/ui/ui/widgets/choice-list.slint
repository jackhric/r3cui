import { Theme, Layout, Type, Motion } from "../theme.slint";
import { Choice } from "../types.slint";
import { PageHeader } from "page-header.slint";
import { Row } from "row.slint";

// The one primitive for every option layer (inputs, menu, settings, tracks): a header with a
// way back, then rows that share their look, focus mark and spacing. Rows shrink to fit.
export component ChoiceList inherits Rectangle {
    in property <string> title;
    in property <[Choice]> rows;
    in property <int> focused-row: -1;
    // Shown when there are no rows yet.
    in property <string> empty;
    // Off for a list that needs no introduction (the inputs): the rows start under the navbar.
    in property <bool> show-title: true;
    callback pick(int);
    callback back();

    property <length> top: root.show-title ? Layout.list-top : 68px;
    property <length> room: Layout.screen-h - Layout.bottom-inset - root.top;
    // Rows shrink to fit a short list on screen, but never below a comfortable touch target;
    // a longer list scrolls instead.
    property <length> row-h: clamp(root.room / max(1, root.rows.length), Layout.row-min, Layout.row-max);
    property <length> list-h: root.rows.length * root.row-h;
    property <bool> scrolls: root.list-h > root.room;

    // Keys move the focus; keep it in view with a row of context either side where there is one.
    changed focused-row => {
        if root.focused-row < 0 || !root.scrolls { return; }
        let row-top = root.focused-row * root.row-h;
        if row-top + list.content-y < root.row-h {
            list.content-y = min(0px, root.row-h - row-top);
        } else if row-top + root.row-h + list.content-y > root.room - root.row-h {
            list.content-y = max(root.room - root.list-h, root.room - root.row-h - row-top - root.row-h);
        }
    }

    if root.show-title: PageHeader {
        title: root.title;
        back => { root.back(); }
    }
    if root.rows.length == 0: Text {
        y: root.top + 52px;
        width: Layout.screen-w;
        horizontal-alignment: center;
        text: root.empty;
        font-size: 22px;
        color: Theme.t2;
    }
    list := Flickable {
        y: root.top;
        width: Layout.screen-w;
        height: root.room;
        content-height: root.list-h;
        interactive: root.scrolls;
        animate content-y { duration: Motion.list-scroll; easing: ease-out; }
        for row[i] in root.rows: Row {
            y: i * root.row-h;
            height: root.row-h;
            choice: row;
            focused: i == root.focused-row;
            top-line: i > 0;
            tapped => { root.pick(i); }
        }
    }

    // More above or below: the list fades out at that edge, and a thin bar shows where you are.
    if root.scrolls: Rectangle {
        y: root.top;
        height: 40px;
        background: @linear-gradient(180deg, Theme.bg 0%, #00000000 100%);
        opacity: list.content-y < 0 ? 1 : 0;
        animate opacity { duration: 150ms; }
    }
    if root.scrolls: Rectangle {
        y: root.top + root.room - 56px;
        height: 56px;
        background: @linear-gradient(180deg, #00000000 0%, Theme.bg 100%);
        opacity: list.content-y > root.room - root.list-h ? 1 : 0;
        animate opacity { duration: 150ms; }
    }
    if root.scrolls: Rectangle {
        x: 472px;
        y: root.top + 8px + (root.room - 16px - self.height) * (-list.content-y / max(1px, root.list-h - root.room));
        width: 3px;
        height: max(32px, (root.room - 16px) * root.room / root.list-h);
        border-radius: 1.5px;
        background: Theme.track;
    }
}
