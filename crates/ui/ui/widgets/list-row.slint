import { Glyph, Icons, Logo } from "../marks/icons.slint";

import { Theme, Layout, Type, Motion } from "../theme.slint";

export component ListRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> icon;
    in property <bool> focused;
    in property <bool> chevron;
    in property <bool> checked;
    in property <bool> divider: true;
    // Room kept free at the right edge for whatever the caller places there.
    in property <length> trailing: 0px;
    callback tapped();

    x: 0;
    width: Layout.screen-w;
    height: 112px;

    if root.divider: Rectangle {
        y: 0;
        height: Layout.hairline;
        background: Theme.hair;
    }
    Rectangle {
        x: 0;
        width: Layout.focus-bar-w;
        height: Layout.focus-bar-h;
        border-radius: Layout.focus-bar-radius;
        background: Theme.accent;
        opacity: root.focused ? 1 : 0;
        animate opacity { duration: Motion.fade; }
    }
    if root.icon != "": Logo {
        x: Layout.margin;
        commands: root.icon;
        tint: root.focused ? Theme.text : Theme.t2;
    }
    Text {
        x: root.icon != "" ? 96px : Layout.margin;
        text: root.label;
        font-size: Type.label;
        font-weight: root.focused ? Type.label-focused-weight : Type.label-weight;
        color: root.focused ? Theme.text : Theme.text-dim;
        animate color { duration: Motion.fade; }
    }
    Text {
        x: 0;
        width: (root.chevron || root.checked ? Layout.value-edge-trailing : Layout.value-edge) - root.trailing;
        horizontal-alignment: right;
        text: root.value;
        font-size: Type.value;
        font-weight: Type.value-weight;
        color: Theme.t2;
    }
    if root.chevron: Glyph {
        x: Layout.trailing-x;
        commands: Icons.right;
        tint: Theme.t3;
    }
    if root.checked: Glyph {
        x: Layout.trailing-x;
        commands: Icons.check;
        tint: Theme.text;
    }
    TouchArea {
        mouse-cursor: Theme.cursor;
        clicked => { root.tapped(); }
    }
}
