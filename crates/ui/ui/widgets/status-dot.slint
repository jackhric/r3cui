import { Dot } from "../types.slint";
import { Theme } from "../theme.slint";

export component StatusDot inherits Rectangle {
    in property <Dot> dot;
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background: root.dot == Dot.up ? Theme.good : root.dot == Dot.down ? Theme.off : Theme.t3;
}
