// 24x24 filled marks.
export global Marks {
    // Rounded-corner triangle, its centroid a little right of the box centre so it looks centred.
    out property <string> play: "M7.4 6.3Q7.4 4.7 8.8 5.5L18.6 11.2Q19.9 12 18.6 12.8L8.8 18.5Q7.4 19.3 7.4 17.7Z";
    out property <string> pause: "M7.4 5h2a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zM14.6 5h2a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z";
    out property <string> bolt: "M13.6 1.5 4.2 13.6h6.6L9.4 22.5l9.4-12.1h-6.6z";
}

export component Glyph inherits Path {
    in property <color> tint: Theme.t2;
    in property <length> size: 24px;
    width: self.size;
    height: self.size;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke: self.tint;
    stroke-width: self.size * 1.75 / 24;
    stroke-line-cap: round;
    stroke-line-join: round;
}

export component Logo inherits Path {
    in property <color> tint: Theme.text;
    in property <length> size: 32px;
    width: self.size;
    height: self.size;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: self.tint;
    stroke: transparent;
}
