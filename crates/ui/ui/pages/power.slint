import { Nav } from "../globals/nav.slint";
import { Power } from "../globals/power.slint";
import { PageId } from "../types.slint";
import { ChoiceList } from "../widgets/choice-list.slint";
import { Layer } from "../widgets/layer.slint";

export component PowerPage inherits Layer {
    page: PageId.power;
    ChoiceList {
        title: "Power";
        rows: Power.rows;
        focused-row: Nav.focus;
        pick(i) => { Nav.activate(i); }
        back => { Nav.back(); }
    }
}
