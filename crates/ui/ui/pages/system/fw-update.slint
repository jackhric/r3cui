import { Nav } from "../../globals/nav.slint";
import { Software } from "../../globals/software.slint";
import { UcMark } from "../../marks/brand.slint";
import { Marks } from "../../marks/icons.slint";
import { Theme } from "../../theme.slint";
import { PageId, UpdateState } from "../../types.slint";
import { Layer } from "../../widgets/layer.slint";
import { PageHeader } from "../../widgets/page-header.slint";
import { SysRow } from "../../widgets/sys-row.slint";
import { Upgrade } from "upgrade.slint";

export component FwUpdatePage inherits Layer {
    page: PageId.fw-update;
    property <bool> available: Software.fw-state == UpdateState.available;

    PageHeader {
        title: root.available ? "Firmware update" : "Firmware";
        back => { Nav.back(); }
    }
    UcMark {
        x: (480px - self.width) / 2;
        y: 192px;
        wide: 84px;
    }
    if root.available: Upgrade {
        y: 264px;
        from: Software.fw-installed;
        to: Software.fw-new-version;
    }
    if !root.available: Text {
        y: 264px;
        width: 480px;
        horizontal-alignment: center;
        text: Software.fw-installed;
        font-size: 56px;
        font-weight: 200;
        color: Theme.text;
    }
    Text {
        y: 334px;
        width: 480px;
        horizontal-alignment: center;
        text: root.available ? Software.fw-release-line : Software.fw-status;
        font-size: 18px;
        color: Theme.t2;
    }
    if root.available: Rectangle {
        x: 40px;
        y: 376px;
        width: 400px;
        height: 164px;
        border-radius: 14px;
        background: #FFFFFF0A;
        VerticalLayout {
            padding: 18px;
            padding-left: 20px;
            padding-right: 20px;
            spacing: 10px;
            Text {
                text: "WHAT’S NEW";
                font-size: 14px;
                letter-spacing: 2px;
                color: Theme.t2;
            }
            Text {
                text: Software.fw-notes;
                wrap: word-wrap;
                overflow: elide;
                font-size: 18px;
                color: Theme.text-dim;
            }
        }
    }
    if root.available: HorizontalLayout {
        x: 40px;
        y: 556px;
        width: 400px;
        height: 24px;
        spacing: 10px;
        alignment: start;
        Path {
            width: 20px;
            height: 20px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: Marks.bolt;
            fill: Software.fw-battery-ok ? Theme.good : Theme.off;
        }
        Text {
            text: Software.fw-error != "" ? Software.fw-error : Software.fw-battery-line;
            font-size: 17px;
            color: Software.fw-error != "" ? Theme.off : Theme.t2;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    if !root.available && Software.fw-error != "": Text {
        x: 40px;
        y: 376px;
        width: 400px;
        wrap: word-wrap;
        text: Software.fw-error;
        font-size: 17px;
        color: Theme.off;
    }
    SysRow {
        y: 608px;
        top-line: true;
        label: root.available ? "Download" : Software.fw-state == UpdateState.checking ? "Checking…" : "Check for updates";
        value: root.available ? "then install" : "";
        focused: Nav.focus == 0;
        tapped => { Nav.activate(0); }
    }
    if root.available: SysRow {
        y: 684px;
        label: "Not now";
        focused: Nav.focus == 1;
        tapped => { Nav.activate(1); }
    }
}
