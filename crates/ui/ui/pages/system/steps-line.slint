import { Theme, Layout, Type } from "../../theme.slint";

// The stages of an install in a line: the ones done in green, the one under way in white, the rest dim.
export component StepsLine inherits Rectangle {
    in property <[string]> names;
    // The index of the stage under way.
    in property <int> current;

    width: Layout.screen-w;
    height: 20px;
    HorizontalLayout {
        alignment: center;
        spacing: 22px;
        for name[i] in root.names: Text {
            text: name;
            font-size: Type.small;
            color: i < root.current ? Theme.good : i == root.current ? Theme.text : Theme.t3;
            animate color { duration: 200ms; }
        }
    }
}
