import { Nav } from "../../globals/nav.slint";
import { Wifi } from "../../globals/wifi.slint";
import { Theme, Layout } from "../../theme.slint";
import { PageId } from "../../types.slint";
import { Layer } from "../../widgets/layer.slint";
import { PageHeader } from "../../widgets/page-header.slint";
import { Pill } from "../../widgets/pill.slint";

export component JoinFailedPage inherits Layer {
    page: PageId.join-failed;

    PageHeader {
        y: 0;
        title: Wifi.target.ssid;
        back => { Nav.back(); }
    }
    Text {
        y: 300px;
        width: Layout.screen-w;
        horizontal-alignment: center;
        text: "Couldn’t join";
        font-size: 44px;
        font-weight: 300;
        color: Theme.text;
    }
    Text {
        y: 376px;
        width: Layout.screen-w;
        horizontal-alignment: center;
        text: "Check the password and try again.";
        font-size: 22px;
        color: Theme.t2;
    }
    Pill {
        y: 500px;
        label: "Try again";
        focused: Nav.focus == Wifi.retry-row;
        tapped => { Nav.activate(Wifi.retry-row); }
    }
    Pill {
        y: 580px;
        label: Wifi.name == "" ? "Cancel" : "Stay on " + Wifi.name;
        focused: Nav.focus == Wifi.stay-row;
        tapped => { Nav.activate(Wifi.stay-row); }
    }
}
