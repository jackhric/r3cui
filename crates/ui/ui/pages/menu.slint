import { ChoiceList, Layer } from "../theme.slint";
import { Menu } from "../globals/menu.slint";
import { Nav } from "../globals/nav.slint";
import { PageId } from "../types.slint";

export component MenuPage inherits Layer {
    page: PageId.menu;

    ChoiceList {
        title: "Menu";
        rows: Menu.rows;
        focused-row: Nav.focus;
        pick(i) => { Nav.activate(i); }
        back => { Nav.back(); }
    }
}
