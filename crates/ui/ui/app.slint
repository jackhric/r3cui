import "fonts/HankenGrotesk-200.ttf";
import "fonts/HankenGrotesk-300.ttf";
import "fonts/HankenGrotesk-400.ttf";
import "fonts/HankenGrotesk-500.ttf";
import { Choice, ChoiceList, Theme, Icons, Marks, Glyph, Logo, Bar, StatusBar, ListRow, PageHeader, Layer } from "theme.slint";
import { Logos } from "logos.slint";
import { Codecs } from "codecs.slint";
import { KeyChars } from "keys.slint";
import { Library, LibItem } from "library.slint";

export { Choice, Theme, Logos, Icons, Marks, Codecs, KeyChars }

export struct InputRow {
    // What the source calls it; picking a row sends this.
    id: string,
    name: string,
    icon: string,
}

export struct WifiRow {
    ssid: string,
    ssid-hex: string,
    secured: bool,
    // 1 to 4
    bars: int,
    connected: bool,
}

export struct StatusRow {
    label: string,
    value: string,
    // 0 working, 1 broken, 2 unknown because something it depends on is broken
    level: int,
}

export struct KeyCell {
    label: string,
    icon: string,
    x: length,
    y: length,
    w: length,
    h: length,
    focused: bool,
    // 0 character, 1 action, 2 action armed, 3 join (not ready), 4 join (ready)
    style: int,
}

component StatusDot inherits Rectangle {
    in property <int> level;
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background: root.level == 0 ? Theme.good : root.level == 1 ? Theme.off : Theme.t3;
}

// Why the screen cannot do its job, shown on the home screen itself.
component WarningRow inherits Rectangle {
    in property <string> message;
    callback tapped();
    x: 0;
    width: 480px;
    height: 56px;
    HorizontalLayout {
        alignment: center;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            StatusDot { level: 1; }
        }
        Text {
            text: root.message;
            font-size: 22px;
            color: Theme.text;
            vertical-alignment: center;
        }
    }
    TouchArea {
        mouse-cursor: Theme.cursor;
        clicked => { root.tapped(); }
    }
}

component Pill inherits Rectangle {
    in property <string> label;
    in property <bool> focused;
    callback tapped();
    x: 40px;
    width: 400px;
    height: 64px;
    border-radius: 32px;
    background: #131314;
    border-width: root.focused ? 4px : 0px;
    border-color: Theme.accent;
    Text {
        text: root.label;
        font-size: 22px;
        color: root.focused ? Theme.text : Theme.t2;
    }
    TouchArea {
        mouse-cursor: Theme.cursor;
        clicked => { root.tapped(); }
    }
}

// A codec's logo and the rest of its name. The logo is drawn from the part of its viewbox that
// `logo-top`, `logo-width` and `logo-height` mark out, `size` tall.
component FormatBadge inherits HorizontalLayout {
    in property <string> logo;
    in property <float> logo-width: 24;
    in property <float> logo-top: 0;
    in property <float> logo-height: 24;
    in property <string> label;
    in property <length> size: 30px;
    in property <bool> on-baseline;
    alignment: center;
    spacing: 12px;
    height: 40px;
    if root.logo != "": Rectangle {
        width: root.size * root.logo-width / root.logo-height;
        Path {
            // A wordmark sits on the label's baseline (27px down the 40px row, measured for
            // 22px Hanken Grotesk); a mark is centred.
            y: root.on-baseline ? 27px - root.size : (40px - root.size) / 2;
            width: parent.width;
            height: root.size;
            viewbox-y: root.logo-top;
            viewbox-width: root.logo-width;
            viewbox-height: root.logo-height;
            commands: root.logo;
            fill: Theme.text;
        }
    }
    Text {
        text: root.label;
        font-size: 22px;
        color: Theme.t2;
        vertical-alignment: center;
    }
}

component VolumeChip inherits HorizontalLayout {
    in property <int> volume;
    in property <bool> muted;
    in property <length> size: 24px;
    alignment: center;
    spacing: 10px;
    VerticalLayout {
        alignment: center;
        // The speaker fills only the middle half of its 24-unit box; this size makes it as tall as
        // the number's capitals.
        Glyph {
            size: root.size * 1.3;
            commands: root.muted ? Icons.muted : Icons.speaker;
        }
    }
    Text {
        text: root.volume;
        font-size: root.size;
        font-weight: 300;
        color: Theme.t2;
        vertical-alignment: center;
    }
}

component VolumeReadout inherits Rectangle {
    in property <int> volume;
    in property <string> volume-db;
    in property <bool> muted;
    in property <length> top;

    width: 480px;
    Text {
        y: root.top;
        width: 480px;
        height: 190px;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.volume;
        font-size: 200px;
        font-weight: 200;
        letter-spacing: -8px;
        color: root.muted ? Theme.t3 : Theme.text;
        animate color { duration: 200ms; }
    }
    Text {
        y: root.top + 194px;
        width: 480px;
        horizontal-alignment: center;
        text: root.volume-db;
        font-size: 26px;
        font-weight: 300;
        color: root.muted ? Theme.t3 : Theme.t2;
    }
    Bar {
        x: 40px;
        y: root.top + 254px;
        value: root.volume / 100;
        tint: root.muted ? Theme.t3 : Theme.accent;
    }
}

component TrackButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    callback tapped();
    width: 200px;
    height: 60px;
    border-radius: 30px;
    background: touch.pressed ? #FFFFFF26 : #FFFFFF12;
    HorizontalLayout {
        alignment: center;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Glyph { commands: root.icon; tint: Theme.text; }
        }
        Text {
            text: root.label;
            font-size: 22px;
            color: Theme.text;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: Theme.cursor;
        clicked => { root.tapped(); }
    }
}

component SkipButton inherits Rectangle {
    in property <bool> back;
    callback tapped();
    width: 64px;
    height: 64px;
    opacity: touch.pressed ? 0.5 : 1;
    Glyph {
        size: 64px;
        commands: root.back ? Icons.skip-back : Icons.skip-forward;
        tint: Theme.text;
    }
    Text {
        y: 22px;
        text: "10";
        font-size: 17px;
        font-weight: 500;
        color: Theme.text;
    }
    touch := TouchArea {
        mouse-cursor: Theme.cursor;
        clicked => { root.tapped(); }
    }
}

// Shown until the real poster from the library is wired in.
component PosterStandIn inherits Rectangle {
    in property <string> title;
    background: @linear-gradient(180deg, #06252c 0%, #0f4a50 40%, #b8602b 72%, #2a1208 100%);
    Rectangle {
        y: parent.height * 0.26;
        width: parent.width * 0.56;
        height: self.width;
        border-radius: self.width / 2;
        background: @radial-gradient(circle, #ffb26b 0%, #e57b36 50%, #e57b3600 72%);
    }
    Rectangle {
        y: parent.height * 0.62;
        height: parent.height * 0.38;
        background: @linear-gradient(180deg, #05060800 0%, #050608 45%, #050608 100%);
    }
    Text {
        y: parent.height * 0.8;
        width: parent.width - 24px;
        horizontal-alignment: center;
        wrap: word-wrap;
        text: root.title;
        font-size: 13px;
        font-weight: 500;
        letter-spacing: 2.6px;
        color: Theme.text;
    }
}

export component AppWindow inherits Window {
    title: "remote-ui";
    width: 480px;
    height: 800px;
    background: Theme.bg;
    default-font-family: "Hanken Grotesk";
    forward-focus: keys;

    // False while the remote is idle or asleep: the screen closes down to the bar and goes dark.
    in property <bool> awake: true;
    in property <bool> power-on: true;
    in property <bool> connected: false;
    in property <string> status: "Connecting…";
    in property <string> clock;
    in property <int> battery: 100;

    // 0-100 of the volume limit.
    in property <int> volume;
    // Something is set up as global volume.
    in property <bool> has-volume: true;
    in property <string> volume-db;
    in property <bool> muted;
    in property <bool> volume-overlay;
    in property <string> input;
    in property <string> input-icon;
    // An input picked here that the source has not confirmed yet.
    in property <bool> switching;
    in property <[InputRow]> inputs;
    in property <int> input-index;

    // True while the input on now has something in its UI slot: the home page is its stage.
    in property <bool> staged;
    in property <string> media-title;
    in property <image> poster;
    in-out property <color> poster-accent;
    in-out property <bool> poster-tinted;
    in property <float> progress;
    in property <string> time-left;
    in property <string> ends-at;
    in property <image> backdrop;
    in property <image> grain;
    in property <string> media-sub;
    in property <bool> paused;
    in property <string> elapsed;
    in property <string> media-format-logo;
    in property <float> media-format-logo-width: 24;
    in property <float> media-format-logo-top: 0;
    in property <float> media-format-logo-height: 24;
    in property <length> media-format-logo-size: 30px;
    in property <bool> media-format-logo-baseline;
    in property <string> media-format-label;
    // The audio or subtitle picker: 0 audio, 1 subtitles.
    in-out property <int> picker;
    in-out property <[Choice]> tracks;
    in property <[Choice]> input-choices;
    in property <[Choice]> wifi-choices;
    in property <[Choice]> status-choices;
    // The idle home screen's animated background.
    in property <image> lava;
    in property <int> lib-mode;
    in property <string> lib-heading;
    in property <string> lib-count;
    in property <[image]> lib-posters;
    in property <[LibItem]> lib-items;
    in property <int> lib-focus;
    in property <int> lib-wall-style: 2;
    public function hold-library() { lib.hold(); }
    public function run-library() { lib.run(); }
    out property <bool> lava-on: root.page == 0 && root.home-view == 2 && root.lit;
    in property <bool> charging;
    // On the charger the screen and keys go dark after a short while; any input brings them back.
    in-out property <bool> resting;
    in-out property <bool> charge-card;
    out property <bool> lit: root.awake && !root.resting;

    in property <string> wifi-name;
    in-out property <int> brightness: 90;
    in-out property <bool> auto-brightness: true;
    in property <string> screen-off-after;
    in property <string> haptics;
    in property <string> sleep-after;

    in property <[WifiRow]> wifi-rows;
    in property <bool> wifi-scanning;
    in-out property <WifiRow> wifi-target;
    // 0 idle, 1 joining, 2 failed
    in-out property <int> join-state;
    in property <[StatusRow]> status-rows;
    // Non-empty when something the home screen depends on is unreachable.
    in property <string> home-warning;
    in property <[KeyCell]> kb-keys;
    in property <string> kb-text;

    // 0 home, 1 inputs, 2 menu, 3 display, 4 power, 5 wi-fi, 6 keyboard, 7 status, 8 join failed,
    // 9 audio or subtitle picker, 10 feedback lab, 11 integrations
    in-out property <int> page: 0;
    in property <[Choice]> lab-rows;
    in property <string> lab-title: "Feedback lab";
    // True when the pick opened another lab screen.
    callback lab-pick(int) -> bool;
    // The row to focus after going back within the lab, or -1 to leave the lab.
    callback lab-back() -> int;
    in-out property <int> focus-index: 0;
    // Integrations: Rust draws each of its screens into one list, and decides where a pick or back leads.
    in property <string> cfg-title: "Integrations";
    in property <[Choice]> cfg-rows;
    // The row to come back to from the keyboard.
    in property <int> cfg-focus;
    callback cfg-open();
    callback cfg-pick(int);
    callback cfg-back();
    // The keyboard: 0 a Wi-Fi password, 1 other text (an integration's setting, an input's name).
    in-out property <int> kb-purpose;
    in property <string> kb-title;
    in property <string> kb-caption;

    // The play/pause control on the stage.
    callback play-pause();
    // Raw key text; mapped to a hard button in Rust (desktop stand-in for evdev).
    callback key(string);
    callback select-input(string);
    callback power-action(string);
    callback wifi-scan();
    // Switch the remote's preferred Wi-Fi band between 2.4 and 5 GHz.
    callback wifi-band();
    in property <bool> wifi-band-known;
    // ssid, ssid-hex, password ("" for an open network)
    callback wifi-join(string, string, string);
    callback kb-reset();
    // Ready the keyboard for other text, starting from this.
    callback kb-start(string);
    // "up", "down", "left", "right", "ok" or "back"
    callback kb-nav(string);
    callback kb-tap(int);
    // The physical power key, held: switch what global control drives on or off. A short press does nothing.
    callback power-held();
    // An event name from `UI_EVENTS` in feedback.rs.
    callback haptic(string);
    // Seconds to jump, back (negative) or forward.
    callback seek(int);
    callback open-picker(int);
    callback pick-track(int, int);
    // Any key or touch: restarts the charger's countdown to dark.
    callback activity();
    // The user changed brightness or auto brightness on the Display page.
    callback display-changed();

    out property <bool> power-overlay: root.power-holding || root.power-latched;
    out property <bool> power-turning-off: true;
    property <bool> power-holding;
    property <bool> power-latched;
    // Stays set through the fade-out so the label does not flip back while disappearing.
    property <bool> power-completed;
    property <color> power-tint: root.power-turning-off ? Theme.off : Theme.on;

    // Lists one step from the stage share a depth, so opening one from the stage is the layer
    // transition alone, without a sideways slide.
    property <int> depth: root.page <= 2 || root.page == 9 ? 1 : root.page == 6 ? 3 : root.page == 8 ? 4 : 2;
    property <float> recede: root.page != 0 ? 1 : 0;
    animate recede { duration: 460ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    property <bool> overlay-open: (root.volume-overlay && root.power-on) || root.power-overlay || root.home-holding || (root.charge-card && root.lit);
    property <float> under: root.overlay-open ? 1 : 0;
    animate under { duration: 380ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    in property <image> stage-blur;
    in property <image> world-blur;
    // Ask for a blurred picture of what is on screen now: 0 the stage, 1 everything.
    callback capture(int);
    // A change of main stage in progress; Rust supplies the pictures and starts it.
    in-out property <bool> swapping;
    // Timed from the animation clock: a declared animation on a property nothing reads while
    // hidden jumps straight to its end.
    property <duration> swap-start;
    // The pictures are taken before the clock can move on, so the swap holds the old stage until
    // `run-swap` starts the clock on a fresh tick.
    property <bool> swap-held;
    property <float> swap-linear: !root.swapping || root.swap-held ? 0 : clamp((animation-tick() - root.swap-start) / 620ms, 0, 1);
    property <float> swap: root.swap-linear * root.swap-linear * (3 - 2 * root.swap-linear);
    public function hold-swap() {
        root.swap-held = true;
        root.swapping = true;
    }
    public function run-swap() {
        root.swap-start = animation-tick();
        root.swap-held = false;
    }
    // Between the idle mark and Now playing: the same blur, without the zoom.
    in property <bool> swap-plain;
    in property <image> swap-out;
    in property <image> swap-out-blur;
    in property <image> swap-in-blur;
    // Set by Rust only while it takes that picture: 1 shows the stage alone, 2 hides the overlays.
    in-out property <int> capturing;
    property <bool> caret-on: true;
    // The home key: a tap is home, a hold opens the input list.
    property <bool> home-down;
    property <bool> home-used;
    property <bool> home-rumbling;
    // 1 something is playing, 2 the input's mark (when idle), 3 power off, 4 a library wall
    property <int> home-view: !root.power-on ? 3 : root.staged && root.media-title != "" ? 1 : root.lib-mode > 0 ? 4 : 2;

    // Haptics mark arriving somewhere new and pressing OK; moving the focus stays silent.
    public function go(p: int, f: int) {
        if (p != root.page) {
            root.haptic("page");
        }
        if (root.page == 0 && p != 0) {
            root.capture(0);
        }
        root.focus-index = f;
        root.page = p;
    }
    public function back() {
        if (root.page == 10) {
            let focus = root.lab-back();
            if (focus < 0) {
                root.go(2, 6);
            } else {
                root.focus-index = focus;
            }
        } else if (root.page == 11) {
            root.cfg-back();
        } else if (root.page == 6 && root.kb-purpose == 1) {
            root.go(11, root.cfg-focus);
        } else if (root.page == 3) {
            root.go(2, 2);
        } else if (root.page == 4) {
            root.go(2, 4);
        } else if (root.page == 5) {
            root.go(2, 0);
        } else if (root.page == 7) {
            root.go(2, 5);
        } else if (root.page == 9) {
            root.go(0, 0);
        } else if (root.page == 6 || root.page == 8) {
            root.join-state = 0;
            root.go(5, 0);
        } else {
            root.go(0, 0);
        }
    }
    function row-count() -> int {
        root.page == 1 ? root.inputs.length : root.page == 11 ? root.cfg-rows.length : root.page == 2 ? 7 : root.page == 3 ? 3 : root.page == 4 ? 4 : root.page == 5 ? root.wifi-rows.length + (root.wifi-band-known ? 2 : 1) : root.page == 8 ? 2 : root.page == 9 ? root.tracks.length : root.page == 10 ? root.lab-rows.length : 1
    }
    public function move(d: int) {
        root.focus-index = max(0, min(root.row-count() - 1, root.focus-index + d));
    }
    public function activate(i: int) {
        root.focus-index = i;
        // A pick that opens another page already gets the page's haptic.
        if (root.page != 10 && root.page != 1 && root.page != 2 && root.page != 9 && root.page != 11) {
            root.haptic("select");
        }
        if (root.page == 11) {
            root.haptic("select");
            root.cfg-pick(i);
        } else if (root.page == 10) {
            if (root.lab-pick(i)) {
                root.haptic("select");
                root.focus-index = 0;
            }
        } else if (root.page == 1) {
            root.select-input(root.inputs[i].id);
            root.go(0, 0);
        } else if (root.page == 2) {
            if (i == 0) {
                root.wifi-scan();
                root.go(5, 0);
            } else if (i == 1) {
                root.cfg-open();
                root.go(11, 0);
            } else if (i == 2) {
                root.go(3, 0);
            } else if (i == 4) {
                root.go(4, 0);
            } else if (i == 5) {
                root.go(7, 0);
            } else if (i == 6) {
                root.go(10, 0);
            }
        } else if (root.page == 3) {
            if (i == 1) {
                root.auto-brightness = !root.auto-brightness;
                root.display-changed();
            }
        } else if (root.page == 5) {
            if (i == root.wifi-rows.length + 1) {
                root.wifi-band();
            } else if (i >= root.wifi-rows.length) {
                root.wifi-scan();
            } else if (!root.wifi-rows[i].connected) {
                root.wifi-target = root.wifi-rows[i];
                if (root.wifi-rows[i].secured) {
                    root.kb-purpose = 0;
                    root.kb-reset();
                    root.go(6, 0);
                } else {
                    root.join-state = 1;
                    root.go(6, 0);
                    root.wifi-join(root.wifi-target.ssid, root.wifi-target.ssid-hex, "");
                }
            }
        } else if (root.page == 9) {
            if (i < root.tracks.length) {
                root.pick-track(root.picker, i);
            }
            root.go(0, 0);
        } else if (root.page == 8) {
            root.join-state = 0;
            root.go(i == 0 ? 6 : 5, 0);
        } else if (root.page == 4) {
            if (i == 0) {
                root.power-action("STANDBY");
            } else if (i == 1) {
                root.power-action("RESTART");
            } else if (i == 2) {
                root.power-action("POWER_OFF");
            }
        }
    }

    property <float> wake: root.lit ? 1 : 0;
    animate wake { duration: 650ms; easing: ease-in-out; }
    // Smoothed again so the fade and zoom ease at both ends.
    property <float> reveal: root.wake * root.wake * (3 - 2 * root.wake);

    keys := FocusScope {
        transform-scale: 0.8 + 0.2 * root.reveal;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        opacity: root.reveal;
        key-pressed(event) => {
            root.activity();
            if (root.resting || root.charge-card) {
                root.resting = false;
                root.charge-card = false;
                return accept;
            }
            if (event.text.to-lowercase() == KeyChars.power) {
                if (!event.repeat && !root.power-latched) {
                    root.power-turning-off = root.power-on;
                    root.power-completed = false;
                    root.capture(1);
                    root.hold-look = 2;
                    root.power-hold-start = animation-tick();
                    root.power-holding = true;
                    root.haptic("power-hold");
                }
                return accept;
            }
            if (event.text.to-lowercase() == KeyChars.home) {
                if (!event.repeat) {
                    root.home-down = true;
                    root.home-used = false;
                    root.home-rumbling = false;
                }
                return accept;
            }
            // The voice key is the input switcher, from anywhere.
            if (event.text.to-lowercase() == KeyChars.input) {
                if (!event.repeat && root.page != 6) {
                    root.go(root.page == 1 ? 0 : 1, root.input-index);
                }
                return accept;
            }
            if (root.page == 6) {
                if (root.join-state != 1) {
                    root.kb-nav(event.text == Key.UpArrow ? "up" : event.text == Key.DownArrow ? "down" : event.text == Key.LeftArrow ? "left" : event.text == Key.RightArrow ? "right" : event.text == Key.Return ? "ok" : event.text == Key.Backspace || event.text == Key.Escape ? "back" : "");
                }
                return accept;
            }
            if (root.page != 0) {
                if (event.text == Key.Escape || event.text == Key.Backspace) {
                    root.back();
                    return accept;
                }
                if (event.text == Key.UpArrow) {
                    root.move(-1);
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    root.move(1);
                    return accept;
                }
                if (event.text == Key.Return) {
                    root.activate(root.focus-index);
                    return accept;
                }
                if (event.text == Key.LeftArrow || event.text == Key.RightArrow) {
                    if (root.page == 3 && root.focus-index == 0) {
                        if (!root.auto-brightness) {
                            root.brightness = max(5, min(100, root.brightness + (event.text == Key.LeftArrow ? -5 : 5)));
                            root.display-changed();
                        }
                    } else if (event.text == Key.LeftArrow) {
                        root.back();
                    }
                    return accept;
                }
            }
            if (!event.repeat && event.text == Key.Return) {
                root.haptic("select");
            }
            root.key(event.text);
            return accept;
        }

        key-released(event) => {
            if ((event.text.to-lowercase() == KeyChars.home) && root.home-down) {
                root.home-down = false;
                if (!root.home-used) {
                    if (root.home-rumbling) {
                        root.haptic("hold-cancel");
                    }
                    // A tap: back to the home screen from anywhere else, or the input's own home.
                    if (root.page != 0) {
                        root.go(0, 0);
                    } else {
                        root.key(KeyChars.home);
                    }
                }
            }
            if ((event.text.to-lowercase() == KeyChars.power) && root.power-holding) {
                root.power-holding = false;
                root.haptic("hold-cancel");
            }
            return accept;
        }
        Timer {
            interval: 1200ms;
            running: root.power-holding;
            triggered => {
                root.power-holding = false;
                root.power-latched = true;
                root.power-completed = true;
                root.power-held();
                root.haptic("power-complete");
            }
        }
        // Taps are common, so the rumble waits a moment before starting.
        Timer {
            interval: 160ms;
            running: root.home-down && !root.home-used && !root.home-rumbling;
            triggered => {
                root.capture(1);
                root.hold-look = 1;
                root.home-hold-start = animation-tick();
                root.home-rumbling = true;
                root.haptic("home-hold");
            }
        }
        Timer {
            interval: 650ms;
            running: root.home-down && !root.home-used;
            triggered => {
                root.home-used = true;
                root.haptic("home-complete");
                root.go(1, root.input-index);
            }
        }
        Timer {
            interval: 660ms;
            running: root.swapping && !root.swap-held;
            triggered => { root.swapping = false; }
        }
        Timer {
            interval: 550ms;
            running: root.page == 6;
            triggered => { root.caret-on = !root.caret-on; }
        }
        Timer {
            interval: 900ms;
            running: root.power-latched;
            triggered => { root.power-latched = false; }
        }

        // Catches touches that land on nothing, so the pointer stays hidden there too.
        TouchArea {
            mouse-cursor: Theme.cursor;
        }

        // Three layers. The main stage (home, now playing) is at the bottom; option lists (menu,
        // inputs, track pickers) open over it, and the stage recedes: it shrinks, blurs and dims
        // until it is only faintly there behind the list. Overlays (volume, power, charging) do
        // the same to whatever lies beneath them. Blur is a snapshot taken as the layer opens,
        // since Slint cannot blur live content.
        world := Rectangle {
            transform-origin: { x: self.width / 2, y: self.height / 2 };
            transform-scale: root.capturing != 0 ? 1 : 1 - 0.05 * root.under;

            stage := Rectangle {
                transform-origin: { x: self.width / 2, y: self.height / 2 };
                transform-scale: root.capturing == 1 ? 1 : (1 - 0.08 * root.recede) * (root.swapping && !root.swap-plain ? 0.97 + 0.03 * root.swap : 1);
                opacity: root.capturing == 1 ? 1 : 1 - 0.55 * root.recede;


                    // The input's UI slot, playing
                    Rectangle {
                        opacity: root.home-view == 1 ? 1 : 0;
                        visible: self.opacity > 0;

                        // The backdrop arrives already blurred and darkened; the scrim fades it into black
                        // where the controls sit.
                        Image {
                            width: 480px;
                            height: 800px;
                            source: root.backdrop;
                            image-fit: cover;
                            opacity: 0.55;
                        }
                        Image {
                            width: 480px;
                            height: 800px;
                            source: root.grain;
                            image-fit: fill;
                            image-rendering: pixelated;
                            opacity: root.backdrop.width > 0 ? 1 : 0;
                        }
                        Rectangle {
                            background: @linear-gradient(180deg, #00000066 0%, #00000022 26%, #000000B0 52%, #000000 74%);
                        }

                        Rectangle {
                            x: 144px;
                            y: 84px;
                            width: 192px;
                            height: 288px;
                            border-radius: 0;
                            drop-shadow-blur: 28px;
                            drop-shadow-color: #000000CC;
                            drop-shadow-offset-y: 10px;
                            background: #111;
                            Rectangle {
                                border-radius: 0;
                                clip: true;
                                if root.poster.width == 0: PosterStandIn {
                                    title: root.media-title;
                                }
                                if root.poster.width > 0: Image {
                                    source: root.poster;
                                    width: 100%;
                                    height: 100%;
                                    image-fit: cover;
                                }
                            }
                        }
                        Text {
                            y: 392px;
                            x: 24px;
                            width: 432px;
                            height: 36px;
                            horizontal-alignment: center;
                            overflow: elide;
                            text: root.media-title;
                            font-size: 28px;
                            font-weight: 500;
                            color: Theme.text;
                        }
                        Text {
                            y: 430px;
                            width: 480px;
                            horizontal-alignment: center;
                            text: root.media-sub;
                            font-size: 18px;
                            color: Theme.t2;
                        }
                        Bar {
                            x: 40px;
                            y: 470px;
                            value: root.progress;
                        }
                        Text {
                            x: 40px;
                            y: 494px;
                            text: root.elapsed;
                            font-size: 18px;
                            font-weight: 400;
                            color: Theme.t2;
                        }
                        Text {
                            x: 40px;
                            y: 494px;
                            width: 400px;
                            horizontal-alignment: right;
                            text: root.paused ? root.time-left + "  ·  paused" : root.time-left + "  ·  " + root.ends-at;
                            font-size: 18px;
                            color: Theme.t2;
                        }

                        SkipButton {
                            x: 84px;
                            y: 548px;
                            back: true;
                            tapped => { root.seek(-10); }
                        }
                        Rectangle {
                            x: 198px;
                            y: 542px;
                            width: 84px;
                            height: 84px;
                            border-radius: 42px;
                            background: #FFFFFF;
                            opacity: play-touch.pressed ? 0.7 : 1;
                            // The play mark's geometry already sits it right of centre by its
                            // visual weight, so both marks fill the same centred box.
                            Path {
                                width: 42px;
                                height: 42px;
                                viewbox-width: 24;
                                viewbox-height: 24;
                                commands: root.paused ? Marks.play : Marks.pause;
                                fill: #000000;
                            }
                            play-touch := TouchArea {
                                mouse-cursor: Theme.cursor;
                                clicked => { root.play-pause(); }
                            }
                        }
                        SkipButton {
                            x: 332px;
                            y: 548px;
                            back: false;
                            tapped => { root.seek(10); }
                        }

                        if root.home-warning == "": HorizontalLayout {
                            y: 656px;
                            height: 40px;
                            alignment: center;
                            spacing: 18px;
                            FormatBadge {
                                logo: root.media-format-logo;
                                logo-width: root.media-format-logo-width;
                        logo-top: root.media-format-logo-top;
                        logo-height: root.media-format-logo-height;
                        size: root.media-format-logo-size;
                        on-baseline: root.media-format-logo-baseline;
                                label: root.media-format-label;
                            }
                            if root.media-format-label != "" || root.media-format-logo != "": Text {
                                text: "·";
                                font-size: 22px;
                                color: Theme.t3;
                                vertical-alignment: center;
                            }
                            if root.has-volume: VolumeChip {
                                volume: root.volume;
                                muted: root.muted;
                                size: 22px;
                            }
                        }
                        if root.home-warning != "": WarningRow {
                            y: 648px;
                            message: root.home-warning;
                            tapped => { root.go(7, 0); }
                        }
                        TrackButton {
                            x: 32px;
                            y: 716px;
                            icon: Icons.subtitles;
                            label: "Subtitles";
                            tapped => { root.tracks = []; root.picker = 1; root.go(9, 0); root.open-picker(1); }
                        }
                        TrackButton {
                            x: 248px;
                            y: 716px;
                            icon: Icons.audio;
                            label: "Audio";
                            tapped => { root.tracks = []; root.picker = 0; root.go(9, 0); root.open-picker(0); }
                        }
                    }

                    // The current input, shown as its mark. An input showing its library looks the same as any other.
                    Rectangle {
                        opacity: root.home-view == 2 ? 1 : 0;
                        visible: self.opacity > 0;

                        // The colour wash behind the mark, faded out at the top and bottom so the navbar
                        // and the volume line sit on plain black.
                        Image {
                            width: 480px;
                            height: 800px;
                            source: root.lava;
                            image-fit: fill;
                            image-rendering: pixelated;
                        }
                        Rectangle {
                            height: 150px;
                            y: 0;
                            background: @linear-gradient(180deg, #000000 0%, #000000 30%, #00000000 100%);
                        }
                        Rectangle {
                            y: 630px;
                            height: 170px;
                            background: @linear-gradient(180deg, #00000000 0%, #000000 55%, #000000 100%);
                        }

                        // While the input is still switching, a faint sheen sweeps across the mark.
                        property <float> sheen: mod(animation-tick() / 1400ms, 1.0) * 1.6 - 0.3;
                        Path {
                            y: 330px;
                            width: 140px;
                            height: 140px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: root.input-icon;
                            fill: !root.switching ? Theme.t2-muted : @linear-gradient(110deg,
                                Theme.t2-muted 0%,
                                Theme.t2-muted clamp(parent.sheen - 0.18, 0, 1) * 100%,
                                #9DA3A6 clamp(parent.sheen, 0, 1) * 100%,
                                Theme.t2-muted clamp(parent.sheen + 0.18, 0, 1) * 100%,
                                Theme.t2-muted 100%);
                        }
                        // An input with no mark of its own needs its name to be told apart.
                        if root.input != "" && root.input-icon == Logos.generic: Text {
                            y: 490px;
                            width: 480px;
                            horizontal-alignment: center;
                            text: root.input;
                            font-size: 26px;
                            color: Theme.t2;
                        }
                        if root.inputs.length > 0: TouchArea {
                            mouse-cursor: Theme.cursor;
                            x: 140px;
                            y: 300px;
                            width: 200px;
                            height: 200px;
                            clicked => { root.go(1, root.input-index); }
                        }
                        if root.home-warning != "": WarningRow {
                            y: 540px;
                            message: root.home-warning;
                            tapped => { root.go(7, 0); }
                        }
                        if root.has-volume: VolumeChip {
                            y: 700px;
                            height: 40px;
                            size: 32px;
                            volume: root.volume;
                            muted: root.muted;
                        }
                    }

                    // Power off
                    Rectangle {
                        opacity: root.home-view == 3 ? 1 : 0;
                        visible: self.opacity > 0;

                        Glyph {
                            y: 340px;
                            size: 72px;
                            commands: Icons.power;
                            tint: Theme.t3;
                        }
                        Text {
                            y: 436px;
                            width: 480px;
                            horizontal-alignment: center;
                            text: "Off";
                            font-size: 26px;
                            color: Theme.t2;
                        }
                    }

                    // The input's library wall, mirrored; also the previews' library variations.
                    lib := Library {
                        mode: root.lib-mode;
                        heading: root.lib-heading;
                        count: root.lib-count;
                        posters: root.lib-posters;
                        items: root.lib-items;
                        at: root.lib-focus;
                        wall-style: root.lib-wall-style;
                        opacity: root.home-view == 4 ? 1 : 0;
                        visible: self.opacity > 0 && root.lib-mode > 0;
                    }

                    if !root.connected: Text {
                        y: 772px;
                        width: 480px;
                        horizontal-alignment: center;
                        text: root.status;
                        font-size: 14px;
                        color: Theme.t3;
                        overflow: elide;
                    }

                // One stage giving way to another: the old one, sharp then blurred, dissolves into
                // the new one blurred, which sharpens into the live stage beneath.
                Rectangle {
                    visible: root.swapping && root.capturing == 0;
                    Image {
                        width: 480px;
                        height: 800px;
                        source: root.swap-in-blur;
                        image-fit: fill;
                        opacity: 1 - clamp((root.swap - 0.55) / 0.45, 0, 1);
                    }
                    Image {
                        width: 480px;
                        height: 800px;
                        transform-origin: { x: self.width / 2, y: self.height / 2 };
                        transform-scale: root.swap-plain ? 1 : 1 + 0.05 * root.swap;
                        source: root.swap-out-blur;
                        image-fit: fill;
                        opacity: 1 - clamp((root.swap - 0.25) / 0.35, 0, 1);
                    }
                    Image {
                        width: 480px;
                        height: 800px;
                        transform-origin: { x: self.width / 2, y: self.height / 2 };
                        transform-scale: root.swap-plain ? 1 : 1 + 0.05 * root.swap;
                        source: root.swap-out;
                        image-fit: fill;
                        opacity: 1 - clamp(root.swap / 0.3, 0, 1);
                    }
                }

                Image {
                    width: 480px;
                    height: 800px;
                    source: root.stage-blur;
                    image-fit: fill;
                    opacity: root.recede;
                    visible: self.opacity > 0 && root.capturing != 1;
                }
            }

            options := Rectangle {
                visible: root.recede > 0 && root.capturing != 1;
                opacity: root.recede;
                transform-origin: { x: self.width / 2, y: self.height / 2 };
                transform-scale: 1.04 - 0.04 * root.recede;
                background: #000000B8;
                // The stage behind is only scenery while a list is open.
                TouchArea { mouse-cursor: Theme.cursor; }

            // Inputs
            Layer {
                depth: 1;
                current-depth: root.depth;
                active: root.page == 1;
                ChoiceList {
                    title: "Inputs";
                    show-title: false;
                    rows: root.input-choices;
                    focused-row: root.focus-index;
                    pick(i) => { root.activate(i); }
                    back => { root.back(); }
                }
            }

            // Menu
            Layer {
                depth: 1;
                current-depth: root.depth;
                active: root.page == 2;

                ChoiceList {
                    title: "Menu";
                    rows: [
                        { label: "Wi-Fi", value: root.wifi-name, chevron: true },
                        { label: "Integrations", chevron: true },
                        { label: "Display", value: root.auto-brightness ? "Auto" : root.brightness + "%", chevron: true },
                        { label: "Sound & haptics", value: root.haptics, chevron: true },
                        { label: "Power", chevron: true },
                        { label: "Status", chevron: true },
                        { label: "Feedback lab", chevron: true },
                    ];
                    focused-row: root.focus-index;
                    pick(i) => { root.activate(i); }
                    back => { root.back(); }
                }
            }

            // Menu / Display
            Layer {
                depth: 2;
                current-depth: root.depth;
                active: root.page == 3;

                PageHeader {
                    title: "Display";
                    back => { root.back(); }
                }
                Rectangle {
                    x: 0;
                    y: 168px;
                    width: 4px;
                    height: 40px;
                    border-radius: 2px;
                    background: Theme.accent;
                    opacity: root.focus-index == 0 ? 1 : 0;
                    animate opacity { duration: 140ms; }
                }
                Text {
                    x: 40px;
                    y: 172px;
                    text: "Brightness";
                    font-size: 26px;
                    font-weight: root.focus-index == 0 ? 500 : 400;
                    color: root.auto-brightness ? Theme.t3 : root.focus-index == 0 ? Theme.text : Theme.text-dim;
                }
                Text {
                    x: 40px;
                    y: 176px;
                    width: 400px;
                    horizontal-alignment: right;
                    text: root.auto-brightness ? "Automatic" : root.brightness + "%";
                    font-size: 22px;
                    font-weight: 300;
                    color: Theme.t2;
                }
                // Locked while auto brightness is on: the remote sets the level itself then.
                Bar {
                    x: 40px;
                    y: 250px;
                    value: root.brightness / 100;
                    handle: !root.auto-brightness;
                    tint: root.auto-brightness ? Theme.t3 : Theme.accent;
                    opacity: root.auto-brightness ? 0.5 : 1;
                    animate opacity { duration: 160ms; }
                }
                TouchArea {
                    mouse-cursor: Theme.cursor;
                    x: 24px;
                    y: 220px;
                    width: 432px;
                    height: 74px;
                    enabled: !root.auto-brightness;
                    function set() {
                        root.focus-index = 0;
                        root.brightness = max(5, min(100, round((self.mouse-x - 16px) / 400px * 100)));
                        root.display-changed();
                    }
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            self.set();
                        }
                    }
                    moved => {
                        if (self.pressed) {
                            self.set();
                        }
                    }
                }
                ListRow {
                    y: 328px;
                    height: 104px;
                    label: "Auto brightness";
                    focused: root.focus-index == 1;
                    tapped => { root.activate(1); }
                    Rectangle {
                        x: 384px;
                        width: 56px;
                        height: 32px;
                        border-radius: 16px;
                        background: root.auto-brightness ? Theme.text : Theme.track;
                        animate background { duration: 160ms; }
                        Rectangle {
                            x: root.auto-brightness ? 28px : 4px;
                            width: 24px;
                            height: 24px;
                            border-radius: 12px;
                            background: root.auto-brightness ? Theme.bg : Theme.t2;
                            animate x { duration: 160ms; easing: ease-out; }
                        }
                    }
                }
                ListRow {
                    y: 432px;
                    height: 104px;
                    label: "Screen off after";
                    value: root.screen-off-after;
                    chevron: true;
                    focused: root.focus-index == 2;
                    tapped => { root.activate(2); }
                }
            }

            // Menu / Power
            Layer {
                depth: 2;
                current-depth: root.depth;
                active: root.page == 4;
                ChoiceList {
                    title: "Power";
                    rows: [
                        { label: "Standby" },
                        { label: "Restart" },
                        { label: "Power off" },
                        { label: "Sleep after", value: root.sleep-after, chevron: true },
                    ];
                    focused-row: root.focus-index;
                    pick(i) => { root.activate(i); }
                    back => { root.back(); }
                }
            }

            // Menu / Wi-Fi
            Layer {
                depth: 2;
                current-depth: root.depth;
                active: root.page == 5;
                ChoiceList {
                    title: "Wi-Fi";
                    rows: root.wifi-choices;
                    focused-row: root.focus-index;
                    pick(i) => { root.activate(i); }
                    back => { root.back(); }
                }
            }

            // Menu / Wi-Fi / password
            Layer {
                depth: 3;
                current-depth: root.depth;
                active: root.page == 6;

                PageHeader {
                    y: 0;
                    title: root.kb-purpose == 1 ? root.kb-title : root.wifi-target.ssid;
                    back => { root.back(); }
                }
                Text {
                    x: 40px;
                    y: 128px;
                    text: root.kb-purpose == 1 ? root.kb-caption : "PASSWORD";
                    font-size: 13px;
                    font-weight: 500;
                    letter-spacing: 1.8px;
                    color: Theme.t2;
                }
                Rectangle {
                    x: 40px;
                    y: 158px;
                    width: 400px;
                    height: 84px;
                    clip: true;
                    HorizontalLayout {
                        alignment: end;
                        spacing: 3px;
                        Text {
                            text: root.kb-text;
                            font-size: 40px;
                            font-weight: 300;
                            letter-spacing: 0.8px;
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 3px;
                                height: 40px;
                                border-radius: 2px;
                                background: Theme.accent;
                                opacity: root.caret-on && root.join-state != 1 ? 1 : 0;
                            }
                        }
                    }
                }
                Rectangle {
                    x: 40px;
                    y: 242px;
                    width: 400px;
                    height: 1px;
                    background: Theme.hair;
                }

                if root.join-state != 1: Rectangle {
                    for key[i] in root.kb-keys: Rectangle {
                        x: key.x;
                        y: key.y;
                        width: key.w;
                        height: key.h;
                        border-radius: key.style == 0 ? 12px : 16px;
                        background: key.focused ? Theme.accent : key.style == 2 ? #2A2A2C : key.style == 0 ? #121213 : #161617;
                        opacity: key.focused && key.style == 3 ? 0.45 : 1;
                        transform-scale: key.focused ? (key.style == 0 ? 1.12 : 1.06) : 1;
                        animate transform-scale, background { duration: 80ms; }
                        if key.icon == "": Text {
                            text: key.label;
                            font-size: key.style == 0 ? 26px : 20px;
                            font-weight: key.focused || key.style == 4 ? 600 : key.style == 0 ? 400 : 500;
                            color: key.focused ? #000000 : key.style == 3 ? Theme.t3 : key.style == 4 ? Theme.accent : Theme.text;
                        }
                        if key.icon != "": Glyph {
                            commands: key.icon;
                            tint: key.focused ? #000000 : Theme.text;
                        }
                        TouchArea {
                            mouse-cursor: Theme.cursor;
                            clicked => { root.kb-tap(i); }
                        }
                    }
                }
                if root.join-state == 1: Rectangle {
                    Text {
                        y: 440px;
                        width: 480px;
                        horizontal-alignment: center;
                        text: "Joining…";
                        font-size: 32px;
                        font-weight: 300;
                        color: Theme.text;
                    }
                    Rectangle {
                        x: 120px;
                        y: 524px;
                        width: 240px;
                        height: 14px;
                        border-radius: 7px;
                        background: Theme.track;
                        clip: true;
                        Rectangle {
                            x: 75px + 75px * sin(animation-tick() / 1ms * 0.33deg);
                            width: 90px;
                            border-radius: 7px;
                            background: Theme.accent;
                        }
                    }
                }
            }

            // Menu / Status
            Layer {
                depth: 2;
                current-depth: root.depth;
                active: root.page == 7;
                ChoiceList {
                    title: "Status";
                    rows: root.status-choices;
                    back => { root.back(); }
                }
            }

            // Menu / Integrations, every screen of it
            Layer {
                depth: 2;
                current-depth: root.depth;
                active: root.page == 11;
                ChoiceList {
                    title: root.cfg-title;
                    rows: root.cfg-rows;
                    focused-row: root.focus-index;
                    pick(i) => { root.activate(i); }
                    back => { root.back(); }
                }
            }

            // Menu / Feedback lab
            Layer {
                depth: 2;
                current-depth: root.depth;
                active: root.page == 10;
                ChoiceList {
                    title: root.lab-title;
                    rows: root.lab-rows;
                    focused-row: root.focus-index;
                    pick(i) => { root.activate(i); }
                    back => { root.back(); }
                }
            }

            // Menu / Wi-Fi / join failed
            Layer {
                depth: 4;
                current-depth: root.depth;
                active: root.page == 8;

                PageHeader {
                    y: 0;
                    title: root.wifi-target.ssid;
                    back => { root.back(); }
                }
                Text {
                    y: 300px;
                    width: 480px;
                    horizontal-alignment: center;
                    text: "Couldn’t join";
                    font-size: 44px;
                    font-weight: 300;
                    color: Theme.text;
                }
                Text {
                    y: 376px;
                    width: 480px;
                    horizontal-alignment: center;
                    text: "Check the password and try again.";
                    font-size: 22px;
                    color: Theme.t2;
                }
                Pill {
                    y: 500px;
                    label: "Try again";
                    focused: root.focus-index == 0;
                    tapped => { root.activate(0); }
                }
                Pill {
                    y: 580px;
                    label: root.wifi-name == "" ? "Cancel" : "Stay on " + root.wifi-name;
                    focused: root.focus-index == 1;
                    tapped => { root.activate(1); }
                }
            }

            // Audio or subtitle tracks
            Layer {
                depth: 1;
                current-depth: root.depth;
                active: root.page == 9;
                ChoiceList {
                    title: root.picker == 0 ? "Audio" : "Subtitles";
                    rows: root.tracks;
                    empty: "Loading…";
                    focused-row: root.focus-index;
                    pick(i) => { root.activate(i); }
                    back => { root.back(); }
                }
            }
            }

            Image {
                width: 480px;
                height: 800px;
                source: root.world-blur;
                image-fit: fill;
                opacity: root.under;
                visible: self.opacity > 0 && root.capturing == 0;
            }
        }

        // Volume overlay, over everything.
        Rectangle {
            property <bool> shown: root.volume-overlay && root.power-on;
            background: #000000A6;
            opacity: self.shown ? 1 : 0;
            visible: self.opacity > 0 && root.capturing == 0;
            animate opacity { duration: 180ms; easing: ease-out; }

            Glyph {
                y: 198px;
                size: 52px;
                commands: Icons.muted;
                opacity: root.muted ? 1 : 0;
                animate opacity { duration: 160ms; }
            }
            VolumeReadout {
                y: 0;
                height: 800px;
                top: 270px;
                volume: root.volume;
                volume-db: root.volume-db;
                muted: root.muted;
            }
        }
    }

    // Holding power or Home: one overlay. A ring fills around a mark placed exactly where the home
    // screen's mark sits. Progress runs from the clock, so every hold starts from an empty ring.
    property <bool> home-holding: root.home-down && root.home-rumbling && !root.home-used;
    property <duration> home-hold-start;
    property <duration> power-hold-start;
    // Which hold the overlay shows: 1 Home (inputs), 2 power. Kept through the fade-out so the
    // overlay does not change look while it disappears.
    property <int> hold-look: 1;
    property <bool> hold-shown: root.power-overlay || root.home-holding;
    property <float> hold-linear: root.power-latched ? 1
        : root.power-holding ? clamp((animation-tick() - root.power-hold-start) / 1200ms, 0, 1)
        : root.home-holding ? clamp((animation-tick() - root.home-hold-start) / 490ms, 0, 1)
        : 0;
    property <float> hold-progress: root.hold-linear * root.hold-linear * (3 - 2 * root.hold-linear);
    property <float> ring: min(root.hold-progress, 0.9999);
    property <color> ring-tint: root.hold-look == 2 ? root.power-tint : Theme.accent;
    Rectangle {
        background: #000000A6;
        opacity: root.hold-shown ? 1 : 0;
        visible: self.opacity > 0 && root.capturing == 0;
        animate opacity { duration: 160ms; easing: ease-out; }
        Path {
            x: 120px;
            y: 280px;
            width: 240px;
            height: 240px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M12 1.5A10.5 10.5 0 1 1 11.999 1.5";
            fill: transparent;
            stroke: Theme.track;
            stroke-width: 10px;
        }
        Path {
            x: 120px;
            y: 280px;
            width: 240px;
            height: 240px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M12 1.5A10.5 10.5 0 " + (root.ring > 0.5 ? "1" : "0") + " 1 " + (12 + 10.5 * sin(root.ring * 360deg)) + " " + (12 - 10.5 * cos(root.ring * 360deg));
            fill: transparent;
            stroke: root.ring-tint;
            stroke-width: 10px;
            stroke-line-cap: round;
            opacity: root.hold-progress > 0.001 ? 1 : 0;
        }
        if root.hold-look == 1: Logo {
            y: 330px;
            size: 140px;
            commands: root.input-icon;
            tint: Theme.text;
        }
        if root.hold-look == 2: Glyph {
            y: 345px;
            size: 110px;
            commands: Icons.power;
            tint: root.power-completed ? root.power-tint : Theme.text;
        }
        Text {
            y: 548px;
            width: 480px;
            horizontal-alignment: center;
            text: root.hold-look == 1 ? "Inputs"
                : root.power-completed ? (root.power-turning-off ? "Off" : "On")
                : (root.power-turning-off ? "Hold to turn off" : "Hold to turn on");
            font-size: 26px;
            font-weight: 300;
            color: root.hold-look == 2 && root.power-completed ? Theme.text : Theme.t2;
        }
    }

    // Charging: the battery, full screen, until the first touch or key.
    Rectangle {
        background: #000000C0;
        opacity: root.charge-card && root.lit ? 1 : 0;
        visible: self.opacity > 0 && root.capturing == 0;
        animate opacity { duration: 300ms; easing: ease-in-out; }
        Rectangle {
            x: 122px;
            y: 300px;
            width: 220px;
            height: 104px;
            border-radius: 26px;
            border-width: 5px;
            border-color: #FFFFFF59;
            Rectangle {
                x: 11px;
                y: 11px;
                width: (parent.width - 22px) * clamp(root.battery, 4, 100) / 100;
                height: parent.height - 22px;
                border-radius: 16px;
                background: Theme.good;
            }
            Path {
                width: 64px;
                height: 84px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: Marks.bolt;
                fill: Theme.text;
                stroke: Theme.bg;
                stroke-width: 4px;
            }
        }
        Rectangle {
            x: 346px;
            y: 334px;
            width: 12px;
            height: 36px;
            border-radius: 6px;
            background: #FFFFFF59;
        }
        Text {
            y: 436px;
            width: 480px;
            horizontal-alignment: center;
            text: root.battery + "%";
            font-size: 64px;
            font-weight: 200;
            color: Theme.text;
        }
        Text {
            y: 520px;
            width: 480px;
            horizontal-alignment: center;
            text: root.battery >= 100 ? "Charged" : "Charging";
            font-size: 22px;
            color: Theme.t2;
        }
        TouchArea {
            mouse-cursor: Theme.cursor;
            clicked => {
                root.charge-card = false;
                root.activity();
            }
        }
    }

    // The navbar belongs to no layer: it stays put through every transition, fading only with
    // sleep, and is kept out of the snapshots so no blurred copy of it shows behind it.
    navbar := Rectangle {
        y: 0;
        height: 64px;
        opacity: root.reveal * (root.page == 6 || root.page == 8 ? 0 : 1);
        visible: self.opacity > 0 && root.capturing == 0;
        animate opacity { duration: Theme.page-time; }
        StatusBar {
            clock: root.clock;
            battery: root.battery;
            charging: root.charging;
            show-menu: root.page <= 1;
            menu => { root.go(2, 0); }
        }
        // The input's mark sits in the middle everywhere but the input's own screen (or the power-off one), so
        // away from it you can always tell where you are; tapping it opens the list.
        TouchArea {
            property <bool> shown: root.inputs.length > 0 && !(root.page == 0 && (root.home-view == 2 || root.home-view == 3));
            mouse-cursor: Theme.cursor;
            x: 190px;
            width: 100px;
            height: 64px;
            enabled: self.shown && root.page != 1;
            clicked => { root.go(1, root.input-index); }
            Logo {
                size: 32px;
                commands: root.input-icon;
                tint: Theme.t2;
                opacity: parent.shown ? 1 : 0;
                animate opacity { duration: 620ms; easing: ease-in-out; }
            }
        }
    }

    if !root.awake: TouchArea { mouse-cursor: Theme.cursor; }
    // The first touch after resting only wakes the screen.
    if root.awake && root.resting: TouchArea {
        mouse-cursor: Theme.cursor;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.resting = false;
                root.activity();
            }
        }
    }
}
