import "fonts/HankenGrotesk-200.ttf";
import "fonts/HankenGrotesk-300.ttf";
import "fonts/HankenGrotesk-400.ttf";
import "fonts/HankenGrotesk-500.ttf";
import { ChoiceList, Theme, Icons, Marks, Glyph, Logo, Bar, StatusBar, ListRow, PageHeader, Layer } from "theme.slint";
import { Logos } from "logos.slint";
import { Codecs } from "codecs.slint";
import { KeyChars } from "keys.slint";
import { Library } from "library.slint";
import { Capture, PageId, FormatMark, PowerAction, Dot, KeyGlyph, KeyStyle, NavKey, Choice, Haptic, LibMode, WallStyle, JoinState, KbPurpose, Picker, InputRow, WifiRow, KeyCell, LibItem } from "types.slint";
import { Health } from "globals/health.slint";
import { Playback } from "globals/playback.slint";
import { Control } from "globals/control.slint";
import { Sys } from "globals/sys.slint";
import { Fx } from "globals/fx.slint";
import { Lib } from "globals/lib.slint";
import { Tracks } from "globals/tracks.slint";
import { Lab } from "globals/lab.slint";
import { Cfg } from "globals/cfg.slint";
import { Wifi } from "globals/wifi.slint";
import { Kb } from "globals/kb.slint";
import { Prefs } from "globals/prefs.slint";

export * from "types.slint";
export { Theme, Logos, Icons, Marks, Codecs, KeyChars, Prefs, Kb, Wifi, Cfg, Lab, Tracks, Lib, Fx, Sys, Control, Playback, Health }

enum HomeView {
    playing,
    mark,
    off,
    wall,
}

enum HoldKind {
    home,
    power,
}

component StatusDot inherits Rectangle {
    in property <Dot> dot;
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background: root.dot == Dot.up ? Theme.good : root.dot == Dot.down ? Theme.off : Theme.t3;
}

// Why the screen cannot do its job, shown on the home screen itself.
component WarningRow inherits Rectangle {
    in property <string> message;
    callback tapped();
    x: 0;
    width: 480px;
    height: 56px;
    HorizontalLayout {
        alignment: center;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            StatusDot { dot: Dot.down; }
        }
        Text {
            text: root.message;
            font-size: 22px;
            color: Theme.text;
            vertical-alignment: center;
        }
    }
    TouchArea {
        mouse-cursor: Theme.cursor;
        clicked => { root.tapped(); }
    }
}

component Pill inherits Rectangle {
    in property <string> label;
    in property <bool> focused;
    callback tapped();
    x: 40px;
    width: 400px;
    height: 64px;
    border-radius: 32px;
    background: #131314;
    border-width: root.focused ? 4px : 0px;
    border-color: Theme.accent;
    Text {
        text: root.label;
        font-size: 22px;
        color: root.focused ? Theme.text : Theme.t2;
    }
    TouchArea {
        mouse-cursor: Theme.cursor;
        clicked => { root.tapped(); }
    }
}

// A codec's logo and the rest of its name.
component FormatBadge inherits HorizontalLayout {
    in property <FormatMark> mark;
    in property <string> label;
    alignment: center;
    spacing: 12px;
    height: 40px;
    if root.mark.path != "": Rectangle {
        width: root.mark.size * root.mark.width / root.mark.height;
        Path {
            // A wordmark sits on the label's baseline (27px down the 40px row, measured for
            // 22px Hanken Grotesk); a mark is centred.
            y: root.mark.baseline ? 27px - root.mark.size : (40px - root.mark.size) / 2;
            width: parent.width;
            height: root.mark.size;
            viewbox-y: root.mark.top;
            viewbox-width: root.mark.width;
            viewbox-height: root.mark.height;
            commands: root.mark.path;
            fill: Theme.text;
        }
    }
    Text {
        text: root.label;
        font-size: 22px;
        color: Theme.t2;
        vertical-alignment: center;
    }
}

component VolumeChip inherits HorizontalLayout {
    in property <int> volume;
    in property <bool> muted;
    in property <length> size: 24px;
    alignment: center;
    spacing: 10px;
    VerticalLayout {
        alignment: center;
        // The speaker fills only the middle half of its 24-unit box; this size makes it as tall as
        // the number's capitals.
        Glyph {
            size: root.size * 1.3;
            commands: root.muted ? Icons.muted : Icons.speaker;
        }
    }
    Text {
        text: root.volume;
        font-size: root.size;
        font-weight: 300;
        color: Theme.t2;
        vertical-alignment: center;
    }
}

component VolumeReadout inherits Rectangle {
    in property <int> volume;
    in property <string> volume-db;
    in property <bool> muted;
    in property <length> top;

    width: 480px;
    Text {
        y: root.top;
        width: 480px;
        height: 190px;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.volume;
        font-size: 200px;
        font-weight: 200;
        letter-spacing: -8px;
        color: root.muted ? Theme.t3 : Theme.text;
        animate color { duration: 200ms; }
    }
    Text {
        y: root.top + 194px;
        width: 480px;
        horizontal-alignment: center;
        text: root.volume-db;
        font-size: 26px;
        font-weight: 300;
        color: root.muted ? Theme.t3 : Theme.t2;
    }
    Bar {
        x: 40px;
        y: root.top + 254px;
        value: root.volume / 100;
        tint: root.muted ? Theme.t3 : Theme.accent;
    }
}

component TrackButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    callback tapped();
    width: 200px;
    height: 60px;
    border-radius: 30px;
    background: touch.pressed ? #FFFFFF26 : #FFFFFF12;
    HorizontalLayout {
        alignment: center;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Glyph { commands: root.icon; tint: Theme.text; }
        }
        Text {
            text: root.label;
            font-size: 22px;
            color: Theme.text;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: Theme.cursor;
        clicked => { root.tapped(); }
    }
}

component SkipButton inherits Rectangle {
    in property <bool> back;
    callback tapped();
    width: 64px;
    height: 64px;
    opacity: touch.pressed ? 0.5 : 1;
    Glyph {
        size: 64px;
        commands: root.back ? Icons.skip-back : Icons.skip-forward;
        tint: Theme.text;
    }
    Text {
        y: 22px;
        text: "10";
        font-size: 17px;
        font-weight: 500;
        color: Theme.text;
    }
    touch := TouchArea {
        mouse-cursor: Theme.cursor;
        clicked => { root.tapped(); }
    }
}

// Shown until the real poster from the library is wired in.
component PosterStandIn inherits Rectangle {
    in property <string> title;
    background: @linear-gradient(180deg, #06252c 0%, #0f4a50 40%, #b8602b 72%, #2a1208 100%);
    Rectangle {
        y: parent.height * 0.26;
        width: parent.width * 0.56;
        height: self.width;
        border-radius: self.width / 2;
        background: @radial-gradient(circle, #ffb26b 0%, #e57b36 50%, #e57b3600 72%);
    }
    Rectangle {
        y: parent.height * 0.62;
        height: parent.height * 0.38;
        background: @linear-gradient(180deg, #05060800 0%, #050608 45%, #050608 100%);
    }
    Text {
        y: parent.height * 0.8;
        width: parent.width - 24px;
        horizontal-alignment: center;
        wrap: word-wrap;
        text: root.title;
        font-size: 13px;
        font-weight: 500;
        letter-spacing: 2.6px;
        color: Theme.text;
    }
}

export component AppWindow inherits Window {
    title: "remote-ui";
    width: 480px;
    height: 800px;
    background: Theme.bg;
    default-font-family: "Hanken Grotesk";
    forward-focus: keys;

    public function hold-library() { lib.hold(); }
    public function run-library() { lib.run(); }
    out property <bool> lava-on: root.page == PageId.home && root.home-view == HomeView.mark && Sys.lit;

    in-out property <PageId> page: PageId.home;
    in-out property <int> focus-index: 0;

    out property <bool> power-overlay: root.power-holding || root.power-latched;
    out property <bool> power-turning-off: true;
    property <bool> power-holding;
    property <bool> power-latched;
    // Stays set through the fade-out so the label does not flip back while disappearing.
    property <bool> power-completed;
    property <color> power-tint: root.power-turning-off ? Theme.off : Theme.on;

    // Lists one step from the stage share a depth, so opening one from the stage is the layer
    // transition alone, without a sideways slide.
    property <int> depth: root.page == PageId.home || root.page == PageId.inputs || root.page == PageId.menu || root.page == PageId.tracks ? 1 : root.page == PageId.keyboard ? 3 : root.page == PageId.join-failed ? 4 : 2;
    property <float> recede: root.page != PageId.home ? 1 : 0;
    animate recede { duration: 460ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    property <bool> overlay-open: (Control.volume-overlay && Control.power-on) || root.power-overlay || root.home-holding || (Sys.charge-card && Sys.lit);
    property <float> under: root.overlay-open ? 1 : 0;
    animate under { duration: 380ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    // Timed from the animation clock: a declared animation on a property nothing reads while
    // hidden jumps straight to its end.
    property <duration> swap-start;
    // The pictures are taken before the clock can move on, so the swap holds the old stage until
    // `run-swap` starts the clock on a fresh tick.
    property <bool> swap-held;
    property <float> swap-linear: !Fx.swapping || root.swap-held ? 0 : clamp((animation-tick() - root.swap-start) / 620ms, 0, 1);
    property <float> swap: root.swap-linear * root.swap-linear * (3 - 2 * root.swap-linear);
    public function hold-swap() {
        root.swap-held = true;
        Fx.swapping = true;
    }
    public function run-swap() {
        root.swap-start = animation-tick();
        root.swap-held = false;
    }
    property <bool> caret-on: true;
    // The home key: a tap is home, a hold opens the input list.
    property <bool> home-down;
    property <bool> home-used;
    property <bool> home-rumbling;
    property <HomeView> home-view: !Control.power-on ? HomeView.off : Playback.staged && Playback.title != "" ? HomeView.playing : Lib.mode != LibMode.off ? HomeView.wall : HomeView.mark;

    // Haptics mark arriving somewhere new and pressing OK; moving the focus stays silent.
    public function go(p: PageId, f: int) {
        if (p != root.page) {
            Fx.haptic(Haptic.page);
        }
        if (root.page == PageId.home && p != PageId.home) {
            Fx.capture(Capture.stage);
        }
        root.focus-index = f;
        root.page = p;
    }
    public function back() {
        if (root.page == PageId.feedback-lab) {
            let focus = Lab.back();
            if (focus < 0) {
                root.go(PageId.menu, 6);
            } else {
                root.focus-index = focus;
            }
        } else if (root.page == PageId.integrations) {
            Cfg.back();
        } else if (root.page == PageId.keyboard && Kb.purpose == KbPurpose.text) {
            root.go(PageId.integrations, Cfg.focus);
        } else if (root.page == PageId.display) {
            root.go(PageId.menu, 2);
        } else if (root.page == PageId.power) {
            root.go(PageId.menu, 4);
        } else if (root.page == PageId.wifi) {
            root.go(PageId.menu, 0);
        } else if (root.page == PageId.status) {
            root.go(PageId.menu, 5);
        } else if (root.page == PageId.tracks) {
            root.go(PageId.home, 0);
        } else if (root.page == PageId.keyboard || root.page == PageId.join-failed) {
            Wifi.join-state = JoinState.idle;
            root.go(PageId.wifi, 0);
        } else {
            root.go(PageId.home, 0);
        }
    }
    function row-count() -> int {
        root.page == PageId.inputs ? Control.inputs.length : root.page == PageId.integrations ? Cfg.rows.length : root.page == PageId.menu ? 7 : root.page == PageId.display ? 3 : root.page == PageId.power ? 4 : root.page == PageId.wifi ? Wifi.rows.length + (Wifi.band-known ? 2 : 1) : root.page == PageId.join-failed ? 2 : root.page == PageId.tracks ? Tracks.rows.length : root.page == PageId.feedback-lab ? Lab.rows.length : 1
    }
    public function move(d: int) {
        root.focus-index = max(0, min(root.row-count() - 1, root.focus-index + d));
    }
    public function activate(i: int) {
        root.focus-index = i;
        // A pick that opens another page already gets the page's haptic.
        if (root.page != PageId.feedback-lab && root.page != PageId.inputs && root.page != PageId.menu && root.page != PageId.tracks && root.page != PageId.integrations) {
            Fx.haptic(Haptic.select);
        }
        if (root.page == PageId.integrations) {
            Fx.haptic(Haptic.select);
            Cfg.pick(i);
        } else if (root.page == PageId.feedback-lab) {
            if (Lab.pick(i)) {
                Fx.haptic(Haptic.select);
                root.focus-index = 0;
            }
        } else if (root.page == PageId.inputs) {
            Control.select-input(Control.inputs[i].id);
            root.go(PageId.home, 0);
        } else if (root.page == PageId.menu) {
            if (i == 0) {
                Wifi.scan();
                root.go(PageId.wifi, 0);
            } else if (i == 1) {
                Cfg.open();
                root.go(PageId.integrations, 0);
            } else if (i == 2) {
                root.go(PageId.display, 0);
            } else if (i == 4) {
                root.go(PageId.power, 0);
            } else if (i == 5) {
                root.go(PageId.status, 0);
            } else if (i == 6) {
                root.go(PageId.feedback-lab, 0);
            }
        } else if (root.page == PageId.display) {
            if (i == 1) {
                Prefs.auto-brightness = !Prefs.auto-brightness;
                Prefs.changed();
            }
        } else if (root.page == PageId.wifi) {
            if (i == Wifi.rows.length + 1) {
                Wifi.band();
            } else if (i >= Wifi.rows.length) {
                Wifi.scan();
            } else if (!Wifi.rows[i].connected) {
                Wifi.target = Wifi.rows[i];
                if (Wifi.rows[i].secured) {
                    Kb.purpose = KbPurpose.wifi-password;
                    Kb.reset();
                    root.go(PageId.keyboard, 0);
                } else {
                    Wifi.join-state = JoinState.joining;
                    root.go(PageId.keyboard, 0);
                    Wifi.join(Wifi.target.ssid, Wifi.target.ssid-hex, "");
                }
            }
        } else if (root.page == PageId.tracks) {
            if (i < Tracks.rows.length) {
                Tracks.pick(Tracks.picker, i);
            }
            root.go(PageId.home, 0);
        } else if (root.page == PageId.join-failed) {
            Wifi.join-state = JoinState.idle;
            root.go(i == 0 ? PageId.keyboard : PageId.wifi, 0);
        } else if (root.page == PageId.power) {
            if (i == 0) {
                Control.power-action(PowerAction.standby);
            } else if (i == 1) {
                Control.power-action(PowerAction.restart);
            } else if (i == 2) {
                Control.power-action(PowerAction.power-off);
            }
        }
    }

    property <float> wake: Sys.lit ? 1 : 0;
    animate wake { duration: 650ms; easing: ease-in-out; }
    // Smoothed again so the fade and zoom ease at both ends.
    property <float> reveal: root.wake * root.wake * (3 - 2 * root.wake);

    keys := FocusScope {
        transform-scale: 0.8 + 0.2 * root.reveal;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        opacity: root.reveal;
        key-pressed(event) => {
            Sys.activity();
            if (Sys.resting || Sys.charge-card) {
                Sys.resting = false;
                Sys.charge-card = false;
                return accept;
            }
            if (event.text.to-lowercase() == KeyChars.power) {
                if (!event.repeat && !root.power-latched) {
                    root.power-turning-off = Control.power-on;
                    root.power-completed = false;
                    Fx.capture(Capture.world);
                    root.hold-look = HoldKind.power;
                    root.power-hold-start = animation-tick();
                    root.power-holding = true;
                    Fx.haptic(Haptic.power-hold);
                }
                return accept;
            }
            if (event.text.to-lowercase() == KeyChars.home) {
                if (!event.repeat) {
                    root.home-down = true;
                    root.home-used = false;
                    root.home-rumbling = false;
                }
                return accept;
            }
            // The voice key is the input switcher, from anywhere.
            if (event.text.to-lowercase() == KeyChars.input) {
                if (!event.repeat && root.page != PageId.keyboard) {
                    root.go(root.page == PageId.inputs ? PageId.home : PageId.inputs, Control.input-index);
                }
                return accept;
            }
            if (root.page == PageId.keyboard) {
                if (Wifi.join-state != JoinState.joining) {
                    if (event.text == Key.UpArrow) {
                        Kb.nav(NavKey.up);
                    } else if (event.text == Key.DownArrow) {
                        Kb.nav(NavKey.down);
                    } else if (event.text == Key.LeftArrow) {
                        Kb.nav(NavKey.left);
                    } else if (event.text == Key.RightArrow) {
                        Kb.nav(NavKey.right);
                    } else if (event.text == Key.Return) {
                        Kb.nav(NavKey.ok);
                    } else if (event.text == Key.Backspace || event.text == Key.Escape) {
                        Kb.nav(NavKey.back);
                    }
                }
                return accept;
            }
            if (root.page != PageId.home) {
                if (event.text == Key.Escape || event.text == Key.Backspace) {
                    root.back();
                    return accept;
                }
                if (event.text == Key.UpArrow) {
                    root.move(-1);
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    root.move(1);
                    return accept;
                }
                if (event.text == Key.Return) {
                    root.activate(root.focus-index);
                    return accept;
                }
                if (event.text == Key.LeftArrow || event.text == Key.RightArrow) {
                    if (root.page == PageId.display && root.focus-index == 0) {
                        if (!Prefs.auto-brightness) {
                            Prefs.brightness = max(5, min(100, Prefs.brightness + (event.text == Key.LeftArrow ? -5 : 5)));
                            Prefs.changed();
                        }
                    } else if (event.text == Key.LeftArrow) {
                        root.back();
                    }
                    return accept;
                }
            }
            if (!event.repeat && event.text == Key.Return) {
                Fx.haptic(Haptic.select);
            }
            Control.key(event.text);
            return accept;
        }

        key-released(event) => {
            if ((event.text.to-lowercase() == KeyChars.home) && root.home-down) {
                root.home-down = false;
                if (!root.home-used) {
                    if (root.home-rumbling) {
                        Fx.haptic(Haptic.hold-cancel);
                    }
                    // A tap: back to the home screen from anywhere else, or the input's own home.
                    if (root.page != PageId.home) {
                        root.go(PageId.home, 0);
                    } else {
                        Control.key(KeyChars.home);
                    }
                }
            }
            if ((event.text.to-lowercase() == KeyChars.power) && root.power-holding) {
                root.power-holding = false;
                Fx.haptic(Haptic.hold-cancel);
            }
            return accept;
        }
        Timer {
            interval: 1200ms;
            running: root.power-holding;
            triggered => {
                root.power-holding = false;
                root.power-latched = true;
                root.power-completed = true;
                Control.power-held();
                Fx.haptic(Haptic.power-complete);
            }
        }
        // Taps are common, so the rumble waits a moment before starting.
        Timer {
            interval: 160ms;
            running: root.home-down && !root.home-used && !root.home-rumbling;
            triggered => {
                Fx.capture(Capture.world);
                root.hold-look = HoldKind.home;
                root.home-hold-start = animation-tick();
                root.home-rumbling = true;
                Fx.haptic(Haptic.home-hold);
            }
        }
        Timer {
            interval: 650ms;
            running: root.home-down && !root.home-used;
            triggered => {
                root.home-used = true;
                Fx.haptic(Haptic.home-complete);
                root.go(PageId.inputs, Control.input-index);
            }
        }
        Timer {
            interval: 660ms;
            running: Fx.swapping && !root.swap-held;
            triggered => { Fx.swapping = false; }
        }
        Timer {
            interval: 550ms;
            running: root.page == PageId.keyboard;
            triggered => { root.caret-on = !root.caret-on; }
        }
        Timer {
            interval: 900ms;
            running: root.power-latched;
            triggered => { root.power-latched = false; }
        }

        // Catches touches that land on nothing, so the pointer stays hidden there too.
        TouchArea {
            mouse-cursor: Theme.cursor;
        }

        // Three layers. The main stage (home, now playing) is at the bottom; option lists (menu,
        // inputs, track pickers) open over it, and the stage recedes: it shrinks, blurs and dims
        // until it is only faintly there behind the list. Overlays (volume, power, charging) do
        // the same to whatever lies beneath them. Blur is a snapshot taken as the layer opens,
        // since Slint cannot blur live content.
        world := Rectangle {
            transform-origin: { x: self.width / 2, y: self.height / 2 };
            transform-scale: Fx.capturing != Capture.none ? 1 : 1 - 0.05 * root.under;

            stage := Rectangle {
                transform-origin: { x: self.width / 2, y: self.height / 2 };
                transform-scale: Fx.capturing == Capture.stage ? 1 : (1 - 0.08 * root.recede) * (Fx.swapping && !Fx.swap-plain ? 0.97 + 0.03 * root.swap : 1);
                opacity: Fx.capturing == Capture.stage ? 1 : 1 - 0.55 * root.recede;

                    // The input's UI slot, playing
                    Rectangle {
                        opacity: root.home-view == HomeView.playing ? 1 : 0;
                        visible: self.opacity > 0;

                        // The backdrop arrives already blurred and darkened; the scrim fades it into black
                        // where the controls sit.
                        Image {
                            width: 480px;
                            height: 800px;
                            source: Playback.backdrop;
                            image-fit: cover;
                            opacity: 0.55;
                        }
                        Image {
                            width: 480px;
                            height: 800px;
                            source: Fx.grain;
                            image-fit: fill;
                            image-rendering: pixelated;
                            opacity: Playback.backdrop.width > 0 ? 1 : 0;
                        }
                        Rectangle {
                            background: @linear-gradient(180deg, #00000066 0%, #00000022 26%, #000000B0 52%, #000000 74%);
                        }

                        Rectangle {
                            x: 144px;
                            y: 84px;
                            width: 192px;
                            height: 288px;
                            border-radius: 0;
                            drop-shadow-blur: 28px;
                            drop-shadow-color: #000000CC;
                            drop-shadow-offset-y: 10px;
                            background: #111;
                            Rectangle {
                                border-radius: 0;
                                clip: true;
                                if Playback.poster.width == 0: PosterStandIn {
                                    title: Playback.title;
                                }
                                if Playback.poster.width > 0: Image {
                                    source: Playback.poster;
                                    width: 100%;
                                    height: 100%;
                                    image-fit: cover;
                                }
                            }
                        }
                        Text {
                            y: 392px;
                            x: 24px;
                            width: 432px;
                            height: 36px;
                            horizontal-alignment: center;
                            overflow: elide;
                            text: Playback.title;
                            font-size: 28px;
                            font-weight: 500;
                            color: Theme.text;
                        }
                        Text {
                            y: 430px;
                            width: 480px;
                            horizontal-alignment: center;
                            text: Playback.sub;
                            font-size: 18px;
                            color: Theme.t2;
                        }
                        Bar {
                            x: 40px;
                            y: 470px;
                            value: Playback.progress;
                        }
                        Text {
                            x: 40px;
                            y: 494px;
                            text: Playback.elapsed;
                            font-size: 18px;
                            font-weight: 400;
                            color: Theme.t2;
                        }
                        Text {
                            x: 40px;
                            y: 494px;
                            width: 400px;
                            horizontal-alignment: right;
                            text: Playback.paused ? Playback.time-left + "  ·  paused" : Playback.time-left + "  ·  " + Playback.ends-at;
                            font-size: 18px;
                            color: Theme.t2;
                        }

                        SkipButton {
                            x: 84px;
                            y: 548px;
                            back: true;
                            tapped => { Control.seek(-10); }
                        }
                        Rectangle {
                            x: 198px;
                            y: 542px;
                            width: 84px;
                            height: 84px;
                            border-radius: 42px;
                            background: #FFFFFF;
                            opacity: play-touch.pressed ? 0.7 : 1;
                            // The play mark's geometry already sits it right of centre by its
                            // visual weight, so both marks fill the same centred box.
                            Path {
                                width: 42px;
                                height: 42px;
                                viewbox-width: 24;
                                viewbox-height: 24;
                                commands: Playback.paused ? Marks.play : Marks.pause;
                                fill: #000000;
                            }
                            play-touch := TouchArea {
                                mouse-cursor: Theme.cursor;
                                clicked => { Control.play-pause(); }
                            }
                        }
                        SkipButton {
                            x: 332px;
                            y: 548px;
                            back: false;
                            tapped => { Control.seek(10); }
                        }

                        if Health.warning == "": HorizontalLayout {
                            y: 656px;
                            height: 40px;
                            alignment: center;
                            spacing: 18px;
                            FormatBadge {
                                mark: Playback.format;
                                label: Playback.format-label;
                            }
                            if Playback.format-label != "" || Playback.format.path != "": Text {
                                text: "·";
                                font-size: 22px;
                                color: Theme.t3;
                                vertical-alignment: center;
                            }
                            if Control.has-volume: VolumeChip {
                                volume: Control.volume;
                                muted: Control.muted;
                                size: 22px;
                            }
                        }
                        if Health.warning != "": WarningRow {
                            y: 648px;
                            message: Health.warning;
                            tapped => { root.go(PageId.status, 0); }
                        }
                        TrackButton {
                            x: 32px;
                            y: 716px;
                            icon: Icons.subtitles;
                            label: "Subtitles";
                            tapped => { Tracks.rows = []; Tracks.picker = Picker.subtitles; root.go(PageId.tracks, 0); Tracks.open(Picker.subtitles); }
                        }
                        TrackButton {
                            x: 248px;
                            y: 716px;
                            icon: Icons.audio;
                            label: "Audio";
                            tapped => { Tracks.rows = []; Tracks.picker = Picker.audio; root.go(PageId.tracks, 0); Tracks.open(Picker.audio); }
                        }
                    }

                    // The current input, shown as its mark. An input showing its library looks the same as any other.
                    Rectangle {
                        opacity: root.home-view == HomeView.mark ? 1 : 0;
                        visible: self.opacity > 0;

                        // The colour wash behind the mark, faded out at the top and bottom so the navbar
                        // and the volume line sit on plain black.
                        Image {
                            width: 480px;
                            height: 800px;
                            source: Fx.lava;
                            image-fit: fill;
                            image-rendering: pixelated;
                        }
                        Rectangle {
                            height: 150px;
                            y: 0;
                            background: @linear-gradient(180deg, #000000 0%, #000000 30%, #00000000 100%);
                        }
                        Rectangle {
                            y: 630px;
                            height: 170px;
                            background: @linear-gradient(180deg, #00000000 0%, #000000 55%, #000000 100%);
                        }

                        // While the input is still switching, a faint sheen sweeps across the mark.
                        property <float> sheen: mod(animation-tick() / 1400ms, 1.0) * 1.6 - 0.3;
                        Path {
                            y: 330px;
                            width: 140px;
                            height: 140px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: Control.input-icon;
                            fill: !Control.switching ? Theme.t2-muted : @linear-gradient(110deg,
                                Theme.t2-muted 0%,
                                Theme.t2-muted clamp(parent.sheen - 0.18, 0, 1) * 100%,
                                #9DA3A6 clamp(parent.sheen, 0, 1) * 100%,
                                Theme.t2-muted clamp(parent.sheen + 0.18, 0, 1) * 100%,
                                Theme.t2-muted 100%);
                        }
                        // An input with no mark of its own needs its name to be told apart.
                        if Control.input != "" && Control.input-generic: Text {
                            y: 490px;
                            width: 480px;
                            horizontal-alignment: center;
                            text: Control.input;
                            font-size: 26px;
                            color: Theme.t2;
                        }
                        if Control.inputs.length > 0: TouchArea {
                            mouse-cursor: Theme.cursor;
                            x: 140px;
                            y: 300px;
                            width: 200px;
                            height: 200px;
                            clicked => { root.go(PageId.inputs, Control.input-index); }
                        }
                        if Health.warning != "": WarningRow {
                            y: 540px;
                            message: Health.warning;
                            tapped => { root.go(PageId.status, 0); }
                        }
                        if Control.has-volume: VolumeChip {
                            y: 700px;
                            height: 40px;
                            size: 32px;
                            volume: Control.volume;
                            muted: Control.muted;
                        }
                    }

                    // Power off
                    Rectangle {
                        opacity: root.home-view == HomeView.off ? 1 : 0;
                        visible: self.opacity > 0;

                        Glyph {
                            y: 340px;
                            size: 72px;
                            commands: Icons.power;
                            tint: Theme.t3;
                        }
                        Text {
                            y: 436px;
                            width: 480px;
                            horizontal-alignment: center;
                            text: "Off";
                            font-size: 26px;
                            color: Theme.t2;
                        }
                    }

                    // The input's library wall, mirrored; also the previews' library variations.
                    lib := Library {
                        mode: Lib.mode;
                        heading: Lib.heading;
                        count: Lib.count;
                        posters: Lib.posters;
                        items: Lib.items;
                        at: Lib.focus;
                        wall-style: Lib.wall-style;
                        opacity: root.home-view == HomeView.wall ? 1 : 0;
                        visible: self.opacity > 0 && Lib.mode != LibMode.off;
                    }

                    if !Sys.connected: Text {
                        y: 772px;
                        width: 480px;
                        horizontal-alignment: center;
                        text: Sys.status;
                        font-size: 14px;
                        color: Theme.t3;
                        overflow: elide;
                    }

                // One stage giving way to another: the old one, sharp then blurred, dissolves into
                // the new one blurred, which sharpens into the live stage beneath.
                Rectangle {
                    visible: Fx.swapping && Fx.capturing == Capture.none;
                    Image {
                        width: 480px;
                        height: 800px;
                        source: Fx.swap-in-blur;
                        image-fit: fill;
                        opacity: 1 - clamp((root.swap - 0.55) / 0.45, 0, 1);
                    }
                    Image {
                        width: 480px;
                        height: 800px;
                        transform-origin: { x: self.width / 2, y: self.height / 2 };
                        transform-scale: Fx.swap-plain ? 1 : 1 + 0.05 * root.swap;
                        source: Fx.swap-out-blur;
                        image-fit: fill;
                        opacity: 1 - clamp((root.swap - 0.25) / 0.35, 0, 1);
                    }
                    Image {
                        width: 480px;
                        height: 800px;
                        transform-origin: { x: self.width / 2, y: self.height / 2 };
                        transform-scale: Fx.swap-plain ? 1 : 1 + 0.05 * root.swap;
                        source: Fx.swap-out;
                        image-fit: fill;
                        opacity: 1 - clamp(root.swap / 0.3, 0, 1);
                    }
                }

                Image {
                    width: 480px;
                    height: 800px;
                    source: Fx.stage-blur;
                    image-fit: fill;
                    opacity: root.recede;
                    visible: self.opacity > 0 && Fx.capturing != Capture.stage;
                }
            }

            options := Rectangle {
                visible: root.recede > 0 && Fx.capturing != Capture.stage;
                opacity: root.recede;
                transform-origin: { x: self.width / 2, y: self.height / 2 };
                transform-scale: 1.04 - 0.04 * root.recede;
                background: #000000B8;
                // The stage behind is only scenery while a list is open.
                TouchArea { mouse-cursor: Theme.cursor; }

            // Inputs
            Layer {
                depth: 1;
                current-depth: root.depth;
                active: root.page == PageId.inputs;
                ChoiceList {
                    title: "Inputs";
                    show-title: false;
                    rows: Control.input-choices;
                    focused-row: root.focus-index;
                    pick(i) => { root.activate(i); }
                    back => { root.back(); }
                }
            }

            // Menu
            Layer {
                depth: 1;
                current-depth: root.depth;
                active: root.page == PageId.menu;

                ChoiceList {
                    title: "Menu";
                    rows: [
                        { label: "Wi-Fi", value: Wifi.name, chevron: true },
                        { label: "Integrations", chevron: true },
                        { label: "Display", value: Prefs.auto-brightness ? "Auto" : Prefs.brightness + "%", chevron: true },
                        { label: "Sound & haptics", value: Prefs.haptics, chevron: true },
                        { label: "Power", chevron: true },
                        { label: "Status", chevron: true },
                        { label: "Feedback lab", chevron: true },
                    ];
                    focused-row: root.focus-index;
                    pick(i) => { root.activate(i); }
                    back => { root.back(); }
                }
            }

            // Menu / Display
            Layer {
                depth: 2;
                current-depth: root.depth;
                active: root.page == PageId.display;

                PageHeader {
                    title: "Display";
                    back => { root.back(); }
                }
                Rectangle {
                    x: 0;
                    y: 168px;
                    width: 4px;
                    height: 40px;
                    border-radius: 2px;
                    background: Theme.accent;
                    opacity: root.focus-index == 0 ? 1 : 0;
                    animate opacity { duration: 140ms; }
                }
                Text {
                    x: 40px;
                    y: 172px;
                    text: "Brightness";
                    font-size: 26px;
                    font-weight: root.focus-index == 0 ? 500 : 400;
                    color: Prefs.auto-brightness ? Theme.t3 : root.focus-index == 0 ? Theme.text : Theme.text-dim;
                }
                Text {
                    x: 40px;
                    y: 176px;
                    width: 400px;
                    horizontal-alignment: right;
                    text: Prefs.auto-brightness ? "Automatic" : Prefs.brightness + "%";
                    font-size: 22px;
                    font-weight: 300;
                    color: Theme.t2;
                }
                // Locked while auto brightness is on: the remote sets the level itself then.
                Bar {
                    x: 40px;
                    y: 250px;
                    value: Prefs.brightness / 100;
                    handle: !Prefs.auto-brightness;
                    tint: Prefs.auto-brightness ? Theme.t3 : Theme.accent;
                    opacity: Prefs.auto-brightness ? 0.5 : 1;
                    animate opacity { duration: 160ms; }
                }
                TouchArea {
                    mouse-cursor: Theme.cursor;
                    x: 24px;
                    y: 220px;
                    width: 432px;
                    height: 74px;
                    enabled: !Prefs.auto-brightness;
                    function set() {
                        root.focus-index = 0;
                        Prefs.brightness = max(5, min(100, round((self.mouse-x - 16px) / 400px * 100)));
                        Prefs.changed();
                    }
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            self.set();
                        }
                    }
                    moved => {
                        if (self.pressed) {
                            self.set();
                        }
                    }
                }
                ListRow {
                    y: 328px;
                    height: 104px;
                    label: "Auto brightness";
                    focused: root.focus-index == 1;
                    tapped => { root.activate(1); }
                    Rectangle {
                        x: 384px;
                        width: 56px;
                        height: 32px;
                        border-radius: 16px;
                        background: Prefs.auto-brightness ? Theme.text : Theme.track;
                        animate background { duration: 160ms; }
                        Rectangle {
                            x: Prefs.auto-brightness ? 28px : 4px;
                            width: 24px;
                            height: 24px;
                            border-radius: 12px;
                            background: Prefs.auto-brightness ? Theme.bg : Theme.t2;
                            animate x { duration: 160ms; easing: ease-out; }
                        }
                    }
                }
                ListRow {
                    y: 432px;
                    height: 104px;
                    label: "Screen off after";
                    value: Prefs.screen-off-after;
                    chevron: true;
                    focused: root.focus-index == 2;
                    tapped => { root.activate(2); }
                }
            }

            // Menu / Power
            Layer {
                depth: 2;
                current-depth: root.depth;
                active: root.page == PageId.power;
                ChoiceList {
                    title: "Power";
                    rows: [
                        { label: "Standby" },
                        { label: "Restart" },
                        { label: "Power off" },
                        { label: "Sleep after", value: Prefs.sleep-after, chevron: true },
                    ];
                    focused-row: root.focus-index;
                    pick(i) => { root.activate(i); }
                    back => { root.back(); }
                }
            }

            // Menu / Wi-Fi
            Layer {
                depth: 2;
                current-depth: root.depth;
                active: root.page == PageId.wifi;
                ChoiceList {
                    title: "Wi-Fi";
                    rows: Wifi.choices;
                    focused-row: root.focus-index;
                    pick(i) => { root.activate(i); }
                    back => { root.back(); }
                }
            }

            // Menu / Wi-Fi / password
            Layer {
                depth: 3;
                current-depth: root.depth;
                active: root.page == PageId.keyboard;

                PageHeader {
                    y: 0;
                    title: Kb.purpose == KbPurpose.text ? Kb.title : Wifi.target.ssid;
                    back => { root.back(); }
                }
                Text {
                    x: 40px;
                    y: 128px;
                    text: Kb.purpose == KbPurpose.text ? Kb.caption : "PASSWORD";
                    font-size: 13px;
                    font-weight: 500;
                    letter-spacing: 1.8px;
                    color: Theme.t2;
                }
                Rectangle {
                    x: 40px;
                    y: 158px;
                    width: 400px;
                    height: 84px;
                    clip: true;
                    HorizontalLayout {
                        alignment: end;
                        spacing: 3px;
                        Text {
                            text: Kb.text;
                            font-size: 40px;
                            font-weight: 300;
                            letter-spacing: 0.8px;
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 3px;
                                height: 40px;
                                border-radius: 2px;
                                background: Theme.accent;
                                opacity: root.caret-on && Wifi.join-state != JoinState.joining ? 1 : 0;
                            }
                        }
                    }
                }
                Rectangle {
                    x: 40px;
                    y: 242px;
                    width: 400px;
                    height: 1px;
                    background: Theme.hair;
                }

                if Wifi.join-state != JoinState.joining: Rectangle {
                    for key[i] in Kb.keys: Rectangle {
                        x: key.x;
                        y: key.y;
                        width: key.w;
                        height: key.h;
                        border-radius: key.style == KeyStyle.char ? 12px : 16px;
                        background: key.focused ? Theme.accent : key.style == KeyStyle.action-on ? #2A2A2C : key.style == KeyStyle.char ? #121213 : #161617;
                        opacity: key.focused && key.style == KeyStyle.join-dim ? 0.45 : 1;
                        transform-scale: key.focused ? (key.style == KeyStyle.char ? 1.12 : 1.06) : 1;
                        animate transform-scale, background { duration: 80ms; }
                        if key.glyph == KeyGlyph.none: Text {
                            text: key.label;
                            font-size: key.style == KeyStyle.char ? 26px : 20px;
                            font-weight: key.focused || key.style == KeyStyle.join-ready ? 600 : key.style == KeyStyle.char ? 400 : 500;
                            color: key.focused ? #000000 : key.style == KeyStyle.join-dim ? Theme.t3 : key.style == KeyStyle.join-ready ? Theme.accent : Theme.text;
                        }
                        if key.glyph != KeyGlyph.none: Glyph {
                            commands: key.glyph == KeyGlyph.shift ? Icons.shift : Icons.delete;
                            tint: key.focused ? #000000 : Theme.text;
                        }
                        TouchArea {
                            mouse-cursor: Theme.cursor;
                            clicked => { Kb.tap(i); }
                        }
                    }
                }
                if Wifi.join-state == JoinState.joining: Rectangle {
                    Text {
                        y: 440px;
                        width: 480px;
                        horizontal-alignment: center;
                        text: "Joining…";
                        font-size: 32px;
                        font-weight: 300;
                        color: Theme.text;
                    }
                    Rectangle {
                        x: 120px;
                        y: 524px;
                        width: 240px;
                        height: 14px;
                        border-radius: 7px;
                        background: Theme.track;
                        clip: true;
                        Rectangle {
                            x: 75px + 75px * sin(animation-tick() / 1ms * 0.33deg);
                            width: 90px;
                            border-radius: 7px;
                            background: Theme.accent;
                        }
                    }
                }
            }

            // Menu / Status
            Layer {
                depth: 2;
                current-depth: root.depth;
                active: root.page == PageId.status;
                ChoiceList {
                    title: "Status";
                    rows: Health.choices;
                    back => { root.back(); }
                }
            }

            // Menu / Integrations, every screen of it
            Layer {
                depth: 2;
                current-depth: root.depth;
                active: root.page == PageId.integrations;
                ChoiceList {
                    title: Cfg.title;
                    rows: Cfg.rows;
                    focused-row: root.focus-index;
                    pick(i) => { root.activate(i); }
                    back => { root.back(); }
                }
            }

            // Menu / Feedback lab
            Layer {
                depth: 2;
                current-depth: root.depth;
                active: root.page == PageId.feedback-lab;
                ChoiceList {
                    title: Lab.title;
                    rows: Lab.rows;
                    focused-row: root.focus-index;
                    pick(i) => { root.activate(i); }
                    back => { root.back(); }
                }
            }

            // Menu / Wi-Fi / join failed
            Layer {
                depth: 4;
                current-depth: root.depth;
                active: root.page == PageId.join-failed;

                PageHeader {
                    y: 0;
                    title: Wifi.target.ssid;
                    back => { root.back(); }
                }
                Text {
                    y: 300px;
                    width: 480px;
                    horizontal-alignment: center;
                    text: "Couldn’t join";
                    font-size: 44px;
                    font-weight: 300;
                    color: Theme.text;
                }
                Text {
                    y: 376px;
                    width: 480px;
                    horizontal-alignment: center;
                    text: "Check the password and try again.";
                    font-size: 22px;
                    color: Theme.t2;
                }
                Pill {
                    y: 500px;
                    label: "Try again";
                    focused: root.focus-index == 0;
                    tapped => { root.activate(0); }
                }
                Pill {
                    y: 580px;
                    label: Wifi.name == "" ? "Cancel" : "Stay on " + Wifi.name;
                    focused: root.focus-index == 1;
                    tapped => { root.activate(1); }
                }
            }

            // Audio or subtitle tracks
            Layer {
                depth: 1;
                current-depth: root.depth;
                active: root.page == PageId.tracks;
                ChoiceList {
                    title: Tracks.picker == Picker.audio ? "Audio" : "Subtitles";
                    rows: Tracks.rows;
                    empty: "Loading…";
                    focused-row: root.focus-index;
                    pick(i) => { root.activate(i); }
                    back => { root.back(); }
                }
            }
            }

            Image {
                width: 480px;
                height: 800px;
                source: Fx.world-blur;
                image-fit: fill;
                opacity: root.under;
                visible: self.opacity > 0 && Fx.capturing == Capture.none;
            }
        }

        // Volume overlay, over everything.
        Rectangle {
            property <bool> shown: Control.volume-overlay && Control.power-on;
            background: #000000A6;
            opacity: self.shown ? 1 : 0;
            visible: self.opacity > 0 && Fx.capturing == Capture.none;
            animate opacity { duration: 180ms; easing: ease-out; }

            Glyph {
                y: 198px;
                size: 52px;
                commands: Icons.muted;
                opacity: Control.muted ? 1 : 0;
                animate opacity { duration: 160ms; }
            }
            VolumeReadout {
                y: 0;
                height: 800px;
                top: 270px;
                volume: Control.volume;
                volume-db: Control.volume-db;
                muted: Control.muted;
            }
        }
    }

    // Holding power or Home: one overlay. A ring fills around a mark placed exactly where the home
    // screen's mark sits. Progress runs from the clock, so every hold starts from an empty ring.
    property <bool> home-holding: root.home-down && root.home-rumbling && !root.home-used;
    property <duration> home-hold-start;
    property <duration> power-hold-start;
    // Which hold the overlay shows. Kept through the fade-out so the overlay does not change look
    // while it disappears.
    property <HoldKind> hold-look: HoldKind.home;
    property <bool> hold-shown: root.power-overlay || root.home-holding;
    property <float> hold-linear: root.power-latched ? 1
        : root.power-holding ? clamp((animation-tick() - root.power-hold-start) / 1200ms, 0, 1)
        : root.home-holding ? clamp((animation-tick() - root.home-hold-start) / 490ms, 0, 1)
        : 0;
    property <float> hold-progress: root.hold-linear * root.hold-linear * (3 - 2 * root.hold-linear);
    property <float> ring: min(root.hold-progress, 0.9999);
    property <color> ring-tint: root.hold-look == HoldKind.power ? root.power-tint : Theme.accent;
    Rectangle {
        background: #000000A6;
        opacity: root.hold-shown ? 1 : 0;
        visible: self.opacity > 0 && Fx.capturing == Capture.none;
        animate opacity { duration: 160ms; easing: ease-out; }
        Path {
            x: 120px;
            y: 280px;
            width: 240px;
            height: 240px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M12 1.5A10.5 10.5 0 1 1 11.999 1.5";
            fill: transparent;
            stroke: Theme.track;
            stroke-width: 10px;
        }
        Path {
            x: 120px;
            y: 280px;
            width: 240px;
            height: 240px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M12 1.5A10.5 10.5 0 " + (root.ring > 0.5 ? "1" : "0") + " 1 " + (12 + 10.5 * sin(root.ring * 360deg)) + " " + (12 - 10.5 * cos(root.ring * 360deg));
            fill: transparent;
            stroke: root.ring-tint;
            stroke-width: 10px;
            stroke-line-cap: round;
            opacity: root.hold-progress > 0.001 ? 1 : 0;
        }
        if root.hold-look == HoldKind.home: Logo {
            y: 330px;
            size: 140px;
            commands: Control.input-icon;
            tint: Theme.text;
        }
        if root.hold-look == HoldKind.power: Glyph {
            y: 345px;
            size: 110px;
            commands: Icons.power;
            tint: root.power-completed ? root.power-tint : Theme.text;
        }
        Text {
            y: 548px;
            width: 480px;
            horizontal-alignment: center;
            text: root.hold-look == HoldKind.home ? "Inputs"
                : root.power-completed ? (root.power-turning-off ? "Off" : "On")
                : (root.power-turning-off ? "Hold to turn off" : "Hold to turn on");
            font-size: 26px;
            font-weight: 300;
            color: root.hold-look == HoldKind.power && root.power-completed ? Theme.text : Theme.t2;
        }
    }

    // Charging: the battery, full screen, until the first touch or key.
    Rectangle {
        background: #000000C0;
        opacity: Sys.charge-card && Sys.lit ? 1 : 0;
        visible: self.opacity > 0 && Fx.capturing == Capture.none;
        animate opacity { duration: 300ms; easing: ease-in-out; }
        Rectangle {
            x: 122px;
            y: 300px;
            width: 220px;
            height: 104px;
            border-radius: 26px;
            border-width: 5px;
            border-color: #FFFFFF59;
            Rectangle {
                x: 11px;
                y: 11px;
                width: (parent.width - 22px) * clamp(Sys.battery, 4, 100) / 100;
                height: parent.height - 22px;
                border-radius: 16px;
                background: Theme.good;
            }
            Path {
                width: 64px;
                height: 84px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: Marks.bolt;
                fill: Theme.text;
                stroke: Theme.bg;
                stroke-width: 4px;
            }
        }
        Rectangle {
            x: 346px;
            y: 334px;
            width: 12px;
            height: 36px;
            border-radius: 6px;
            background: #FFFFFF59;
        }
        Text {
            y: 436px;
            width: 480px;
            horizontal-alignment: center;
            text: Sys.battery + "%";
            font-size: 64px;
            font-weight: 200;
            color: Theme.text;
        }
        Text {
            y: 520px;
            width: 480px;
            horizontal-alignment: center;
            text: Sys.battery >= 100 ? "Charged" : "Charging";
            font-size: 22px;
            color: Theme.t2;
        }
        TouchArea {
            mouse-cursor: Theme.cursor;
            clicked => {
                Sys.charge-card = false;
                Sys.activity();
            }
        }
    }

    // The navbar belongs to no layer: it stays put through every transition, fading only with
    // sleep, and is kept out of the snapshots so no blurred copy of it shows behind it.
    navbar := Rectangle {
        y: 0;
        height: 64px;
        opacity: root.reveal * (root.page == PageId.keyboard || root.page == PageId.join-failed ? 0 : 1);
        visible: self.opacity > 0 && Fx.capturing == Capture.none;
        animate opacity { duration: Theme.page-time; }
        StatusBar {
            clock: Sys.clock;
            battery: Sys.battery;
            charging: Sys.charging;
            show-menu: root.page == PageId.home || root.page == PageId.inputs;
            menu => { root.go(PageId.menu, 0); }
        }
        // The input's mark sits in the middle everywhere but the input's own screen (or the power-off one), so
        // away from it you can always tell where you are; tapping it opens the list.
        TouchArea {
            property <bool> shown: Control.inputs.length > 0 && !(root.page == PageId.home && (root.home-view == HomeView.mark || root.home-view == HomeView.off));
            mouse-cursor: Theme.cursor;
            x: 190px;
            width: 100px;
            height: 64px;
            enabled: self.shown && root.page != PageId.inputs;
            clicked => { root.go(PageId.inputs, Control.input-index); }
            Logo {
                size: 32px;
                commands: Control.input-icon;
                tint: Theme.t2;
                opacity: parent.shown ? 1 : 0;
                animate opacity { duration: 620ms; easing: ease-in-out; }
            }
        }
    }

    if !Sys.awake: TouchArea { mouse-cursor: Theme.cursor; }
    // The first touch after resting only wakes the screen.
    if Sys.awake && Sys.resting: TouchArea {
        mouse-cursor: Theme.cursor;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                Sys.resting = false;
                Sys.activity();
            }
        }
    }
}
