import "fonts/HankenGrotesk-200.ttf";
import "fonts/HankenGrotesk-300.ttf";
import "fonts/HankenGrotesk-400.ttf";
import "fonts/HankenGrotesk-500.ttf";
import { Theme, Icons, Marks, Glyph, Logo, Bar, StatusBar, ListRow, PageHeader, Page } from "theme.slint";
import { Logos } from "logos.slint";
import { Codecs } from "codecs.slint";

export { Theme, Logos, Icons, Marks, Codecs }

export struct SourceRow {
    name: string,
    icon: string,
}

export struct TrackRow {
    label: string,
    detail: string,
    current: bool,
}

export struct WifiRow {
    ssid: string,
    ssid-hex: string,
    secured: bool,
    // 1 to 4
    bars: int,
    connected: bool,
}

export struct StatusRow {
    label: string,
    value: string,
    // 0 working, 1 broken, 2 unknown because something it depends on is broken
    level: int,
}

export struct KeyCell {
    label: string,
    icon: string,
    x: length,
    y: length,
    w: length,
    h: length,
    focused: bool,
    // 0 character, 1 action, 2 action armed, 3 join (not ready), 4 join (ready)
    style: int,
}

component Dot inherits Rectangle {
    in property <int> level;
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background: root.level == 0 ? Theme.good : root.level == 1 ? Theme.off : Theme.t3;
}

// Why the screen cannot do its job, shown on the home screen itself.
component WarningRow inherits Rectangle {
    in property <string> message;
    callback tapped();
    x: 0;
    width: 480px;
    height: 56px;
    HorizontalLayout {
        alignment: center;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            Dot { level: 1; }
        }
        Text {
            text: root.message;
            font-size: 22px;
            color: Theme.text;
            vertical-alignment: center;
        }
    }
    TouchArea {
        mouse-cursor: Theme.cursor;
        clicked => { root.tapped(); }
    }
}

component Pill inherits Rectangle {
    in property <string> label;
    in property <bool> focused;
    callback tapped();
    x: 40px;
    width: 400px;
    height: 64px;
    border-radius: 32px;
    background: #131314;
    border-width: root.focused ? 4px : 0px;
    border-color: Theme.accent;
    Text {
        text: root.label;
        font-size: 22px;
        color: root.focused ? Theme.text : Theme.t2;
    }
    TouchArea {
        mouse-cursor: Theme.cursor;
        clicked => { root.tapped(); }
    }
}

// A codec's logo and the rest of its name. The logo is drawn from the part of its viewbox that
// `logo-top`, `logo-width` and `logo-height` mark out, `size` tall.
component FormatBadge inherits HorizontalLayout {
    in property <string> logo;
    in property <float> logo-width: 24;
    in property <float> logo-top: 0;
    in property <float> logo-height: 24;
    in property <string> label;
    in property <length> size: 30px;
    in property <bool> on-baseline;
    alignment: center;
    spacing: 12px;
    height: 40px;
    if root.logo != "": Rectangle {
        width: root.size * root.logo-width / root.logo-height;
        Path {
            // A wordmark sits on the label's baseline (27px down the 40px row, measured for
            // 22px Hanken Grotesk); a mark is centred.
            y: root.on-baseline ? 27px - root.size : (40px - root.size) / 2;
            width: parent.width;
            height: root.size;
            viewbox-y: root.logo-top;
            viewbox-width: root.logo-width;
            viewbox-height: root.logo-height;
            commands: root.logo;
            fill: Theme.text;
        }
    }
    Text {
        text: root.label;
        font-size: 22px;
        color: Theme.t2;
        vertical-alignment: center;
    }
}

component VolumeChip inherits HorizontalLayout {
    in property <int> volume;
    in property <bool> muted;
    in property <length> size: 24px;
    alignment: center;
    spacing: 10px;
    VerticalLayout {
        alignment: center;
        Glyph {
            size: root.size * 0.9;
            commands: root.muted ? Icons.muted : Icons.speaker;
        }
    }
    Text {
        text: root.volume;
        font-size: root.size;
        font-weight: 300;
        color: Theme.t2;
        vertical-alignment: center;
    }
}

component VolumeReadout inherits Rectangle {
    in property <int> volume;
    in property <string> volume-db;
    in property <bool> muted;
    in property <length> top;

    width: 480px;
    Text {
        y: root.top;
        width: 480px;
        height: 190px;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.volume;
        font-size: 200px;
        font-weight: 200;
        letter-spacing: -8px;
        color: root.muted ? Theme.t3 : Theme.text;
        animate color { duration: 200ms; }
    }
    Text {
        y: root.top + 194px;
        width: 480px;
        horizontal-alignment: center;
        text: root.volume-db;
        font-size: 26px;
        font-weight: 300;
        color: root.muted ? Theme.t3 : Theme.t2;
    }
    Bar {
        x: 40px;
        y: root.top + 254px;
        value: root.volume / 100;
        tint: root.muted ? Theme.t3 : Theme.accent;
    }
}

component TrackButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    callback tapped();
    width: 200px;
    height: 60px;
    border-radius: 30px;
    background: touch.pressed ? #FFFFFF26 : #FFFFFF12;
    HorizontalLayout {
        alignment: center;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Glyph { commands: root.icon; tint: Theme.text; }
        }
        Text {
            text: root.label;
            font-size: 22px;
            color: Theme.text;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: Theme.cursor;
        clicked => { root.tapped(); }
    }
}

component SkipButton inherits Rectangle {
    in property <bool> back;
    callback tapped();
    width: 64px;
    height: 64px;
    opacity: touch.pressed ? 0.5 : 1;
    Glyph {
        size: 64px;
        commands: root.back ? Icons.skip-back : Icons.skip-forward;
        tint: Theme.text;
    }
    Text {
        y: 22px;
        text: "10";
        font-size: 17px;
        font-weight: 500;
        color: Theme.text;
    }
    touch := TouchArea {
        mouse-cursor: Theme.cursor;
        clicked => { root.tapped(); }
    }
}

// Shown until the real poster from Kodi is wired in.
component PosterStandIn inherits Rectangle {
    in property <string> title;
    background: @linear-gradient(180deg, #06252c 0%, #0f4a50 40%, #b8602b 72%, #2a1208 100%);
    Rectangle {
        y: parent.height * 0.26;
        width: parent.width * 0.56;
        height: self.width;
        border-radius: self.width / 2;
        background: @radial-gradient(circle, #ffb26b 0%, #e57b36 50%, #e57b3600 72%);
    }
    Rectangle {
        y: parent.height * 0.62;
        height: parent.height * 0.38;
        background: @linear-gradient(180deg, #05060800 0%, #050608 45%, #050608 100%);
    }
    Text {
        y: parent.height * 0.8;
        width: parent.width - 24px;
        horizontal-alignment: center;
        wrap: word-wrap;
        text: root.title;
        font-size: 13px;
        font-weight: 500;
        letter-spacing: 2.6px;
        color: Theme.text;
    }
}

export component AppWindow inherits Window {
    title: "remote-ui";
    width: 480px;
    height: 800px;
    background: Theme.bg;
    default-font-family: "Hanken Grotesk";
    forward-focus: keys;

    // False while the remote is idle or asleep: the screen closes down to the bar and goes dark.
    in property <bool> awake: true;
    in property <bool> receiver-on: true;
    in property <bool> connected: false;
    in property <string> status: "Connecting…";
    in property <string> clock;
    in property <int> battery: 100;

    in property <int> volume;
    in property <string> volume-db;
    in property <bool> muted;
    in property <bool> volume-overlay;
    in property <string> source;
    in property <string> source-icon;
    in property <[SourceRow]> sources;
    in property <int> source-index;

    // True while the receiver is on the Kodi input: the home page becomes the Kodi remote.
    in property <bool> kodi;
    in property <string> media-title;
    in property <image> poster;
    in property <float> progress;
    in property <string> time-left;
    in property <string> ends-at;
    in property <image> backdrop;
    in property <image> grain;
    in property <string> media-sub;
    in property <bool> paused;
    in property <string> elapsed;
    in property <string> media-format-logo;
    in property <float> media-format-logo-width: 24;
    in property <float> media-format-logo-top: 0;
    in property <float> media-format-logo-height: 24;
    in property <length> media-format-logo-size: 30px;
    in property <bool> media-format-logo-baseline;
    in property <string> media-format-label;
    // The audio or subtitle picker: 0 audio, 1 subtitles.
    in-out property <int> picker;
    in-out property <[TrackRow]> tracks;
    // The menu's animated background.
    in property <image> lava;
    out property <bool> lava-on: root.page == 2 && root.lit;
    in property <bool> charging;
    // On the charger the screen and keys go dark after a short while; any input brings them back.
    in-out property <bool> resting;
    in-out property <bool> charge-card;
    out property <bool> lit: root.awake && !root.resting;

    in property <string> wifi-name;
    in-out property <int> brightness: 90;
    in-out property <bool> auto-brightness: true;
    in property <string> screen-off-after;
    in property <string> haptics;
    in property <string> sleep-after;

    in property <[WifiRow]> wifi-rows;
    in property <bool> wifi-scanning;
    in-out property <WifiRow> wifi-target;
    // 0 idle, 1 joining, 2 failed
    in-out property <int> join-state;
    in property <[StatusRow]> status-rows;
    // Non-empty when something the home screen depends on is unreachable.
    in property <string> home-warning;
    in property <[KeyCell]> kb-keys;
    in property <string> kb-text;

    // 0 home, 1 inputs, 2 menu, 3 display, 4 power, 5 wi-fi, 6 password, 7 status, 8 join failed,
    // 9 audio or subtitle picker
    in-out property <int> page: 0;
    in-out property <int> focus-index: 0;

    // A command id for the Kodi entity.
    callback command(string);
    // Raw key text; mapped to a hard button in Rust (desktop stand-in for evdev).
    callback key(string);
    callback select-source(string);
    callback power-action(string);
    callback wifi-scan();
    // ssid, ssid-hex, password ("" for an open network)
    callback wifi-join(string, string, string);
    callback kb-reset();
    // "up", "down", "left", "right", "ok" or "back"
    callback kb-nav(string);
    callback kb-tap(int);
    // The physical power key, held: switch the receiver on or off. A short press does nothing.
    callback power-held();
    // "hold-start", "hold-cancel" or "complete": cues for the haptic motor.
    callback haptic(string);
    // Seconds to jump, back (negative) or forward.
    callback seek(int);
    callback open-picker(int);
    callback pick-track(int, int);
    // Any key or touch: restarts the charger's countdown to dark.
    callback activity();

    out property <bool> power-overlay: root.power-holding || root.power-latched;
    out property <bool> power-turning-off: true;
    property <bool> power-holding;
    property <bool> power-latched;
    // Stays set through the fade-out so the label does not flip back while disappearing.
    property <bool> power-completed;
    property <float> hold: 0;
    property <color> power-tint: root.power-turning-off ? Theme.off : Theme.on;

    // Lists one step from the stage share a depth, so opening one from the stage is the layer
    // transition alone, without a sideways slide.
    property <int> depth: root.page <= 2 || root.page == 9 ? 1 : root.page == 6 ? 3 : root.page == 8 ? 4 : 2;
    property <float> recede: root.page != 0 ? 1 : 0;
    animate recede { duration: 460ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    property <bool> overlay-open: (root.volume-overlay && root.receiver-on) || root.power-overlay || root.home-holding || (root.charge-card && root.lit);
    property <float> under: root.overlay-open ? 1 : 0;
    animate under { duration: 380ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    in property <image> stage-blur;
    in property <image> world-blur;
    // Ask for a blurred picture of what is on screen now: 0 the stage, 1 everything.
    callback capture(int);
    // A change of main stage in progress; Rust supplies the pictures and starts it.
    in-out property <bool> swapping;
    // Timed from the animation clock: a declared animation on a property nothing reads while
    // hidden jumps straight to its end.
    property <duration> swap-start;
    // The pictures are taken before the clock can move on, so the swap holds the old stage until
    // `run-swap` starts the clock on a fresh tick.
    property <bool> swap-held;
    property <float> swap-linear: !root.swapping || root.swap-held ? 0 : clamp((animation-tick() - root.swap-start) / 620ms, 0, 1);
    property <float> swap: root.swap-linear * root.swap-linear * (3 - 2 * root.swap-linear);
    public function hold-swap() {
        root.swap-held = true;
        root.swapping = true;
    }
    public function run-swap() {
        root.swap-start = animation-tick();
        root.swap-held = false;
    }
    in property <image> swap-out;
    in property <image> swap-out-blur;
    in property <image> swap-in-blur;
    // Set by Rust only while it takes that picture: 1 shows the stage alone, 2 hides the overlays.
    in-out property <int> capturing;
    property <bool> caret-on: true;
    // The home key: a tap is home, a hold opens the input list.
    property <bool> home-down;
    property <bool> home-used;
    property <bool> home-rumbling;
    // 1 Kodi is playing, 2 the input's mark (every input, Kodi included, when idle), 3 receiver off
    property <int> home-view: !root.receiver-on ? 3 : root.kodi && root.media-title != "" ? 1 : 2;

    public function go(p: int, f: int) {
        if (root.page == 0 && p != 0) {
            root.capture(0);
        }
        root.focus-index = f;
        root.page = p;
    }
    public function back() {
        if (root.page == 3) {
            root.go(2, 1);
        } else if (root.page == 4) {
            root.go(2, 3);
        } else if (root.page == 5) {
            root.go(2, 0);
        } else if (root.page == 7) {
            root.go(2, 4);
        } else if (root.page == 9) {
            root.go(0, 0);
        } else if (root.page == 6 || root.page == 8) {
            root.join-state = 0;
            root.go(5, 0);
        } else {
            root.go(0, 0);
        }
    }
    function row-count() -> int {
        root.page == 1 ? root.sources.length : root.page == 2 ? 6 : root.page == 3 ? 3 : root.page == 4 ? 4 : root.page == 5 ? root.wifi-rows.length + 1 : root.page == 8 ? 2 : root.page == 9 ? root.tracks.length : 1
    }
    public function move(d: int) {
        root.focus-index = max(0, min(root.row-count() - 1, root.focus-index + d));
    }
    public function activate(i: int) {
        root.focus-index = i;
        if (root.page == 1) {
            root.select-source(root.sources[i].name);
            root.go(0, 0);
        } else if (root.page == 2) {
            if (i == 0) {
                root.wifi-scan();
                root.go(5, 0);
            } else if (i == 1) {
                root.go(3, 0);
            } else if (i == 3) {
                root.go(4, 0);
            } else if (i == 4) {
                root.go(7, 0);
            }
        } else if (root.page == 3) {
            if (i == 1) {
                root.auto-brightness = !root.auto-brightness;
            }
        } else if (root.page == 5) {
            if (i >= root.wifi-rows.length) {
                root.wifi-scan();
            } else if (!root.wifi-rows[i].connected) {
                root.wifi-target = root.wifi-rows[i];
                if (root.wifi-rows[i].secured) {
                    root.kb-reset();
                    root.go(6, 0);
                } else {
                    root.join-state = 1;
                    root.go(6, 0);
                    root.wifi-join(root.wifi-target.ssid, root.wifi-target.ssid-hex, "");
                }
            }
        } else if (root.page == 9) {
            if (i < root.tracks.length) {
                root.pick-track(root.picker, i);
            }
            root.go(0, 0);
        } else if (root.page == 8) {
            root.join-state = 0;
            root.go(i == 0 ? 6 : 5, 0);
        } else if (root.page == 4) {
            if (i == 0) {
                root.power-action("STANDBY");
            } else if (i == 1) {
                root.power-action("RESTART");
            } else if (i == 2) {
                root.power-action("POWER_OFF");
            }
        }
    }

    property <float> wake: root.lit ? 1 : 0;
    animate wake { duration: 650ms; easing: ease-in-out; }
    // Smoothed again so the fade and zoom ease at both ends.
    property <float> reveal: root.wake * root.wake * (3 - 2 * root.wake);

    keys := FocusScope {
        transform-scale: 0.8 + 0.2 * root.reveal;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        opacity: root.reveal;
        key-pressed(event) => {
            root.activity();
            if (root.resting || root.charge-card) {
                root.resting = false;
                root.charge-card = false;
                return accept;
            }
            if (event.text == "p" || event.text == "P") {
                if (!event.repeat && !root.power-latched) {
                    root.power-turning-off = root.receiver-on;
                    root.power-completed = false;
                    root.capture(1);
                    root.power-holding = true;
                    root.haptic("hold-start");
                }
                return accept;
            }
            if (event.text == "h" || event.text == "H") {
                if (!event.repeat) {
                    root.home-down = true;
                    root.home-used = false;
                    root.home-rumbling = false;
                }
                return accept;
            }
            // The voice key is the input switcher, from anywhere.
            if (event.text == "v" || event.text == "V") {
                if (!event.repeat && root.page != 6) {
                    root.go(root.page == 1 ? 0 : 1, root.source-index);
                }
                return accept;
            }
            if (root.page == 6) {
                if (root.join-state != 1) {
                    root.kb-nav(event.text == Key.UpArrow ? "up" : event.text == Key.DownArrow ? "down" : event.text == Key.LeftArrow ? "left" : event.text == Key.RightArrow ? "right" : event.text == Key.Return ? "ok" : event.text == Key.Backspace || event.text == Key.Escape ? "back" : "");
                }
                return accept;
            }
            if (root.page != 0) {
                if (event.text == Key.Escape || event.text == Key.Backspace) {
                    root.back();
                    return accept;
                }
                if (event.text == Key.UpArrow) {
                    root.move(-1);
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    root.move(1);
                    return accept;
                }
                if (event.text == Key.Return) {
                    root.activate(root.focus-index);
                    return accept;
                }
                if (event.text == Key.LeftArrow || event.text == Key.RightArrow) {
                    if (root.page == 3 && root.focus-index == 0) {
                        root.brightness = max(5, min(100, root.brightness + (event.text == Key.LeftArrow ? -5 : 5)));
                    } else if (event.text == Key.LeftArrow) {
                        root.back();
                    }
                    return accept;
                }
            }
            root.key(event.text);
            return accept;
        }

        key-released(event) => {
            if ((event.text == "h" || event.text == "H") && root.home-down) {
                root.home-down = false;
                if (!root.home-used) {
                    if (root.home-rumbling) {
                        root.haptic("hold-cancel");
                    }
                    // A tap: back to the home screen from anywhere else, or Kodi's own home.
                    if (root.page != 0) {
                        root.go(0, 0);
                    } else {
                        root.key("h");
                    }
                }
            }
            if ((event.text == "p" || event.text == "P") && root.power-holding) {
                root.power-holding = false;
                root.haptic("hold-cancel");
            }
            return accept;
        }
        Timer {
            interval: 1200ms;
            running: root.power-holding;
            triggered => {
                root.power-holding = false;
                root.power-latched = true;
                root.power-completed = true;
                root.power-held();
                root.haptic("complete");
            }
        }
        // Taps are common, so the rumble waits a moment before starting.
        Timer {
            interval: 160ms;
            running: root.home-down && !root.home-used && !root.home-rumbling;
            triggered => {
                root.capture(1);
                root.home-rumbling = true;
                root.haptic("hold-start");
            }
        }
        Timer {
            interval: 650ms;
            running: root.home-down && !root.home-used;
            triggered => {
                root.home-used = true;
                root.haptic("complete");
                root.go(1, root.source-index);
            }
        }
        Timer {
            interval: 660ms;
            running: root.swapping && !root.swap-held;
            triggered => { root.swapping = false; }
        }
        Timer {
            interval: 550ms;
            running: root.page == 6;
            triggered => { root.caret-on = !root.caret-on; }
        }
        Timer {
            interval: 900ms;
            running: root.power-latched;
            triggered => { root.power-latched = false; }
        }

        // Catches touches that land on nothing, so the pointer stays hidden there too.
        TouchArea {
            mouse-cursor: Theme.cursor;
        }

        // Three layers. The main stage (home, now playing) is at the bottom; option lists (menu,
        // inputs, track pickers) open over it, and the stage recedes: it shrinks, blurs and dims
        // until it is only faintly there behind the list. Overlays (volume, power, charging) do
        // the same to whatever lies beneath them. Blur is a snapshot taken as the layer opens,
        // since Slint cannot blur live content.
        world := Rectangle {
            transform-origin: { x: self.width / 2, y: self.height / 2 };
            transform-scale: root.capturing != 0 ? 1 : 1 - 0.05 * root.under;

            stage := Rectangle {
                transform-origin: { x: self.width / 2, y: self.height / 2 };
                transform-scale: root.capturing == 1 ? 1 : (1 - 0.08 * root.recede) * (root.swapping ? 0.97 + 0.03 * root.swap : 1);
                opacity: root.capturing == 1 ? 1 : 1 - 0.55 * root.recede;


                    // Kodi, playing
                    Rectangle {
                        opacity: root.home-view == 1 ? 1 : 0;
                        visible: self.opacity > 0;

                        // The backdrop arrives already blurred and darkened; the scrim fades it into black
                        // where the controls sit.
                        Image {
                            width: 480px;
                            height: 800px;
                            source: root.backdrop;
                            image-fit: cover;
                            opacity: 0.55;
                        }
                        Image {
                            width: 480px;
                            height: 800px;
                            source: root.grain;
                            image-fit: fill;
                            image-rendering: pixelated;
                            opacity: root.backdrop.width > 0 ? 1 : 0;
                        }
                        Rectangle {
                            background: @linear-gradient(180deg, #00000066 0%, #00000022 26%, #000000B0 52%, #000000 74%);
                        }

                        Rectangle {
                            x: 144px;
                            y: 84px;
                            width: 192px;
                            height: 288px;
                            border-radius: 6px;
                            drop-shadow-blur: 28px;
                            drop-shadow-color: #000000CC;
                            drop-shadow-offset-y: 10px;
                            background: #111;
                            Rectangle {
                                border-radius: 6px;
                                clip: true;
                                if root.poster.width == 0: PosterStandIn {
                                    title: root.media-title;
                                }
                                if root.poster.width > 0: Image {
                                    source: root.poster;
                                    width: 100%;
                                    height: 100%;
                                    image-fit: cover;
                                }
                            }
                        }
                        Text {
                            y: 392px;
                            x: 24px;
                            width: 432px;
                            height: 36px;
                            horizontal-alignment: center;
                            overflow: elide;
                            text: root.media-title;
                            font-size: 28px;
                            font-weight: 500;
                            color: Theme.text;
                        }
                        Text {
                            y: 430px;
                            width: 480px;
                            horizontal-alignment: center;
                            text: root.media-sub;
                            font-size: 18px;
                            color: Theme.t2;
                        }
                        Bar {
                            x: 40px;
                            y: 470px;
                            value: root.progress;
                        }
                        Text {
                            x: 40px;
                            y: 494px;
                            text: root.elapsed;
                            font-size: 18px;
                            font-weight: 400;
                            color: Theme.t2;
                        }
                        Text {
                            x: 40px;
                            y: 494px;
                            width: 400px;
                            horizontal-alignment: right;
                            text: root.paused ? root.time-left + "  ·  paused" : root.time-left + "  ·  " + root.ends-at;
                            font-size: 18px;
                            color: Theme.t2;
                        }

                        SkipButton {
                            x: 84px;
                            y: 548px;
                            back: true;
                            tapped => { root.seek(-10); }
                        }
                        Rectangle {
                            x: 198px;
                            y: 542px;
                            width: 84px;
                            height: 84px;
                            border-radius: 42px;
                            background: Theme.accent;
                            opacity: play-touch.pressed ? 0.6 : 1;
                            Path {
                                x: root.paused ? 30px : 26px;
                                width: 32px;
                                height: 32px;
                                viewbox-width: 24;
                                viewbox-height: 24;
                                commands: root.paused ? Marks.play : Marks.pause;
                                fill: Theme.bg;
                            }
                            play-touch := TouchArea {
                                mouse-cursor: Theme.cursor;
                                clicked => { root.command("play_pause"); }
                            }
                        }
                        SkipButton {
                            x: 332px;
                            y: 548px;
                            back: false;
                            tapped => { root.seek(10); }
                        }

                        if root.home-warning == "": HorizontalLayout {
                            y: 656px;
                            height: 40px;
                            alignment: center;
                            spacing: 18px;
                            FormatBadge {
                                logo: root.media-format-logo;
                                logo-width: root.media-format-logo-width;
                        logo-top: root.media-format-logo-top;
                        logo-height: root.media-format-logo-height;
                        size: root.media-format-logo-size;
                        on-baseline: root.media-format-logo-baseline;
                                label: root.media-format-label;
                            }
                            if root.media-format-label != "" || root.media-format-logo != "": Text {
                                text: "·";
                                font-size: 22px;
                                color: Theme.t3;
                                vertical-alignment: center;
                            }
                            VolumeChip {
                                volume: root.volume;
                                muted: root.muted;
                                size: 22px;
                            }
                        }
                        if root.home-warning != "": WarningRow {
                            y: 648px;
                            message: root.home-warning;
                            tapped => { root.go(7, 0); }
                        }
                        TrackButton {
                            x: 32px;
                            y: 716px;
                            icon: Icons.subtitles;
                            label: "Subtitles";
                            tapped => { root.tracks = []; root.picker = 1; root.go(9, 0); root.open-picker(1); }
                        }
                        TrackButton {
                            x: 248px;
                            y: 716px;
                            icon: Icons.audio;
                            label: "Audio";
                            tapped => { root.tracks = []; root.picker = 0; root.go(9, 0); root.open-picker(0); }
                        }
                    }

                    // The current input, shown as its mark. Kodi while browsing looks the same as any other.
                    Rectangle {
                        opacity: root.home-view == 2 ? 1 : 0;
                        visible: self.opacity > 0;

                        Logo {
                            y: 330px;
                            size: 140px;
                            commands: root.source == "" ? Logos.kodi : root.source-icon;
                            tint: Theme.t2-muted;
                        }
                        // An input with no mark of its own needs its name to be told apart.
                        if root.source != "" && root.source-icon == Logos.generic: Text {
                            y: 490px;
                            width: 480px;
                            horizontal-alignment: center;
                            text: root.source;
                            font-size: 26px;
                            color: Theme.t2;
                        }
                        if root.sources.length > 0: TouchArea {
                            mouse-cursor: Theme.cursor;
                            x: 140px;
                            y: 300px;
                            width: 200px;
                            height: 200px;
                            clicked => { root.go(1, root.source-index); }
                        }
                        if root.home-warning != "": WarningRow {
                            y: 540px;
                            message: root.home-warning;
                            tapped => { root.go(7, 0); }
                        }
                        VolumeChip {
                            y: 700px;
                            height: 40px;
                            size: 32px;
                            volume: root.volume;
                            muted: root.muted;
                        }
                    }

                    // Receiver off
                    Rectangle {
                        opacity: root.home-view == 3 ? 1 : 0;
                        visible: self.opacity > 0;

                        Glyph {
                            y: 340px;
                            size: 72px;
                            commands: Icons.power;
                            tint: Theme.t3;
                        }
                        Text {
                            y: 436px;
                            width: 480px;
                            horizontal-alignment: center;
                            text: "Off";
                            font-size: 26px;
                            color: Theme.t2;
                        }
                    }

                    StatusBar {
                        clock: root.clock;
                        battery: root.battery;
                        charging: root.charging;
                        menu => { root.go(2, 0); }
                    }
                    // While something plays, the input's mark moves up into the status line; tapping it
                    // opens the list. On the idle screen the large mark already says it.
                    if root.home-view == 1 && root.sources.length > 0: TouchArea {
                        mouse-cursor: Theme.cursor;
                        x: 190px;
                        y: 0;
                        width: 100px;
                        height: 64px;
                        clicked => { root.go(1, root.source-index); }
                        Logo {
                            size: 32px;
                            commands: root.source-icon;
                            tint: Theme.t2;
                        }
                    }
                    if !root.connected: Text {
                        y: 772px;
                        width: 480px;
                        horizontal-alignment: center;
                        text: root.status;
                        font-size: 14px;
                        color: Theme.t3;
                        overflow: elide;
                    }

                // One stage giving way to another: the old one, sharp then blurred, dissolves into
                // the new one blurred, which sharpens into the live stage beneath.
                Rectangle {
                    visible: root.swapping && root.capturing == 0;
                    Image {
                        width: 480px;
                        height: 800px;
                        source: root.swap-in-blur;
                        image-fit: fill;
                        opacity: 1 - clamp((root.swap - 0.55) / 0.45, 0, 1);
                    }
                    Image {
                        width: 480px;
                        height: 800px;
                        transform-origin: { x: self.width / 2, y: self.height / 2 };
                        transform-scale: 1 + 0.05 * root.swap;
                        source: root.swap-out-blur;
                        image-fit: fill;
                        opacity: 1 - clamp((root.swap - 0.25) / 0.35, 0, 1);
                    }
                    Image {
                        width: 480px;
                        height: 800px;
                        transform-origin: { x: self.width / 2, y: self.height / 2 };
                        transform-scale: 1 + 0.05 * root.swap;
                        source: root.swap-out;
                        image-fit: fill;
                        opacity: 1 - clamp(root.swap / 0.3, 0, 1);
                    }
                }

                Image {
                    width: 480px;
                    height: 800px;
                    source: root.stage-blur;
                    image-fit: fill;
                    opacity: root.recede;
                    visible: self.opacity > 0 && root.capturing != 1;
                }
            }

            options := Rectangle {
                visible: root.recede > 0 && root.capturing != 1;
                opacity: root.recede;
                transform-origin: { x: self.width / 2, y: self.height / 2 };
                transform-scale: 1.04 - 0.04 * root.recede;
                background: #000000B8;
                // The stage behind is only scenery while a list is open.
                TouchArea { mouse-cursor: Theme.cursor; }

            // Inputs
            Page {
                depth: 1;
                current-depth: root.depth;
                active: root.page == 1;
                property <length> row-h: min(100px, 700px / max(1, root.sources.length));

                StatusBar {
                    clock: root.clock;
                    battery: root.battery;
                    charging: root.charging;
                    menu => { root.go(2, 0); }
                }
                for row[i] in root.sources: ListRow {
                    y: 68px + i * parent.row-h;
                    height: parent.row-h;
                    divider: i > 0;
                    label: row.name;
                    icon: row.icon;
                    focused: i == root.focus-index;
                    checked: i == root.source-index;
                    tapped => { root.activate(i); }
                }
            }

            // Menu
            Page {
                depth: 1;
                current-depth: root.depth;
                active: root.page == 2;

                Image {
                    width: 480px;
                    height: 800px;
                    source: root.lava;
                    image-fit: fill;
                    image-rendering: pixelated;
                }
                StatusBar {
                    clock: root.clock;
                    battery: root.battery;
                    charging: root.charging;
                    show-menu: false;
                }
                PageHeader {
                    title: "Menu";
                    back => { root.back(); }
                }
                ListRow {
                    y: 168px;
                    height: 96px;
                    label: "Wi-Fi";
                    value: root.wifi-name;
                    chevron: true;
                    focused: root.focus-index == 0;
                    tapped => { root.activate(0); }
                }
                ListRow {
                    y: 264px;
                    height: 96px;
                    label: "Display";
                    value: root.brightness + "%";
                    chevron: true;
                    focused: root.focus-index == 1;
                    tapped => { root.activate(1); }
                }
                ListRow {
                    y: 360px;
                    height: 96px;
                    label: "Sound & haptics";
                    value: root.haptics;
                    chevron: true;
                    focused: root.focus-index == 2;
                    tapped => { root.activate(2); }
                }
                ListRow {
                    y: 456px;
                    height: 96px;
                    label: "Power";
                    chevron: true;
                    focused: root.focus-index == 3;
                    tapped => { root.activate(3); }
                }
                ListRow {
                    y: 552px;
                    height: 96px;
                    label: "Status";
                    chevron: true;
                    focused: root.focus-index == 4;
                    tapped => { root.activate(4); }
                }
                ListRow {
                    y: 648px;
                    height: 96px;
                    label: "About";
                    chevron: true;
                    focused: root.focus-index == 5;
                    tapped => { root.activate(5); }
                }
            }

            // Menu / Display
            Page {
                depth: 2;
                current-depth: root.depth;
                active: root.page == 3;

                StatusBar {
                    clock: root.clock;
                    battery: root.battery;
                    charging: root.charging;
                    show-menu: false;
                }
                PageHeader {
                    title: "Display";
                    back => { root.back(); }
                }
                Rectangle {
                    x: 0;
                    y: 168px;
                    width: 4px;
                    height: 40px;
                    border-radius: 2px;
                    background: Theme.accent;
                    opacity: root.focus-index == 0 ? 1 : 0;
                    animate opacity { duration: 140ms; }
                }
                Text {
                    x: 40px;
                    y: 172px;
                    text: "Brightness";
                    font-size: 26px;
                    font-weight: root.focus-index == 0 ? 500 : 400;
                    color: root.focus-index == 0 ? Theme.text : Theme.text-dim;
                }
                Text {
                    x: 40px;
                    y: 176px;
                    width: 400px;
                    horizontal-alignment: right;
                    text: root.brightness + "%";
                    font-size: 22px;
                    font-weight: 300;
                    color: Theme.t2;
                }
                Bar {
                    x: 40px;
                    y: 250px;
                    value: root.brightness / 100;
                    handle: true;
                }
                TouchArea {
                    mouse-cursor: Theme.cursor;
                    x: 24px;
                    y: 220px;
                    width: 432px;
                    height: 74px;
                    function set() {
                        root.focus-index = 0;
                        root.brightness = max(5, min(100, round((self.mouse-x - 16px) / 400px * 100)));
                    }
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            self.set();
                        }
                    }
                    moved => {
                        if (self.pressed) {
                            self.set();
                        }
                    }
                }
                ListRow {
                    y: 328px;
                    height: 104px;
                    label: "Auto brightness";
                    focused: root.focus-index == 1;
                    tapped => { root.activate(1); }
                    Rectangle {
                        x: 384px;
                        width: 56px;
                        height: 32px;
                        border-radius: 16px;
                        background: root.auto-brightness ? Theme.text : Theme.track;
                        animate background { duration: 160ms; }
                        Rectangle {
                            x: root.auto-brightness ? 28px : 4px;
                            width: 24px;
                            height: 24px;
                            border-radius: 12px;
                            background: root.auto-brightness ? Theme.bg : Theme.t2;
                            animate x { duration: 160ms; easing: ease-out; }
                        }
                    }
                }
                ListRow {
                    y: 432px;
                    height: 104px;
                    label: "Screen off after";
                    value: root.screen-off-after;
                    chevron: true;
                    focused: root.focus-index == 2;
                    tapped => { root.activate(2); }
                }
            }

            // Menu / Power
            Page {
                depth: 2;
                current-depth: root.depth;
                active: root.page == 4;

                StatusBar {
                    clock: root.clock;
                    battery: root.battery;
                    charging: root.charging;
                    show-menu: false;
                }
                PageHeader {
                    title: "Power";
                    back => { root.back(); }
                }
                ListRow {
                    y: 168px;
                    label: "Standby";
                    focused: root.focus-index == 0;
                    tapped => { root.activate(0); }
                }
                ListRow {
                    y: 280px;
                    label: "Restart";
                    focused: root.focus-index == 1;
                    tapped => { root.activate(1); }
                }
                ListRow {
                    y: 392px;
                    label: "Power off";
                    focused: root.focus-index == 2;
                    tapped => { root.activate(2); }
                }
                ListRow {
                    y: 504px;
                    label: "Sleep after";
                    value: root.sleep-after;
                    chevron: true;
                    focused: root.focus-index == 3;
                    tapped => { root.activate(3); }
                }
            }

            // Menu / Wi-Fi
            Page {
                depth: 2;
                current-depth: root.depth;
                active: root.page == 5;

                StatusBar {
                    clock: root.clock;
                    battery: root.battery;
                    charging: root.charging;
                    show-menu: false;
                }
                PageHeader {
                    title: "Wi-Fi";
                    back => { root.back(); }
                }
                for row[i] in root.wifi-rows: ListRow {
                    y: 168px + i * 96px;
                    height: 96px;
                    divider: i > 0;
                    label: row.ssid;
                    value: row.connected ? "Connected" : "";
                    trailing: 48px;
                    focused: i == root.focus-index;
                    tapped => { root.activate(i); }
                    if row.secured && !row.connected: Glyph {
                        x: 364px;
                        commands: Icons.lock;
                        tint: Theme.t3;
                    }
                    for n in 4: Rectangle {
                        x: 408px + n * 8px;
                        y: parent.height / 2 + 11px - self.height;
                        width: 5px;
                        height: 7px + n * 5px;
                        border-radius: 2px;
                        background: n < row.bars ? Theme.t2 : Theme.track;
                    }
                }
                ListRow {
                    y: 168px + root.wifi-rows.length * 96px;
                    height: 96px;
                    divider: root.wifi-rows.length > 0;
                    label: root.wifi-scanning ? "Scanning…" : "Scan again";
                    focused: root.focus-index == root.wifi-rows.length;
                    tapped => { root.activate(root.wifi-rows.length); }
                }
            }

            // Menu / Wi-Fi / password
            Page {
                depth: 3;
                current-depth: root.depth;
                active: root.page == 6;

                PageHeader {
                    y: 0;
                    title: root.wifi-target.ssid;
                    back => { root.back(); }
                }
                Text {
                    x: 40px;
                    y: 128px;
                    text: "PASSWORD";
                    font-size: 13px;
                    font-weight: 500;
                    letter-spacing: 1.8px;
                    color: Theme.t2;
                }
                Rectangle {
                    x: 40px;
                    y: 158px;
                    width: 400px;
                    height: 84px;
                    clip: true;
                    HorizontalLayout {
                        alignment: end;
                        spacing: 3px;
                        Text {
                            text: root.kb-text;
                            font-size: 40px;
                            font-weight: 300;
                            letter-spacing: 0.8px;
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 3px;
                                height: 40px;
                                border-radius: 2px;
                                background: Theme.accent;
                                opacity: root.caret-on && root.join-state != 1 ? 1 : 0;
                            }
                        }
                    }
                }
                Rectangle {
                    x: 40px;
                    y: 242px;
                    width: 400px;
                    height: 1px;
                    background: Theme.hair;
                }

                if root.join-state != 1: Rectangle {
                    for key[i] in root.kb-keys: Rectangle {
                        x: key.x;
                        y: key.y;
                        width: key.w;
                        height: key.h;
                        border-radius: key.style == 0 ? 12px : 16px;
                        background: key.focused ? Theme.accent : key.style == 2 ? #2A2A2C : key.style == 0 ? #121213 : #161617;
                        opacity: key.focused && key.style == 3 ? 0.45 : 1;
                        transform-scale: key.focused ? (key.style == 0 ? 1.12 : 1.06) : 1;
                        animate transform-scale, background { duration: 80ms; }
                        if key.icon == "": Text {
                            text: key.label;
                            font-size: key.style == 0 ? 26px : 20px;
                            font-weight: key.focused || key.style == 4 ? 600 : key.style == 0 ? 400 : 500;
                            color: key.focused ? #000000 : key.style == 3 ? Theme.t3 : key.style == 4 ? Theme.accent : Theme.text;
                        }
                        if key.icon != "": Glyph {
                            commands: key.icon;
                            tint: key.focused ? #000000 : Theme.text;
                        }
                        TouchArea {
                            mouse-cursor: Theme.cursor;
                            clicked => { root.kb-tap(i); }
                        }
                    }
                }
                if root.join-state == 1: Rectangle {
                    Text {
                        y: 440px;
                        width: 480px;
                        horizontal-alignment: center;
                        text: "Joining…";
                        font-size: 32px;
                        font-weight: 300;
                        color: Theme.text;
                    }
                    Rectangle {
                        x: 120px;
                        y: 524px;
                        width: 240px;
                        height: 14px;
                        border-radius: 7px;
                        background: Theme.track;
                        clip: true;
                        Rectangle {
                            x: 75px + 75px * sin(animation-tick() / 1ms * 0.33deg);
                            width: 90px;
                            border-radius: 7px;
                            background: Theme.accent;
                        }
                    }
                }
            }

            // Menu / Status
            Page {
                depth: 2;
                current-depth: root.depth;
                active: root.page == 7;

                StatusBar {
                    clock: root.clock;
                    battery: root.battery;
                    charging: root.charging;
                    show-menu: false;
                }
                PageHeader {
                    title: "Status";
                    back => { root.back(); }
                }
                for row[i] in root.status-rows: Rectangle {
                    x: 0;
                    y: 168px + i * 96px;
                    width: 480px;
                    height: 96px;
                    if i > 0: Rectangle {
                        y: 0;
                        height: 1px;
                        background: Theme.hair;
                    }
                    Rectangle {
                        x: 0;
                        width: 4px;
                        height: 40px;
                        border-radius: 2px;
                        background: Theme.accent;
                        opacity: row.level == 1 ? 1 : 0;
                    }
                    Dot {
                        x: 40px;
                        level: row.level;
                    }
                    Text {
                        x: 72px;
                        text: row.label;
                        font-size: 26px;
                        font-weight: row.level == 1 ? 500 : 400;
                        color: row.level == 1 ? Theme.text : Theme.text-dim;
                    }
                    Text {
                        x: 0;
                        width: 440px;
                        horizontal-alignment: right;
                        text: row.value;
                        font-size: 22px;
                        font-weight: 300;
                        color: Theme.t2;
                    }
                }
            }

            // Menu / Wi-Fi / join failed
            Page {
                depth: 4;
                current-depth: root.depth;
                active: root.page == 8;

                PageHeader {
                    y: 0;
                    title: root.wifi-target.ssid;
                    back => { root.back(); }
                }
                Text {
                    y: 300px;
                    width: 480px;
                    horizontal-alignment: center;
                    text: "Couldn’t join";
                    font-size: 44px;
                    font-weight: 300;
                    color: Theme.text;
                }
                Text {
                    y: 376px;
                    width: 480px;
                    horizontal-alignment: center;
                    text: "Check the password and try again.";
                    font-size: 22px;
                    color: Theme.t2;
                }
                Pill {
                    y: 500px;
                    label: "Try again";
                    focused: root.focus-index == 0;
                    tapped => { root.activate(0); }
                }
                Pill {
                    y: 580px;
                    label: root.wifi-name == "" ? "Cancel" : "Stay on " + root.wifi-name;
                    focused: root.focus-index == 1;
                    tapped => { root.activate(1); }
                }
            }

            // Audio or subtitle tracks
            Page {
                depth: 2;
                current-depth: root.depth;
                active: root.page == 9;
                property <length> row-h: min(96px, 620px / max(1, root.tracks.length));

                StatusBar {
                    clock: root.clock;
                    battery: root.battery;
                    charging: root.charging;
                    show-menu: false;
                }
                PageHeader {
                    title: root.picker == 0 ? "Audio" : "Subtitles";
                    back => { root.back(); }
                }
                if root.tracks.length == 0: Text {
                    y: 220px;
                    width: 480px;
                    horizontal-alignment: center;
                    text: "Loading…";
                    font-size: 22px;
                    color: Theme.t2;
                }
                for row[i] in root.tracks: ListRow {
                    y: 168px + i * parent.row-h;
                    height: parent.row-h;
                    divider: i > 0;
                    label: "";
                    trailing: 48px;
                    focused: i == root.focus-index;
                    tapped => { root.activate(i); }
                    // Name above, codec below: long stream names would otherwise run into the codec.
                    Text {
                        x: 40px;
                        y: row.detail == "" ? (parent.height - self.height) / 2 : parent.height / 2 - 30px;
                        width: 340px;
                        overflow: elide;
                        text: row.label;
                        font-size: 26px;
                        font-weight: i == root.focus-index ? 500 : 400;
                        color: i == root.focus-index ? Theme.text : Theme.text-dim;
                    }
                    if row.detail != "": Text {
                        x: 40px;
                        y: parent.height / 2 + 6px;
                        width: 340px;
                        overflow: elide;
                        text: row.detail;
                        font-size: 18px;
                        color: Theme.t2;
                    }
                    if row.current: Glyph {
                        x: 404px;
                        commands: Icons.check;
                        tint: Theme.accent;
                    }
                }
            }
            }

            Image {
                width: 480px;
                height: 800px;
                source: root.world-blur;
                image-fit: fill;
                opacity: root.under;
                visible: self.opacity > 0 && root.capturing == 0;
            }
        }

        // Volume overlay, over everything.
        Rectangle {
            property <bool> shown: root.volume-overlay && root.receiver-on;
            background: #000000A6;
            opacity: self.shown ? 1 : 0;
            visible: self.opacity > 0 && root.capturing == 0;
            animate opacity { duration: 180ms; easing: ease-out; }

            Glyph {
                y: 198px;
                size: 52px;
                commands: Icons.muted;
                opacity: root.muted ? 1 : 0;
                animate opacity { duration: 160ms; }
            }
            VolumeReadout {
                y: 0;
                height: 800px;
                top: 270px;
                volume: root.volume;
                volume-db: root.volume-db;
                muted: root.muted;
            }
        }
    }

    // Holding home: a ring fills around the current input's mark, and the input list opens when
    // it closes, timed with the rumble.
    property <bool> home-holding: root.home-down && root.home-rumbling && !root.home-used;
    property <float> home-hold: 0;
    property <float> ring: min(root.home-hold, 0.9999);
    Rectangle {
        background: #000000A6;
        opacity: root.home-holding ? 1 : 0;
        visible: self.opacity > 0 && root.capturing == 0;
        animate opacity { duration: 140ms; easing: ease-out; }
        Path {
            x: 120px;
            y: 240px;
            width: 240px;
            height: 240px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M12 1.5A10.5 10.5 0 1 1 11.999 1.5";
            fill: transparent;
            stroke: Theme.track;
            stroke-width: 10px;
        }
        Path {
            x: 120px;
            y: 240px;
            width: 240px;
            height: 240px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M12 1.5A10.5 10.5 0 " + (root.ring > 0.5 ? "1" : "0") + " 1 " + (12 + 10.5 * sin(root.ring * 360deg)) + " " + (12 - 10.5 * cos(root.ring * 360deg));
            fill: transparent;
            stroke: Theme.accent;
            stroke-width: 10px;
            stroke-line-cap: round;
        }
        Logo {
            y: 312px;
            size: 96px;
            commands: root.source == "" ? Logos.kodi : root.source-icon;
            tint: Theme.text;
        }
        Text {
            y: 516px;
            width: 480px;
            horizontal-alignment: center;
            text: "Inputs";
            font-size: 26px;
            font-weight: 300;
            color: Theme.t2;
        }
    }

    // Hold-to-power overlay: the symbol fills and a wash of the same colour rises behind it.
    Rectangle {
        background: #000000A6;
        opacity: root.power-overlay ? 1 : 0;
        visible: self.opacity > 0 && root.capturing == 0;
        animate opacity { duration: 240ms; easing: ease-out; }

        Rectangle {
            x: 0;
            y: parent.height * (1 - root.hold);
            width: parent.width;
            height: parent.height * root.hold;
            background: @linear-gradient(0deg, root.power-tint.with-alpha(0.38) 0%, root.power-tint.with-alpha(0) 100%);
        }
        Glyph {
            y: 290px;
            size: 176px;
            commands: Icons.power;
            tint: Theme.t3;
        }
        Rectangle {
            x: 152px;
            y: 290px + 176px * (1 - root.hold);
            width: 176px;
            height: 176px * root.hold;
            clip: true;
            Glyph {
                x: 0;
                y: -176px * (1 - root.hold);
                size: 176px;
                commands: Icons.power;
                tint: root.power-tint;
            }
        }
        Text {
            y: 560px;
            width: 480px;
            horizontal-alignment: center;
            text: root.power-completed ? (root.power-turning-off ? "Off" : "On") : (root.power-turning-off ? "Hold to turn off" : "Hold to turn on");
            font-size: 26px;
            font-weight: 300;
            color: root.power-completed ? Theme.text : Theme.t2;
        }
    }

    states [
        homing when root.home-holding: {
            root.home-hold: 1;
            in {
                animate root.home-hold { duration: 490ms; easing: linear; }
            }
        }
        filling when root.power-holding || root.power-latched: {
            root.hold: 1;
            in {
                animate root.hold { duration: 1200ms; easing: ease-in-out; }
            }
            out {
                animate root.hold { duration: 420ms; easing: ease-in-out; }
            }
        }
    ]

    // Charging: the battery, full screen, until the first touch or key.
    Rectangle {
        background: #000000C0;
        opacity: root.charge-card && root.lit ? 1 : 0;
        visible: self.opacity > 0 && root.capturing == 0;
        animate opacity { duration: 300ms; easing: ease-in-out; }
        Rectangle {
            x: 122px;
            y: 300px;
            width: 220px;
            height: 104px;
            border-radius: 26px;
            border-width: 5px;
            border-color: #FFFFFF59;
            Rectangle {
                x: 11px;
                y: 11px;
                width: (parent.width - 22px) * clamp(root.battery, 4, 100) / 100;
                height: parent.height - 22px;
                border-radius: 16px;
                background: Theme.good;
            }
            Path {
                width: 64px;
                height: 84px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: Marks.bolt;
                fill: Theme.text;
                stroke: Theme.bg;
                stroke-width: 4px;
            }
        }
        Rectangle {
            x: 346px;
            y: 334px;
            width: 12px;
            height: 36px;
            border-radius: 6px;
            background: #FFFFFF59;
        }
        Text {
            y: 436px;
            width: 480px;
            horizontal-alignment: center;
            text: root.battery + "%";
            font-size: 64px;
            font-weight: 200;
            color: Theme.text;
        }
        Text {
            y: 520px;
            width: 480px;
            horizontal-alignment: center;
            text: root.battery >= 100 ? "Charged" : "Charging";
            font-size: 22px;
            color: Theme.t2;
        }
        TouchArea {
            mouse-cursor: Theme.cursor;
            clicked => {
                root.charge-card = false;
                root.activity();
            }
        }
    }

    if !root.awake: TouchArea { mouse-cursor: Theme.cursor; }
    // The first touch after resting only wakes the screen.
    if root.awake && root.resting: TouchArea {
        mouse-cursor: Theme.cursor;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.resting = false;
                root.activity();
            }
        }
    }
}
