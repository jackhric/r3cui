---
import { Button } from '@/components/starwind/button';
import Icon from '../Icon.astro';
import Logo from '../Logo.astro';
import mask from '../../assets/remote-mask.png?url';
import { riverColumns } from './river';

interface Props { repo: string }
const { repo } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const iconButton = 'text-(--hero-text) rounded-lg hover:bg-(--hero-text)/8 hover:text-(--hero-text) select-none';
const docsButton = `docs text-base px-2.5 -ml-2.5 ${iconButton}`;
const columns = riverColumns(15);
---

<section class="hero">
  <div class="stage" aria-hidden="true">
    <div class="glow"></div>
    <div class="river" style={`--mask:url(${mask})`}>
      {columns.map(col => (
        <div class="column" style={col.style}>
          <div class="flow">
            {[...col.clips, ...col.clips].map(c => (
              <video muted loop playsinline preload="none" width="100" height="432" poster={c.poster}
                data-webm={c.webm} data-mp4={c.mp4}></video>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
  <div class="shade"></div>

  <header class="top">
    <nav>
      <a href="#features">Features</a>
      <a href="#get-started">Get started</a>
      <a href={`${base}/docs/faq/`}>FAQ</a>
      <Button href={`${base}/docs/`} variant="ghost" size="sm" class={docsButton}>
        Docs
      </Button>
      <span class="icons">
        <Button href={repo} title="GitHub" variant="ghost" size="icon-sm" class={iconButton}>
          <Icon name="github" label="GitHub" class="size-5" />
        </Button>
      </span>
    </nav>
  </header>

  <h1 class="content"><Logo class="logo" label="r3cui: a simplified Unfolded Circle Remote 3 interface" /></h1>
</section>

<script>
  const videos = [...document.querySelectorAll<HTMLVideoElement>('.hero video[data-webm]')];
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  const golden = 0.618034;

  function load(video: HTMLVideoElement, i: number) {
    if (video.dataset.loaded) return;
    video.dataset.loaded = '1';
    for (const [type, key] of [['video/webm', 'webm'], ['video/mp4', 'mp4']] as const) {
      const source = document.createElement('source');
      source.type = type;
      source.src = video.dataset[key]!;
      video.append(source);
    }
    // Copies of a clip start at different points, so neighbours never play in step.
    video.addEventListener('loadedmetadata', () => { video.currentTime = ((i * golden) % 1) * video.duration; }, { once: true });
    video.load();
  }

  // Decoding is the hero's main cost, so at most MAX_PLAYING clips run, only those on screen; the rest show
  // their poster. Nothing downloads until the page has loaded and gone idle.
  const MAX_PLAYING = 12;
  const visible = new Set<HTMLVideoElement>();
  const playing = new Set<HTMLVideoElement>();
  function schedule() {
    for (const v of playing) if (!visible.has(v) || document.hidden) { v.pause(); playing.delete(v); }
    if (document.hidden) return;
    for (const v of visible) {
      if (playing.size >= MAX_PLAYING) break;
      if (playing.has(v)) continue;
      load(v, videos.indexOf(v));
      v.play().catch(() => {});
      playing.add(v);
    }
  }
  const observer = new IntersectionObserver(entries => {
    for (const { target, isIntersecting } of entries) {
      if (isIntersecting) visible.add(target as HTMLVideoElement);
      else visible.delete(target as HTMLVideoElement);
    }
    schedule();
  });

  const start = () => videos.forEach(v => observer.observe(v));
  const idle = () => ('requestIdleCallback' in window ? requestIdleCallback(start, { timeout: 2000 }) : setTimeout(start, 300));
  if (!still.matches) {
    if (document.readyState === 'complete') idle();
    else addEventListener('load', idle, { once: true });
  }
  document.addEventListener('visibilitychange', schedule);

  // Parallax: the river drifts at a third of the scroll speed and the logo at a sixth, so the page
  // slides over them.
  const stage = document.querySelector<HTMLElement>('.hero .stage')!;
  const logo = document.querySelector<HTMLElement>('.hero .content')!;
  let ticking = false;
  const parallax = () => {
    ticking = false;
    const y = Math.min(scrollY, innerHeight);
    stage.style.translate = `0 ${(y * 0.35).toFixed(1)}px`;
    logo.style.translate = `0 ${(y * 0.18).toFixed(1)}px`;
  };
  if (!still.matches) {
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(parallax); } }, { passive: true });
    parallax();
  }

  // Off screen the hero costs nothing: the river and the clips pause.
  const hero = document.querySelector<HTMLElement>('.hero')!;
  new IntersectionObserver(([e]) => {
    hero.classList.toggle('away', !e.isIntersecting);
    if (e.isIntersecting) schedule();
    else for (const v of playing) { v.pause(); playing.delete(v); }
  }).observe(hero);
</script>

<style>
  .hero {
    position: relative; overflow: hidden; isolation: isolate; color: var(--hero-text); background: var(--hero-bg);
    min-height: min(58vh, 540px); display: flex; flex-direction: column;
  }
  .stage { position: absolute; inset: 0; user-select: none; -webkit-user-select: none; pointer-events: none; }
  .glow {
    position: absolute; left: 50%; top: 50%; width: 110%; height: 160%; translate: -50% -50%;
    background: radial-gradient(closest-side, var(--hero-glow), color-mix(in srgb, var(--hero-glow) 30%, transparent) 55%, transparent 75%);
    animation: glow-in 2.4s ease-out backwards;
  }
  @keyframes glow-in { from { opacity: 0; scale: 0.85; } }

  /* Flat, top-down: columns of whole remotes drifting down the page, each at its own pace and offset. */
  /* Taller than the hero and rotated about its centre, so a tilted river still covers every corner. */
  .river {
    position: absolute; top: -60%; bottom: -60%; left: 50%; translate: -50% 0; rotate: 20deg;
    display: flex; gap: 22px;
    animation: river-in 1.6s cubic-bezier(0.16, 1, 0.3, 1) 0.1s backwards;
  }
  @keyframes river-in { from { opacity: 0; } }
  .column {
    --tile: 100px; --gap: 22px; flex: none; width: var(--tile); height: 100%;
    margin-top: calc(var(--stagger, 0) * -1 * (var(--tile) * 4.32 + var(--gap)));
  }
  .flow {
    display: grid; gap: 22px; will-change: transform;
    animation: drift 120s linear infinite;
  }
  /* Video can't carry the photo's transparent corners everywhere, so each tile is cut to the remote's
     own outline instead. */
  .flow video {
    display: block; width: 100px; height: auto; aspect-ratio: 200 / 864;
    -webkit-mask: var(--mask) center / 100% 100% no-repeat; mask: var(--mask) center / 100% 100% no-repeat;
  }
  /* Two copies of the column stacked; sliding by one copy's height loops seamlessly. */
  @keyframes drift { from { transform: translateY(calc(-50% - 11px)); } to { transform: translateY(0); } }
  .hero.away .flow { animation-play-state: paused; }

  /* Darkest behind the logo, fading out toward the edges so the river stays visible around it. */
  .shade {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background:
      radial-gradient(ellipse 34% 40% at 50% 54%, color-mix(in srgb, var(--hero-bg) 82%, transparent), color-mix(in srgb, var(--hero-bg) 40%, transparent) 60%, transparent 100%),
      linear-gradient(to bottom, color-mix(in srgb, var(--hero-bg) 45%, transparent), transparent 14%);
  }

  .top {
    position: relative; z-index: 3; width: 100%; max-width: 1160px; margin: 0 auto; padding: 18px 28px;
    display: flex; align-items: center; justify-content: flex-end; gap: 16px; flex-wrap: wrap;
  }
  /* A dark, blurred pill keeps the links readable over whatever part of the river passes behind them. */
  .top nav {
    display: flex; align-items: center; gap: 20px; flex-wrap: wrap; padding: 6px 8px 6px 20px; border-radius: 999px;
    background: color-mix(in srgb, var(--hero-bg) 55%, transparent); border: 1px solid rgb(255 255 255 / 0.1);
    backdrop-filter: blur(18px) saturate(1.3);
    box-shadow: 0 8px 30px rgb(0 0 0 / 0.45);
  }
  .top nav a { color: color-mix(in srgb, var(--hero-text) 88%, transparent); text-decoration: none; font-weight: 600; }
  .top nav a:hover { color: var(--hero-text); }
  .icons { display: flex; gap: 4px; }

  .content {
    position: relative; z-index: 2; margin: auto; padding: 24px 28px 88px; display: grid; place-items: center;
  }
  .content :global(.logo) {
    width: min(420px, 72vw); height: auto; color: var(--hero-text);
    filter: drop-shadow(0 4px 30px rgb(0 0 0 / 0.6));
  }

  @media (max-width: 760px) {
    .top nav > a:not(.docs) { display: none; }
    .river { gap: 16px; }
    .column { --tile: 80px; --gap: 16px; }
    .flow video { width: 80px; }
    .flow { gap: 16px; }
    .content { padding-bottom: 64px; }
  }
  @media (max-width: 400px) {
    .top { padding: 14px 16px; }
    .top nav { gap: 8px; padding-left: 14px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .flow, .river, .glow { animation: none; }
  }
</style>
