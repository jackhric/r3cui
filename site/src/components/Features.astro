---
import ring from '../assets/one-ring.webp?url';
import kodiSvg from '../assets/brands/kodi.svg?raw';
import haSvg from '../assets/brands/homeassistant.svg?raw';

const clips = import.meta.glob<string>('../assets/clips/*.{webm,mp4,webp}', { query: '?url', import: 'default', eager: true });
const clip = (name: string) => ({
  webm: clips[`../assets/clips/${name}.webm`],
  mp4: clips[`../assets/clips/${name}.mp4`],
  poster: clips[`../assets/clips/${name}.webp`],
});

// Brand marks from Simple Icons, drawn in each brand's own colour.
const brand = (svg: string) => svg.replace(/<title>.*?<\/title>/, '').replace('<svg', '<svg aria-hidden="true" fill="currentColor"');
const brands = {
  kodi: { name: 'Kodi', colour: '#17B2E7', svg: brand(kodiSvg), href: 'https://kodi.tv' },
  ha: { name: 'Home Assistant', colour: '#18BCF2', svg: brand(haSvg), href: 'https://www.home-assistant.io' },
};

type Feature = { title: string; text: string; clip: ReturnType<typeof clip>; wide?: boolean; brand?: keyof typeof brands };
const features: Feature[] = [
  { brand: 'kodi', title: 'Deep Kodi integration', wide: true, clip: clip('playing'),
    text: "What's playing, front and center: the poster, the time left and the controls. Switch audio tracks and subtitles, and browse your movies and shows as a wall of posters." },
  { brand: 'ha', title: 'Easy input switching', clip: clip('inputs'),
    text: "Every input on your receiver, a tap away. r3cui controls your receiver's media player in Home Assistant." },
  { title: 'Global volume', clip: clip('matrix-volume'),
    text: 'The touch slider under the screen and the volume keys drive your receiver, wherever you are in the UI.' },
  { title: 'Reactive backlighting', clip: clip('ts-switch'),
    text: "The buttons light up to match your input and what's playing." },
];
---

<section id="features" class="features">
  <h2>
    <a class="one-ring" href="https://www.youtube.com/watch?v=GI_fvDOUCu8" target="_blank" rel="noopener" title="One ring to rule them all">
      <img src={ring} alt="The One Ring" width="51" height="48" />
    </a>
    One frontend to rule them all
  </h2>
  <div class="bento">
    {features.map(f => (
      <article class:list={['card', { wide: 'wide' in f && f.wide }]} tabindex="0">
        <div class="copy">
          {f.brand && (
            <a class="brand" href={brands[f.brand].href} target="_blank" rel="noopener" style={`--brand:${brands[f.brand].colour}`}>
              <Fragment set:html={brands[f.brand].svg} />{brands[f.brand].name}
            </a>
          )}
          <h3>{f.title}</h3>
          <p>{f.text}</p>
        </div>
        <div class="crop" aria-hidden="true">
          <div class="remote">
            <img src={f.clip.poster} alt="" width="200" height="864" loading="lazy" decoding="async" />
            <video muted loop playsinline preload="none" width="200" height="864" data-webm={f.clip.webm} data-mp4={f.clip.mp4}></video>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<script>
  // Each card's remote shows its still until the card is hovered or focused; then the clip crossfades in, and it pauses
  // again on leaving. Without hover (phones), a card plays while it is mostly on screen.
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  function start(card: HTMLElement) {
    const video = card.querySelector('video');
    if (!video || still.matches) return;
    if (!video.dataset.loaded) {
      video.dataset.loaded = '1';
      for (const [type, key] of [['video/webm', 'webm'], ['video/mp4', 'mp4']] as const) {
        const source = document.createElement('source');
        source.type = type;
        source.src = video.dataset[key]!;
        video.append(source);
      }
      video.addEventListener('playing', () => video.classList.add('live'));
      video.load();
    }
    video.play().catch(() => {});
  }
  const stop = (card: HTMLElement) => card.querySelector('video')?.pause();

  const cards = [...document.querySelectorAll<HTMLElement>('#features .card')];
  if (matchMedia('(hover: hover)').matches) {
    for (const card of cards) {
      card.addEventListener('pointerenter', () => start(card));
      card.addEventListener('pointerleave', () => stop(card));
      card.addEventListener('focus', () => start(card));
      card.addEventListener('blur', () => stop(card));
    }
  } else {
    const io = new IntersectionObserver(es => es.forEach(e => (e.isIntersecting ? start : stop)(e.target as HTMLElement)), { threshold: 0.6 });
    cards.forEach(c => io.observe(c));
  }
</script>

<style>
  h2 {
    font-size: clamp(1.35rem, 2.6vw, 1.85rem); text-align: center; margin: 0 0 28px; letter-spacing: -0.015em;
    display: flex; align-items: center; justify-content: center; gap: 0.45em; flex-wrap: wrap;
  }
  .one-ring { display: inline-flex; flex: none; transition: rotate 0.4s ease, scale 0.4s ease; }
  .one-ring img { height: 1.6em; width: auto; filter: drop-shadow(0 3px 8px rgb(180 120 20 / 0.35)); }
  .one-ring:hover { rotate: -12deg; scale: 1.08; }
  .features { padding-block: 32px 56px; }

  /* Six columns: Kodi wide beside input switching, then volume and backlighting sharing the second row. */
  .bento { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 16px; }
  .card { grid-column: span 3; }
  .card:nth-child(2) { grid-column: span 2; }
  .card {
    position: relative; display: flex; flex-direction: column; overflow: hidden; border-radius: 18px;
    background: var(--card); border: 1px solid var(--border); outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .card:hover, .card:focus-visible { border-color: color-mix(in srgb, var(--primary) 45%, var(--border)); box-shadow: 0 18px 40px -18px var(--feature-hover-shadow); }
  .card:focus-visible { box-shadow: 0 0 0 2px var(--primary); }
  .copy { padding: 22px 22px 16px; }
  /* The product a card builds on: its real logo in its own colour, with its name. */
  .brand {
    display: inline-flex; align-items: center; gap: 7px; margin-bottom: 14px; padding: 5px 11px 5px 8px; border-radius: 999px;
    font-size: 0.84rem; font-weight: 700; text-decoration: none; color: var(--foreground);
    background: color-mix(in srgb, var(--brand) 10%, transparent); border: 1px solid color-mix(in srgb, var(--brand) 30%, transparent);
    position: relative; z-index: 1;
  }
  .brand :global(svg) { width: 17px; height: 17px; color: var(--brand); flex: none; }
  .brand:hover { border-color: var(--brand); }
  .brand:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
  h3 { margin: 0 0 6px; font-size: 1.12rem; letter-spacing: -0.01em; }
  p { margin: 0; color: var(--muted-foreground); }

  /* Like the install card: a large remote hangs from near the top of its area so the screen is the focus, and the
     card cuts it off below the first row of keys. */
  .crop {
    position: relative; height: 360px; margin-top: auto; padding-top: 22px; flex: none; overflow: hidden;
    display: flex; justify-content: center; align-items: flex-start;
  }
  .remote {
    position: relative; width: 190px; aspect-ratio: 200 / 864; flex: none; overflow: hidden;
    border-radius: 2% 2% 15% 15% / 0.46% 0.46% 3.5% 3.5%; box-shadow: 0 20px 40px -10px rgb(0 0 0 / 0.35);
    transition: translate 0.6s cubic-bezier(0.65, 0, 0.35, 1);
  }
  /* On hover the remote eases up into view, bringing more of the screen above the cut. */
  .card:hover .remote, .card:focus-visible .remote { translate: 0 -18px; }
  .remote img, .remote video { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
  .remote video { opacity: 0; transition: opacity 0.5s ease; }
  .remote video:global(.live) { opacity: 1; }

  /* The wide card: text beside a larger remote, the text setting the height (contain: size keeps the remote from
     growing the card). */
  .card.wide { grid-column: span 4; display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); }
  .card.wide .copy { padding: 26px; align-self: center; }
  .card.wide h3 { font-size: 1.3rem; }
  .card.wide .crop { contain: size; height: auto; min-height: 420px; margin: 0; padding-top: 30px; }
  .card.wide .remote { width: 220px; }

  @media (max-width: 900px) {
    .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .card, .card:nth-child(2) { grid-column: span 1; }
    .card.wide, .card:last-child { grid-column: span 2; }
  }
  @media (max-width: 600px) {
    .bento { grid-template-columns: minmax(0, 1fr); }
    .card, .card:nth-child(2), .card.wide { grid-column: span 1; }
    .card.wide { display: flex; }
    .card.wide .copy { padding: 22px 22px 16px; }
    .card.wide .crop { contain: none; min-height: 0; height: 360px; padding-top: 22px; }
    .card.wide .remote { width: 190px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .one-ring, .card, .remote, .remote video { transition: none; }
  }
</style>
