---
import ring from '../assets/one-ring.webp?url';
import kodiSvg from '../assets/brands/kodi-wordmark.svg?raw';
import haSvg from '../assets/brands/homeassistant-wordmark.svg?raw';

const clips = import.meta.glob<string>('../assets/clips/*.{webm,mp4,webp}', { query: '?url', import: 'default', eager: true });
const clip = (name: string) => ({
  webm: clips[`../assets/clips/${name}.webm`],
  mp4: clips[`../assets/clips/${name}.mp4`],
  poster: clips[`../assets/clips/${name}.webp`],
});

// Each brand's own wordmark (Kodi from Wikimedia Commons, public domain; Home Assistant from its logo pack). The
// lettering is drawn in currentColor so it follows the theme; the marks keep their brand blue.
const brand = (svg: string) => svg.replace('<svg', '<svg aria-hidden="true"');
const brands = {
  kodi: { name: 'Kodi', colour: '#17B2E7', svg: brand(kodiSvg), href: 'https://kodi.tv' },
  ha: { name: 'Home Assistant', colour: '#18BCF2', svg: brand(haSvg), href: 'https://www.home-assistant.io' },
};

type Feature = { title: string; text: string; clip: ReturnType<typeof clip>; wide?: boolean; brand?: keyof typeof brands };
const features: Feature[] = [
  { brand: 'kodi', title: 'Deep Kodi integration', wide: true, clip: clip('kodi-deep'),
    text: "Browse your movies as a wall of posters that follows Kodi, start one, and it's front and center: the poster, the time left and the controls. Audio tracks and subtitles are a tap away, by their real names." },
  { brand: 'ha', title: 'Easy input switching', clip: clip('inputs-lava'),
    text: "Every input on your receiver, a tap away. r3cui controls your receiver's media player in Home Assistant." },
  { title: 'Global volume', clip: clip('matrix-volume'),
    text: 'The touch slider under the screen and the volume keys drive your receiver, wherever you are in the UI.' },
];

// The backlighting card shows one remote per input, its keys lit in that input's colour.
const lightStills = import.meta.glob<string>('../assets/lights/*.webp', { query: '?url', import: 'default', eager: true });
const light = (file: string) => lightStills[`../assets/lights/${file}.webp`];
const lights = [
  { name: 'Late Night with the Devil playing', colour: '#E8343A', still: light('late-night') },
  { name: 'Toy Story playing', colour: '#2E7BFF', still: light('toy-story') },
  { name: 'The Matrix playing', colour: '#4CD137', still: light('matrix') },
  { name: 'the PlayStation input', colour: '#2E7BFF', still: light('playstation') },
];
---

<section id="features" class="features">
  <h2>
    <a class="one-ring" href="https://www.youtube.com/watch?v=GI_fvDOUCu8" target="_blank" rel="noopener" title="One ring to rule them all">
      <img src={ring} alt="The One Ring" width="51" height="48" />
    </a>
    One frontend to rule them all
  </h2>
  <div class="bento">
    {features.map(f => (
      <article class:list={['card', { wide: 'wide' in f && f.wide }]} tabindex="0">
        <div class="copy">
          {f.brand && (
            <a class="brand" href={brands[f.brand].href} target="_blank" rel="noopener" style={`--brand:${brands[f.brand].colour}`}>
              <Fragment set:html={brands[f.brand].svg} /><span class="sr-only">{brands[f.brand].name}</span>
            </a>
          )}
          <h3>{f.title}</h3>
          <p>{f.text}</p>
        </div>
        <div class="crop" aria-hidden="true">
          <div class="remote">
            <img src={f.clip.poster} alt="" width="200" height="864" loading="lazy" decoding="async" />
            <video muted loop playsinline preload="none" width="200" height="864" data-webm={f.clip.webm} data-mp4={f.clip.mp4}></video>
          </div>
        </div>
      </article>
    ))}
    <article class="card lights-card" tabindex="0">
      <div class="copy">
        <h3>Reactive backlighting</h3>
        <p>The buttons light up to match what's on screen: the colours of the poster for the film that's playing, or the
          colour of the input you've switched to.</p>
      </div>
      <ul class="lights" aria-label="Key colours by input">
        {lights.map(l => (
          <li style={`--glow:${l.colour}`}>
            <div class="remote"><img src={l.still} alt={`Remote with ${l.name}, keys lit to match`} width="200" height="864" decoding="async" /></div>
          </li>
        ))}
      </ul>
    </article>
  </div>
</section>

<script>
  // Each card's remote shows its still until the card is hovered or focused; then the clip crossfades in, and it pauses
  // again on leaving. Without hover (phones), a card plays while it is mostly on screen.
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  function start(card: HTMLElement) {
    const video = card.querySelector('video');
    if (!video || still.matches) return;
    if (!video.dataset.loaded) {
      video.dataset.loaded = '1';
      for (const [type, key] of [['video/webm', 'webm'], ['video/mp4', 'mp4']] as const) {
        const source = document.createElement('source');
        source.type = type;
        source.src = video.dataset[key]!;
        video.append(source);
      }
      video.addEventListener('playing', () => video.classList.add('live'));
      video.load();
    }
    video.play().catch(() => {});
  }
  const stop = (card: HTMLElement) => card.querySelector('video')?.pause();

  // Backlighting: each remote rises the nearer the pointer (or finger) is to it, so they lift and settle one by one.
  const lightsCard = document.querySelector<HTMLElement>('#features .lights-card');
  if (lightsCard && !still.matches) {
    const remotes = [...lightsCard.querySelectorAll<HTMLElement>('.lights .remote')];
    const liftAt = (x: number) => {
      for (const r of remotes) {
        const box = r.getBoundingClientRect();
        const away = Math.abs(x - (box.left + box.width / 2)) / (box.width * 2.4);
        r.style.setProperty('--lift', Math.max(0, 1 - away * away).toFixed(3));
      }
    };
    const raiseAll = () => remotes.forEach(r => r.style.setProperty('--lift', '1'));
    if (matchMedia('(hover: hover)').matches) {
      lightsCard.addEventListener('pointermove', e => liftAt(e.clientX));
      lightsCard.addEventListener('pointerleave', () => remotes.forEach(r => r.style.removeProperty('--lift')));
    } else {
      // Touch: a finger down or dragging sideways ripples the row (vertical swipes still scroll, see touch-action),
      // and lifting it settles every remote back up. On first sight a wave runs across once, as a hint.
      lightsCard.classList.add('touch');
      const track = (e: PointerEvent) => { if (e.pointerType !== 'mouse') liftAt(e.clientX); };
      lightsCard.addEventListener('pointerdown', track);
      lightsCard.addEventListener('pointermove', track);
      for (const end of ['pointerup', 'pointercancel'] as const) lightsCard.addEventListener(end, () => setTimeout(raiseAll, 450));
      const wave = () => {
        const first = remotes[0].getBoundingClientRect(), last = remotes.at(-1)!.getBoundingClientRect();
        const from = first.left, to = last.right, t0 = performance.now(), length = 1400;
        const step = (now: number) => {
          const k = Math.min(1, (now - t0) / length);
          liftAt(from + (to - from) * k);
          if (k < 1) requestAnimationFrame(step); else setTimeout(raiseAll, 250);
        };
        requestAnimationFrame(step);
      };
      new IntersectionObserver(([e], io) => { if (e.isIntersecting) { io.disconnect(); setTimeout(wave, 300); } }, { threshold: 0.6 }).observe(lightsCard);
    }
  }

  const cards = [...document.querySelectorAll<HTMLElement>('#features .card')];
  if (matchMedia('(hover: hover)').matches) {
    for (const card of cards) {
      card.addEventListener('pointerenter', () => start(card));
      card.addEventListener('pointerleave', () => stop(card));
      card.addEventListener('focus', () => start(card));
      card.addEventListener('blur', () => stop(card));
    }
  } else {
    const io = new IntersectionObserver(es => es.forEach(e => (e.isIntersecting ? start : stop)(e.target as HTMLElement)), { threshold: 0.6 });
    cards.forEach(c => io.observe(c));
  }
</script>

<style>
  h2 {
    font-size: clamp(1.35rem, 2.6vw, 1.85rem); text-align: center; margin: 0 0 28px; letter-spacing: -0.015em;
    display: flex; align-items: center; justify-content: center; gap: 0.45em; flex-wrap: wrap;
  }
  .one-ring { display: inline-flex; flex: none; transition: rotate 0.4s ease, scale 0.4s ease; }
  .one-ring img { height: 1.6em; width: auto; filter: drop-shadow(0 3px 8px rgb(180 120 20 / 0.35)); }
  .one-ring:hover { rotate: -12deg; scale: 1.08; }
  .features { padding-block: 32px 56px; }

  /* Three rows: Kodi across the top, input switching and volume side by side, then the backlighting row. */
  .bento { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .card { grid-column: span 1; }
  .card {
    position: relative; display: flex; flex-direction: column; overflow: hidden; border-radius: 18px;
    background: var(--card); border: 1px solid var(--border); outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  /* Hovering a card plays its clip; a pointer shows the card responds. */
  @media (hover: hover) { .card:has(video), .lights-card { cursor: pointer; } }
  .card:focus-visible { border-color: color-mix(in srgb, var(--primary) 45%, var(--border)); box-shadow: 0 18px 40px -18px var(--feature-hover-shadow); }
  .card:focus-visible { box-shadow: 0 0 0 2px var(--primary); }
  .copy { padding: 22px 22px 16px; }
  /* The product a card builds on: its real logo in its own colour, with its name. */
  .brand { display: inline-flex; margin-bottom: 18px; color: var(--foreground); text-decoration: none; position: relative; z-index: 1; }
  .brand :global(svg) { display: block; height: 26px; width: auto; flex: none; }
  .brand:focus-visible { outline: 2px solid var(--brand); outline-offset: 4px; border-radius: 4px; }
  h3 { margin: 0 0 6px; font-size: 1.12rem; letter-spacing: -0.01em; }
  p { margin: 0; color: var(--muted-foreground); }

  /* Like the install card: a large remote hangs from near the top of its area so the screen is the focus, and the
     card cuts it off below the first row of keys. */
  .crop {
    position: relative; height: 360px; margin-top: auto; padding-top: 22px; flex: none; overflow: hidden;
    display: flex; justify-content: center; align-items: flex-start; contain: paint;
    /* Firefox anchored scrolling to the remote and shifted the page when its clip started loading on first hover. */
    overflow-anchor: none;
  }
  .remote {
    position: relative; width: 190px; aspect-ratio: 200 / 864; flex: none; overflow: hidden; will-change: translate;
    border-radius: 2% 2% 15% 15% / 0.46% 0.46% 3.5% 3.5%; box-shadow: 0 10px 26px rgb(0 0 0 / 0.18);
    /* Resting lower, the remote rises to its full view on hover. iOS-style curve: it moves off at once and settles
       softly. Leaving returns a little faster. */
    translate: 0 var(--rest, 0px);
    transition: translate 0.35s cubic-bezier(0.32, 0.72, 0, 1), box-shadow 0.35s ease;
  }
  /* The shadow deepens as the remote lifts. */
  .card:focus-visible .remote { box-shadow: 0 16px 36px rgb(0 0 0 / 0.28); transition-duration: 0.5s; }
  /* On hover the remote eases up into view, bringing more of the screen above the cut. */
  /* The backlighting row lifts each remote by pointer distance instead (below), so it stays out of this rule. */
  .card:not(.lights-card):focus-visible .remote { translate: 0 0; }
  /* Only where there is a real hover (a mouse): remotes rest lower and rise on hover. Touch screens show them at their
     raised height, and tapping a card does nothing. */
  @media (hover: hover) {
    .card { --rest: 34px; }
    .card:hover { border-color: color-mix(in srgb, var(--primary) 45%, var(--border)); box-shadow: 0 18px 40px -18px var(--feature-hover-shadow); }
    .card:hover .remote { box-shadow: 0 16px 36px rgb(0 0 0 / 0.28); transition-duration: 0.5s; }
    .card:not(.lights-card):hover .remote { translate: 0 0; }
  }
  .remote img, .remote video { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
  .remote video { opacity: 0; transition: opacity 0.5s ease; }
  .remote video:global(.live) { opacity: 1; }

  /* The wide card: text beside a larger remote, the text setting the height (contain: size keeps the remote from
     growing the card). */
  .card.wide, .lights-card { grid-column: span 2; }
  .card.wide { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); }
  .card.wide .copy { padding: 26px; align-self: center; }
  .card.wide h3 { font-size: 1.3rem; }
  .card.wide .crop { contain: size; height: auto; min-height: 420px; margin: 0; padding-top: 30px; }
  .card.wide .remote { width: 220px; }

  /* Backlighting: text beside four remotes, each cut below its keypad with a glow of its key colour behind it. */
  .lights-card { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 2fr); align-items: center; }
  .lights-card .copy { padding: 26px; }
  .lights {
    list-style: none; margin: 0; padding: 30px 26px 0 0; height: 420px; contain: size; overflow-anchor: none;
    /* A faint fade at the bottom edge, so the remotes ease out of the card instead of stopping at a hard line. */
    -webkit-mask: linear-gradient(to bottom, #000 calc(100% - 56px), rgb(0 0 0 / 0.6));
    mask: linear-gradient(to bottom, #000 calc(100% - 56px), rgb(0 0 0 / 0.6));
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; align-self: stretch;
  }
  .lights li { position: relative; display: flex; justify-content: center; }
  .lights li::before {
    content: ''; position: absolute; left: 50%; top: 52%; width: 150%; height: 60%; translate: -50% 0; pointer-events: none;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--glow) 22%, transparent), transparent);
  }
  .lights .remote { width: min(140px, 100%); }
  /* Each remote rises by its own --lift, set from how close the pointer is (see the script), so they ripple as it moves. */
  /* Short and eased out, so the lift follows the pointer closely. The card, not the list, clips the remotes, so their
     shadows fade out softly. */
  .lights .remote { translate: 0 calc(var(--rest, 0px) * (1 - var(--lift, 0))); transition: translate 0.16s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.2s ease; }
  .lights-card:focus-visible .remote { --lift: 1; }
  /* Touch screens: the row rests lower so a finger can lift it; sideways drags reach the script, vertical ones scroll. */
  .lights-card.touch { --rest: 34px; }
  .lights-card.touch .lights { touch-action: pan-y; }

  @media (max-width: 760px) {
    .lights-card { grid-template-columns: minmax(0, 1fr); }
    .lights-card .copy { padding: 22px 22px 0; }
    .lights { padding: 22px 16px 0; height: 330px; gap: 10px; }
  }
  @media (max-width: 600px) {
    .bento { grid-template-columns: minmax(0, 1fr); }
    .card, .card.wide, .lights-card { grid-column: span 1; }
    .card.wide { display: flex; }
    .card.wide .copy { padding: 22px 22px 16px; }
    .card.wide .crop { contain: none; min-height: 0; height: 360px; padding-top: 22px; }
    .card.wide .remote { width: 190px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .one-ring, .card, .remote, .remote video { transition: none; }
  }
</style>
