---
import Logo from '../Logo.astro';

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex">
  <Logo class="logo" />
  <span class="sr-only" translate="no">{siteTitle}</span>
</a>

<style>
  @layer starlight.core {
    .site-title { align-items: center; min-width: 0; text-decoration: none; color: var(--sl-color-white); }
    .site-title :global(.logo) { height: calc((var(--sl-nav-height) - 2 * var(--sl-nav-pad-y)) * 0.7); width: auto; }
  }
</style>
