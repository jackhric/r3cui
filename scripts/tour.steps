# Every page and overlay once, for comparing screenshots before and after a Slint change:
#   cargo run -p r3cui -- --demo --steps scripts/tour.steps --out <dir>
awake
wait 1500
snap 00-home
key +
wait 350
snap 01-volume
wait 2300
page inputs
wait 900
snap 02-inputs
key down
wait 500
snap 03-inputs-down
key back
wait 900
page menu
wait 900
snap 04-menu
key down
key down
wait 500
snap 05-menu-down
key ok
wait 900
snap 06-display
key down
key ok
wait 500
snap 07-display-auto-off
key left
wait 300
key back
wait 900
page power
wait 900
snap 08-power
key down
wait 400
snap 09-power-down
page wifi
wait 900
snap 10-wifi
page status
wait 900
snap 11-status
page feedback-lab
wait 900
snap 12-lab
key ok
wait 900
snap 13-lab-patterns
key back
wait 600
page integrations
wait 900
snap 14-integrations
key down
wait 400
snap 15-integrations-down
page keyboard
wait 900
snap 16-keyboard
type ab1
wait 400
snap 17-keyboard-typed
key right
key down
wait 400
snap 18-keyboard-nav
page join-failed
wait 900
snap 19-join-failed
key down
wait 400
snap 20-join-failed-down
page tracks
wait 900
snap 21-tracks
page home
wait 900
snap 22-home-again
hold home 900
wait 1500
snap 23-home-hold
key back
wait 900
hold power 1500
wait 400
snap 24-power-hold
page menu
wait 900
key down
key down
key ok
wait 700
key back
wait 700
snap 25-back-to-menu-display
key down
key down
key ok
wait 700
key back
wait 700
snap 26-back-to-menu-power
key down
key ok
wait 700
key back
wait 700
snap 27-back-to-menu-status
key down
key down
key ok
wait 700
key ok
wait 700
snap 28-lab-patterns
key back
wait 500
key back
wait 700
snap 29-back-to-menu-lab
key up
key up
key up
key up
key up
key up
key up
key ok
wait 700
key back
wait 700
snap 30-back-to-menu-wifi
key down
key ok
wait 700
key back
wait 700
snap 31-back-to-menu-integrations
key back
wait 700
snap 32-back-to-home
page home
wait 900
press home
wait 450
snap 33-home-hold-ring
wait 500
snap 34-home-hold-complete
release home
wait 900
press power
wait 500
snap 35-power-hold-ring
release power
wait 600
page menu
wait 900
key down
key down
key down
key down
key down
key down
key ok
wait 1200
snap 36-system
key ok
wait 900
snap 37-r3-update
page fw-update
wait 900
snap 38-fw-update
page web-config
wait 900
snap 39-web-config
page uninstall
wait 900
snap 40-uninstall
wait 1500
quit
