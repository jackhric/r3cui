# Every page and overlay once, for comparing screenshots before and after a Slint change:
#   cargo run -p remote-ui -- --demo --steps scripts/tour.steps --out <dir>
awake
wait 1500
snap 00-home
key +
wait 350
snap 01-volume
wait 2300
page inputs
wait 900
snap 02-inputs
key down
wait 500
snap 03-inputs-down
key back
wait 900
page menu
wait 900
snap 04-menu
key down
key down
wait 500
snap 05-menu-down
key ok
wait 900
snap 06-display
key down
key ok
wait 500
snap 07-display-auto-off
key left
wait 300
key back
wait 900
page power
wait 900
snap 08-power
key down
wait 400
snap 09-power-down
page wifi
wait 900
snap 10-wifi
page status
wait 900
snap 11-status
page feedback-lab
wait 900
snap 12-lab
key ok
wait 900
snap 13-lab-patterns
key back
wait 600
page integrations
wait 900
snap 14-integrations
key down
wait 400
snap 15-integrations-down
page keyboard
wait 900
snap 16-keyboard
type ab1
wait 400
snap 17-keyboard-typed
key right
key down
wait 400
snap 18-keyboard-nav
page join-failed
wait 900
snap 19-join-failed
key down
wait 400
snap 20-join-failed-down
page tracks
wait 900
snap 21-tracks
page home
wait 900
snap 22-home-again
hold home 900
wait 1500
snap 23-home-hold
key back
wait 900
hold power 1500
wait 400
snap 24-power-hold
wait 1500
quit
